---
/**
 * Animated WebGL backdrop: a synthwave voxel landscape — a scrolling neon grid over
 * low-poly hills with drifting pixel stars. ~2 KB, no libraries, pauses off-screen,
 * falls back to a CSS gradient when WebGL or motion is unavailable.
 */
---
<div class="shader-bg" aria-hidden="true">
  <canvas id="shader-canvas"></canvas>
</div>

<style>
  .shader-bg {
    position: absolute; inset: 0; z-index: -1; overflow: hidden;
    background:
      radial-gradient(60% 50% at 70% 30%, rgba(37, 250, 245, 0.18), transparent 70%),
      radial-gradient(50% 40% at 20% 70%, rgba(103, 251, 96, 0.14), transparent 70%),
      linear-gradient(180deg, #04061a 0%, #0a0d3a 60%, #04061a 100%);
  }
  .shader-bg::after { content: ''; position: absolute; inset: auto 0 0 0; height: 40%; background: linear-gradient(180deg, transparent, var(--bg)); }
  canvas { width: 100%; height: 100%; display: block; opacity: 0; transition: opacity 1.2s ease; }
  canvas.ready { opacity: 1; }
</style>

<script>
  const canvas = document.getElementById('shader-canvas') as HTMLCanvasElement | null;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const gl = canvas?.getContext('webgl', { antialias: false, alpha: true, powerPreference: 'low-power' });
  if (canvas && gl) {
    const vs = `attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}`;
    const fs = `precision mediump float;
uniform vec2 r;uniform float t;uniform vec2 m;
float h(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
float n(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);
 return mix(mix(h(i),h(i+vec2(1,0)),f.x),mix(h(i+vec2(0,1)),h(i+vec2(1,1)),f.x),f.y);}
void main(){
 vec2 uv=(gl_FragCoord.xy-.5*r)/r.y; uv+=m*.03;
 vec3 col=vec3(0.);
 float hz=-.02;
 // sky glow + sun
 col+=vec3(.05,.07,.25)*(1.-abs(uv.y-.1));
 vec2 sp=uv-vec2(.38,.16); float sd=length(sp);
 float sun=smoothstep(.2,.19,sd);
 float bands=step(.5,fract((uv.y-.16)*28.-t*.4))+step(.16,uv.y);
 col+=mix(vec3(.15,.98,.96),vec3(.4,.98,.38),clamp((uv.y+.05)*3.,0.,1.))*sun*clamp(bands,0.,1.)*.85;
 col+=vec3(.15,.98,.96)*.18*exp(-sd*5.);
 // pixel stars
 vec2 sg=floor((uv+vec2(t*.004,0.))*90.);
 float st=step(.994,h(sg))*step(hz,uv.y)*(.5+.5*sin(t*2.+h(sg+3.)*40.));
 col+=vec3(.7,1.,.95)*st;
 // low-poly hills (quantized noise silhouette)
 float x=uv.x*2.2+t*.03;
 float hill=hz+.11*n(vec2(floor(x*6.)/6.,1.))+.05*n(vec2(x*3.,4.));
 float hill2=hz+.06*n(vec2(floor((x*1.6+9.)*8.)/8.,2.));
 if(uv.y<hill && uv.y>hz) col=mix(col,vec3(.04,.05,.2)+vec3(.1,.5,.9)*.12*(uv.y-hz)*12.,.92);
 if(uv.y<hill2 && uv.y>hz) col=mix(col,vec3(.02,.03,.12),.9);
 // ground grid
 if(uv.y<hz){
  float d=hz-uv.y; float z=.35/d;
  vec2 g=vec2(uv.x*z,z+t*1.6);
  vec2 gf=abs(fract(g)-.5); float w=.035*z*.35;
  float line=max(smoothstep(.5-w,.5,gf.x),smoothstep(.5-w*1.4,.5,gf.y));
  float fade=exp(-z*.09);
  vec3 gc=mix(vec3(.15,.98,.96),vec3(.4,.98,.38),.5+.5*sin(g.y*.3));
  col=vec3(.01,.015,.06)+gc*line*fade*1.1+vec3(.1,.4,.6)*.15*exp(-d*14.);
 }
 col+=vec3(.15,.98,.96)*.35*exp(-abs(uv.y-hz)*60.);
 gl_FragColor=vec4(col,1.);
}`;
    const sh = (type: number, src: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s); return s; };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, vs));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(prog);
    if (gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      gl.useProgram(prog);
      const buf = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      const uR = gl.getUniformLocation(prog, 'r'), uT = gl.getUniformLocation(prog, 't'), uM = gl.getUniformLocation(prog, 'm');
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      const scale = window.innerWidth < 700 ? 0.6 : 0.85; // render below native res for perf
      const resize = () => {
        canvas.width = Math.floor(canvas.clientWidth * dpr * scale);
        canvas.height = Math.floor(canvas.clientHeight * dpr * scale);
        gl.viewport(0, 0, canvas.width, canvas.height);
      };
      resize();
      addEventListener('resize', resize);
      let mx = 0, my = 0, tx = 0, ty = 0;
      addEventListener('pointermove', (e) => { tx = e.clientX / innerWidth - 0.5; ty = 0.5 - e.clientY / innerHeight; });
      let visible = true;
      new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);
      const t0 = performance.now();
      const frame = (now: number) => {
        if (visible) {
          mx += (tx - mx) * 0.05; my += (ty - my) * 0.05;
          gl.uniform2f(uR, canvas.width, canvas.height);
          gl.uniform1f(uT, reduce ? 12 : (now - t0) / 1000);
          gl.uniform2f(uM, mx, my);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
        }
        if (!reduce) requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
      canvas.classList.add('ready');
    }
  }
</script>
