---
import Base from '../../layouts/Base.astro';
import AssetCard from '../../components/AssetCard.astro';
import BuyButton from '../../components/BuyButton.astro';
import Countdown from '../../components/Countdown.astro';
import { SITE, SERIES, ENGINES, assets, bundlesFor, bundleName, bundleSavings, assetSeoTitle, assetSeoDescription, absolute, type Asset, type SeriesKey, type EngineKey } from '../../data/site';

export function getStaticPaths() {
  return assets.map((a) => ({ params: { slug: a.slug }, props: { asset: a } }));
}
const { asset: a } = Astro.props as { asset: Asset };
const series = SERIES[a.series as SeriesKey];
const onSale = a.originalPrice && a.originalPriceValue > a.priceValue;
const gallery = [a.cover, ...a.screenshots];
const myBundles = bundlesFor(a);
const theme = a.slug.replace(/^(low-poly|3d-pixel)-/, '').replace(/^(halloween|christmas)-/, '').replace(/-pack$/, '');
const themeOf = (x: Asset) => x.slug.replace(/^(low-poly|3d-pixel)-/, '').replace(/^(halloween|christmas)-/, '').replace(/-pack$/, '');
const related = [
  ...assets.filter((x) => x.slug !== a.slug && themeOf(x) === theme),
  ...assets.filter((x) => x.slug !== a.slug && x.series === a.series && themeOf(x) !== theme),
].slice(0, 4);
const engines = (a.engines as string[]).filter((e) => e in ENGINES) as EngineKey[];
const formats = (a.formats as string[]).filter((f) => f !== 'PNG');
const published = a.published ? new Date(a.published) : null;
// Presentation only: drop the leading emoji itch.io puts on headings; the words stay as the owner wrote them.
const descHtml = a.descriptionHtml.replace(/(<h[2-4][^>]*>)\s*(?:\p{Extended_Pictographic}|\uFE0F|\u200D)+\s*/gu, '$1');
const headline = a.headline.replace(/^(?:\p{Extended_Pictographic}|\uFE0F|\u200D)+\s*/u, '').replace(a.title, '').replace(/^\s*[\u2014-]\s*/, '') || '';

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': absolute(`/assets/${a.slug}/#product`),
  name: a.itchTitle,
  description: a.shortDescription,
  sku: String(a.id),
  mpn: `HANX-${a.id}`,
  category: 'Game Assets > 3D Models',
  image: gallery.slice(0, 6).map((g) => absolute(g.src)),
  brand: { '@type': 'Brand', name: SITE.brand },
  manufacturer: { '@id': `${SITE.url}/#org` },
  url: absolute(`/assets/${a.slug}/`),
  keywords: (a.tags as string[]).join(', '),
  offers: {
    '@type': 'Offer',
    url: a.url,
    price: a.priceValue.toFixed(2),
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    priceValidUntil: (a.sale?.ends || new Date(Date.now() + 365 * 864e5).toISOString()).slice(0, 10),
    seller: { '@type': 'Organization', name: SITE.studio, url: SITE.itch },
  },
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
    { '@type': 'ListItem', position: 2, name: series.title, item: absolute(`/collections/${a.series}/`) },
    { '@type': 'ListItem', position: 3, name: a.title, item: absolute(`/assets/${a.slug}/`) },
  ],
};
---
<Base
  title={assetSeoTitle(a)}
  description={assetSeoDescription(a)}
  image={a.cover.src}
  imageAlt={`${a.title} preview`}
  type="product"
  price={{ amount: a.priceValue, currency: 'USD' }}
  jsonld={[productLd, breadcrumb]}
>
  <Fragment slot="head"><link rel="preload" as="image" href={a.cover.src} fetchpriority="high" /></Fragment>
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href={`/collections/${a.series}/`}>{series.title}</a></li>
        <li><span aria-current="page">{a.title}</span></li>
      </ol>
    </nav>

    <section class="pdp">
      <div class="gallery">
        <button class="frame main-shot" id="main-shot" type="button" aria-label="Open the full-size gallery">
          <img id="main-img" src={a.cover.src} width={a.cover.width} height={a.cover.height} alt={`${a.title}: ${a.shortDescription}`} fetchpriority="high" decoding="async" />
        </button>
        {gallery.length > 1 && (
          <ul class="thumbs" aria-label={`${a.title} screenshots`}>
            {gallery.map((g, i) => (
              <li><button class={`thumb ${i === 0 ? 'active' : ''}`} type="button" data-index={i} data-src={g.src} aria-label={`Show image ${i + 1} of ${gallery.length}`}>
                <img src={g.sm} alt="" loading="lazy" decoding="async" width="160" height="120" />
              </button></li>
            ))}
          </ul>
        )}
      </div>

      <div class="buy">
        <h1>{a.title}</h1>
        {headline && <p class="lead">{headline}.</p>}
        <p class="buy-price"><span class="price-figure">{a.price}</span>{onSale && <span class="was">{a.originalPrice}</span>}</p>
        {onSale && a.sale && <Countdown ends={a.sale.ends} label={`${a.sale.rate}% off until`} />}
        <BuyButton asset={a} variant="primary" block label="Buy on itch.io" />
        <p class="small">Secure checkout by itch.io, card or PayPal. Download straight after paying.</p>
        <dl class="specs">
          {a.modelCount && <div><dt>Models</dt><dd>{a.modelCount}</dd></div>}
          {a.triangles && <div><dt>Triangles</dt><dd>{a.triangles.min.toLocaleString('en-US')} to {a.triangles.max.toLocaleString('en-US')} per model</dd></div>}
          {formats.length > 0 && <div><dt>Formats</dt><dd>{formats.map((f) => (f === 'BLEND' ? '.blend' : f)).join(', ')}</dd></div>}
          {engines.length > 0 && <div><dt>Engines</dt><dd>{engines.map((e, i) => <>{i > 0 && ', '}<a class="link" href={`/engines/${e}/`}>{ENGINES[e].name}</a></>)}</dd></div>}
          <div><dt>License</dt><dd><a class="link" href="/license/">Commercial, royalty-free</a></dd></div>
          {published && <div><dt>Released</dt><dd><time datetime={a.published}>{published.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</time></dd></div>}
        </dl>
        {myBundles.map((b) => (
          <a class="upsell" href={b.url} target="_blank" rel="noopener">
            <span class="upsell-title">This pack and {b.members.length - 1} more for {b.bundlePrice}</span>
            <span class="small">{bundleName(b)}, save {bundleSavings(b)}%</span>
          </a>
        ))}
        <a class="link small" href={a.url} target="_blank" rel="noopener">Open the itch.io page</a>
      </div>
    </section>

    <section class="details">
      <article class="prose">
        <h2>About the {a.title}</h2>
        <Fragment set:html={descHtml} />
      </article>
      <aside class="side">
        <h2>Tags</h2>
        <ul class="tags">{(a.tags as string[]).map((t) => <li><a href={`/assets/?q=${encodeURIComponent(t.replace(/-/g, ' '))}`}>{t.replace(/-/g, ' ')}</a></li>)}</ul>
        <h2>Quick start</h2>
        {engines.slice(0, 3).map((e) => <p><strong>{ENGINES[e].name}.</strong> {ENGINES[e].how}</p>)}
        <BuyButton asset={a} block label={`Get it for ${a.price}`} />
      </aside>
    </section>

    {related.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>Works with these packs.</h2><p><a class="link" href="/assets/">See all packs</a></p></div>
        <div class="pack-grid">{related.map((r) => <AssetCard asset={r} />)}</div>
      </section>
    )}
  </div>

  <div class="sticky-buy" id="sticky-buy">
    <p><strong>{a.title}</strong><span class="price-figure">{a.price}</span></p>
    <BuyButton asset={a} variant="primary" size="sm" label="Buy" />
  </div>

  <dialog class="lightbox" id="lightbox" aria-label={`${a.title} gallery`}>
    <img id="lb-img" alt={`${a.title} screenshot`} />
    <button class="btn btn--sm lb-prev" id="lb-prev" type="button" aria-label="Previous image">Prev</button>
    <button class="btn btn--sm lb-next" id="lb-next" type="button" aria-label="Next image">Next</button>
    <button class="btn btn--sm lb-close" id="lb-close" type="button">Close</button>
    <p class="lb-count small" id="lb-count"></p>
  </dialog>
  <script is:inline type="application/json" id="gallery-data" set:html={JSON.stringify(gallery.map((g) => g.src))} />
</Base>

<style>
  .pdp { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: var(--space-3xl); align-items: start; padding-block: var(--space-lg); }
  .gallery { display: grid; gap: var(--space-lg); min-width: 0; }
  .main-shot { display: block; width: 100%; padding: 0; cursor: zoom-in; aspect-ratio: 315 / 250; }
  .main-shot img { transition: opacity var(--dur-short) var(--ease-out); }
  .main-shot:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  .thumbs { list-style: none; margin: 0; padding: 0 0 var(--space-xs); display: flex; gap: var(--space-sm); overflow-x: auto; }
  .thumb { display: block; width: 104px; padding: 0; border: var(--rule-bar) solid var(--color-paper-3); background: var(--color-paper-2); cursor: pointer; transition: border-color var(--dur-micro) var(--ease-out); }
  .thumb img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .thumb:hover { border-color: var(--color-ink-2); }
  .thumb.active { border-color: var(--color-ink); }
  .thumb:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .thumb:active { border-color: var(--color-accent-2); }

  .buy { position: sticky; top: calc(var(--nav-height) + var(--space-lg)); display: grid; gap: var(--space-md); justify-items: start; }
  .buy h1 { font-size: var(--text-display); max-width: 12ch; text-wrap: balance; }
  .buy-price { display: flex; align-items: baseline; gap: var(--space-md); padding-top: var(--space-md); border-top: var(--rule-bar) solid var(--color-ink); width: 100%; }
  .buy-price .price-figure { font-size: var(--text-price); }
  .buy-price .was { font-size: var(--text-xl); }
  .specs { width: 100%; margin: var(--space-xs) 0 0; display: grid; }
  .specs div { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 5fr); gap: var(--space-md); padding-block: var(--space-xs); border-top: var(--rule-hair) solid var(--color-ink); }
  .specs dt { font-size: var(--text-sm); font-weight: 500; color: var(--color-muted); }
  .specs dd { margin: 0; font-size: var(--text-sm); }
  .upsell { width: 100%; display: grid; gap: var(--space-2xs); padding: var(--space-md); background: var(--color-accent); color: var(--color-accent-ink); border: var(--rule-bar) solid var(--color-ink); box-shadow: var(--shadow-card); text-decoration: none; transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out); }
  .upsell .small { color: inherit; }
  .upsell-title { font: var(--display-weight) var(--text-xl)/1.1 var(--font-display); text-transform: uppercase; letter-spacing: var(--tracking-display); }
  .upsell:hover { background: var(--color-ink); color: var(--color-accent); }
  .upsell:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  .upsell:active { box-shadow: var(--shadow-press); }

  .details { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-3xl); padding-top: var(--space-xl); border-top: var(--rule-bar) solid var(--color-ink); align-items: start; }
  .details .prose > h2:first-child { font-size: var(--text-section); margin-top: 0; }
  .side { display: grid; gap: var(--space-md); justify-items: start; position: sticky; top: calc(var(--nav-height) + var(--space-lg)); }
  .side h2 { font-size: var(--text-xl); }
  .side p { font-size: var(--text-sm); color: var(--color-ink-2); }
  .tags { list-style: none; margin: 0 0 var(--space-md); padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .tags a { display: inline-block; padding: var(--space-2xs) var(--space-sm); border: var(--rule-bar) solid var(--color-ink); font-size: var(--text-sm); text-decoration: none; transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out); }
  .tags a:hover { background: var(--color-ink); color: var(--color-paper); }
  .tags a:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .tags a:active { background: var(--color-ink-2); color: var(--color-paper); }

  .sticky-buy { display: none; }
  @media (max-width: 60rem) {
    .pdp, .details { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
    .buy, .side { position: static; }
    .sticky-buy { display: flex; position: fixed; inset: auto 0 0 0; z-index: var(--z-sticky); align-items: center; justify-content: space-between; gap: var(--space-md); padding: var(--space-sm) var(--gutter); background: var(--color-paper); border-top: var(--rule-bar) solid var(--color-ink); opacity: 0; pointer-events: none; transition: opacity var(--dur-short) var(--ease-out); }
    .sticky-buy.show { opacity: 1; pointer-events: auto; }
    .sticky-buy p { display: grid; min-width: 0; }
    .sticky-buy strong { font-size: var(--text-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sticky-buy .price-figure { font-size: var(--text-xl); }
  }

  .lightbox { width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: var(--space-xl); border: 0; background: var(--color-scrim); color: var(--color-paper); }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: var(--color-scrim); }
  .lightbox img { max-width: 100%; max-height: 82dvh; border: var(--rule-bar) solid var(--color-paper); }
  .lb-prev, .lb-next, .lb-close { position: fixed; }
  .lb-prev { left: var(--space-lg); top: 50%; }
  .lb-next { right: var(--space-lg); top: 50%; }
  .lb-close { right: var(--space-lg); top: var(--space-lg); }
  .lb-count { position: fixed; bottom: var(--space-lg); left: 0; right: 0; text-align: center; color: var(--color-paper-3); }
</style>

<script>
  const srcs: string[] = JSON.parse(document.getElementById('gallery-data')!.textContent || '[]');
  const mainImg = document.getElementById('main-img') as HTMLImageElement;
  const mainBtn = document.getElementById('main-shot') as HTMLButtonElement;
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.thumb')];
  let current = 0;
  const show = (i: number) => {
    current = (i + srcs.length) % srcs.length;
    mainImg.style.opacity = '0.4';
    const pre = new Image();
    pre.onload = () => { mainImg.src = srcs[current]; mainImg.style.opacity = '1'; };
    pre.src = srcs[current];
    thumbs.forEach((t, k) => t.classList.toggle('active', k === current));
    thumbs[current]?.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
  };
  thumbs.forEach((t, i) => { t.addEventListener('click', () => show(i)); t.addEventListener('mouseenter', () => show(i)); });

  const lb = document.getElementById('lightbox') as HTMLDialogElement;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbCount = document.getElementById('lb-count')!;
  const lbShow = (i: number) => { current = (i + srcs.length) % srcs.length; lbImg.src = srcs[current]; lbCount.textContent = `${current + 1} / ${srcs.length}`; };
  mainBtn.addEventListener('click', () => { lbShow(current); lb.showModal(); });
  document.getElementById('lb-prev')!.addEventListener('click', () => lbShow(current - 1));
  document.getElementById('lb-next')!.addEventListener('click', () => lbShow(current + 1));
  document.getElementById('lb-close')!.addEventListener('click', () => lb.close());
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  lb.addEventListener('close', () => show(current));
  addEventListener('keydown', (e) => {
    if (!lb.open) return;
    if (e.key === 'ArrowLeft') lbShow(current - 1);
    if (e.key === 'ArrowRight') lbShow(current + 1);
  });
  let sx = 0;
  lb.addEventListener('touchstart', (e) => (sx = e.touches[0].clientX), { passive: true });
  lb.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 40) lbShow(current + (dx < 0 ? 1 : -1)); });

  // Mobile sticky buy bar appears once the main buy button scrolls out of view
  const bar = document.getElementById('sticky-buy');
  const mainBuy = document.querySelector('.buy a[data-buy]');
  if (bar && mainBuy) new IntersectionObserver(([e]) => bar.classList.toggle('show', !e.isIntersecting && e.boundingClientRect.top < 0)).observe(mainBuy);
</script>
