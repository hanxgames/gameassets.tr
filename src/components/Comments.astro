---
/** Comments for a pack. Reading is public; posting needs a signed-in account with a confirmed e-mail. */
import { useT, href } from '../i18n';
interface Props { lang: string; slug: string }
const { lang, slug } = Astro.props;
const t = useT(lang);
const keys = ['social.commentsH2', 'social.noComments', 'social.signIn', 'social.placeholder', 'social.post', 'social.delete', 'social.tooFast', 'social.verifyEmail', 'social.error', 'social.as', 'social.signOut', 'social.loading', 'social.member'];
const strings = Object.fromEntries(keys.map((k) => [k, t(k)]));
---
<section class="section comments" id="comments" data-comments data-slug={slug} data-lang={lang} data-strings={JSON.stringify(strings)}>
  <div class="section-head"><h2>{t('social.commentsH2')}</h2></div>
  <div class="c-body">
    <div class="c-auth" data-c-auth>
      <button class="btn btn--primary btn--sm" type="button" data-c-google hidden>{t('social.signIn')}</button>
      <a class="link small" href={href(lang, '/dashboard/')} data-c-email hidden>{t('join.or')}</a>
    </div>
    <form class="c-form" data-c-form hidden>
      <p class="small"><span data-c-as></span> <button class="linkish" type="button" data-c-out>{t('social.signOut')}</button></p>
      <label class="visually-hidden" for={`c-text-${slug}`}>{t('social.placeholder')}</label>
      <textarea id={`c-text-${slug}`} maxlength="1000" rows="3" placeholder={t('social.placeholder')} required></textarea>
      <button class="btn btn--sm" type="submit">{t('social.post')}</button>
    </form>
    <p class="small c-msg" role="status" data-c-msg></p>
    <ol class="c-list" data-c-list><li class="small">{t('social.loading')}</li></ol>
  </div>
</section>

<style>
  .comments h2 { overflow-wrap: break-word; min-width: 0; }
  .c-body { display: grid; gap: var(--space-lg); max-width: 52rem; }
  .c-auth { display: flex; flex-wrap: wrap; gap: var(--space-md); align-items: center; }
  .c-auth:not(:has(:not([hidden]))) { display: none; }
  .c-form { display: grid; gap: var(--space-sm); justify-items: start; }
  .c-form[hidden] { display: none; }
  .c-form textarea { width: 100%; min-height: 96px; padding: var(--space-sm) var(--space-md); border: var(--rule-bar) solid var(--color-ink); background: var(--color-paper); color: var(--color-ink); font: inherit; resize: vertical; }
  .c-form textarea:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 0; }
  .linkish { padding: 0; border: 0; background: none; color: var(--color-ink); font: inherit; text-decoration: underline; text-decoration-color: var(--color-accent-2); cursor: pointer; }
  .linkish:hover { color: var(--color-accent-2); }
  .linkish:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .c-msg:empty { display: none; }
  .c-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .c-list :global(li.c) { display: grid; gap: var(--space-2xs); padding-block: var(--space-md); border-top: var(--rule-hair) solid var(--color-ink); }
  .c-list :global(.c-head) { display: flex; flex-wrap: wrap; gap: var(--space-sm); align-items: baseline; font-size: var(--text-sm); }
  .c-list :global(.c-name) { font-weight: 500; }
  .c-list :global(.c-time) { color: var(--color-muted); }
  .c-list :global(.c-text) { white-space: pre-line; overflow-wrap: anywhere; }
</style>

<script>
  const box = document.querySelector<HTMLElement>('[data-comments]');
  if (box) {
    const start = () => import('../scripts/comments').then((m) => m.mount(box)).catch(() => {});
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((e) => { if (e.some((x) => x.isIntersecting)) { io.disconnect(); start(); } }, { rootMargin: '600px 0px' });
      io.observe(box);
    } else start();
  }
</script>
