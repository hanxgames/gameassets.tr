---
import Base from '../layouts/Base.astro';
import AssetCard from '../components/AssetCard.astro';
import BundleCard from '../components/BundleCard.astro';
import ListingHero from '../components/ListingHero.astro';
import { seriesOrder, bySeries, bundles, bundleSeries, absolute, type SeriesKey } from '../data/site';
import { useT, href } from '../i18n';

interface Props { lang: string; series: SeriesKey }
const { lang, series: key } = Astro.props;
const t = useT(lang);
const L = (p: string) => href(lang, p);
const title = t(`series.${key}.title`);
const list = bySeries(key);
const models = list.reduce((n, a) => n + (a.modelCount || 0), 0);
const min = `$${Math.min(...list.map((a) => a.priceValue).filter((v) => v > 0)).toFixed(2)}`;
const myBundles = bundles.filter((b) => bundleSeries(b) === key);
const others = seriesOrder.filter((s) => s !== key);
const path = `/collections/${key}/`;
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: t(`series.${key}.seoTitle`),
    description: t(`series.${key}.long`),
    inLanguage: lang,
    url: absolute(L(path)),
    mainEntity: { '@type': 'ItemList', numberOfItems: list.length, itemListElement: list.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: absolute(L(`/assets/${a.slug}/`)), name: a.title })) },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('nav.home'), item: absolute(L('/')) },
      { '@type': 'ListItem', position: 2, name: title, item: absolute(L(path)) },
    ],
  },
];
---
<Base
  lang={lang}
  path={path}
  title={t(`series.${key}.seoTitle`)}
  description={t('col.description', { title, n: list.length, models, min })}
  image={myBundles[0]?.og || list[0]?.cover.src}
  jsonld={jsonld}
>
  <ListingHero title={`${title}.`} crumbs={[{ href: L('/'), label: t('nav.home') }, { href: L('/assets/'), label: t('nav.allPacks') }, { label: title }]}>
    <p>{t('col.lead', { n: list.length, models, blurb: t(`series.${key}.blurb`) })}</p>
  </ListingHero>
  <div class="container">
    <section class="section--s">
      <div class="pack-grid">{list.map((a, i) => <AssetCard asset={a} lang={lang} eager={i < 4} />)}</div>
    </section>

    {myBundles.length > 0 && (
      <section class="section">
        <h2 class="block-head">{t('col.bundleH2', { n: list.length })}</h2>
        {myBundles.map((b) => <BundleCard bundle={b} lang={lang} />)}
      </section>
    )}

    <section class="section about-series">
      <h2>{t('col.aboutH2')}</h2>
      <p class="lead">{t(`series.${key}.long`)}</p>
    </section>

    <section class="section">
      <h2 class="block-head">{t('col.othersH2')}</h2>
      <ul class="others">
        {others.map((o) => (
          <li><a href={L(`/collections/${o}/`)}><span>{t(`series.${o}.title`)}</span><span class="small">{t('col.packsN', { n: bySeries(o).length })}</span></a></li>
        ))}
      </ul>
    </section>
  </div>
</Base>
<style>
  .block-head { margin-bottom: var(--space-xl); }
  .about-series { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gap-columns); }
  .about-series h2 { grid-column: 1 / span 5; text-wrap: balance; }
  .about-series .lead { grid-column: 6 / span 7; max-width: 60ch; }
  .others { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap-columns); }
  .others a { display: grid; gap: var(--space-xs); padding: var(--space-lg); border: var(--rule-bar) solid var(--color-ink); box-shadow: var(--shadow-card); text-decoration: none; background: var(--color-paper); transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out); }
  .others a span:first-child { font: var(--display-weight) var(--text-xl)/1.1 var(--font-display); text-transform: uppercase; letter-spacing: var(--tracking-display); }
  .others a:hover { background: var(--color-ink); color: var(--color-paper); }
  .others a:hover .small { color: var(--color-paper-3); }
  .others a:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  .others a:active { box-shadow: var(--shadow-press); }
  @media (max-width: 60rem) { .about-series h2, .about-series .lead { grid-column: 1 / -1; } .others { grid-template-columns: minmax(0, 1fr); } }
</style>
