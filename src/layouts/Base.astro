---
import '../styles/global.css';
import { SITE, SERIES, seriesOrder, absolute, assets, bundles } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'product' | 'article';
  jsonld?: object[];
  noindex?: boolean;
  lang?: 'en' | 'tr';
  alternates?: { lang: string; href: string }[];
  /** Product-specific OG price tags */
  price?: { amount: number; currency: string };
}
const { title, description, image = '/og/home.jpg', imageAlt, type = 'website', jsonld = [], noindex = false, lang = 'en', alternates = [], price } = Astro.props;
const canonical = absolute(Astro.url.pathname);
const ogImage = absolute(image);
const fullTitle = title.includes(SITE.brand) || title.includes(SITE.name) ? title : `${title} | ${SITE.brand}`;
const path = Astro.url.pathname;
const nav = [
  { href: '/assets/', label: lang === 'tr' ? 'Tüm paketler' : 'All packs' },
  { href: '/bundles/', label: lang === 'tr' ? 'Bundle fırsatları' : 'Bundles' },
  { href: '/collections/low-poly/', label: 'Low poly' },
  { href: '/collections/3d-pixel/', label: '3D pixel' },
  { href: '/faq/', label: 'FAQ' },
];
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#org`,
  name: SITE.studio,
  alternateName: [SITE.brand, SITE.name],
  url: SITE.url,
  logo: absolute('/icon-512.png'),
  sameAs: [SITE.itch, SITE.twitterUrl],
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  alternateName: SITE.brand,
  url: SITE.url,
  inLanguage: lang,
  publisher: { '@id': `${SITE.url}/#org` },
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/assets/?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={absolute(a.href)} />)}
    <meta name="theme-color" content="#f6efd9" />
    <meta name="color-scheme" content="light" />
    <meta name="author" content={SITE.studio} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type === 'product' ? 'product' : type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt || title} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    {price && <meta property="product:price:amount" content={price.amount.toFixed(2)} />}
    {price && <meta property="product:price:currency" content={price.currency} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:creator" content={SITE.twitter} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="HanX Assets — new asset packs" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@800&family=Golos+Text:wght@400;500&display=swap" />
    <slot name="head" />

    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="skip visually-hidden-focusable" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="container">
        <nav aria-label="Shop">
          {nav.slice(0, 3).map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <a class="wordmark" href={lang === 'tr' ? '/tr/' : '/'} aria-label={`${SITE.brand}, home`}>HanX <b>Assets</b></a>
        <nav aria-label="Info">
          {nav.slice(3).map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          <a href={SITE.itch} target="_blank" rel="noopener">{lang === 'tr' ? 'itch.io mağazası' : 'itch.io store'}</a>
        </nav>
        <button class="menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
      </div>
      <div class="mobile-nav" id="mobile-nav">
        <ul class="container">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href={SITE.itch} target="_blank" rel="noopener">itch.io store</a></li>
        </ul>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="footer">
      <div class="container">
        <p class="wordmark-xl" aria-hidden="true">HanX <b>Assets</b></p>
        <div class="footer-links">
          <div>
            <p class="footer-head">Collections</p>
            <ul>{seriesOrder.map((s) => <li><a href={`/collections/${s}/`}>{SERIES[s].name} packs</a></li>)}</ul>
          </div>
          <div>
            <p class="footer-head">By engine</p>
            <ul>
              <li><a href="/engines/unity/">Unity assets</a></li>
              <li><a href="/engines/godot/">Godot 4 assets</a></li>
              <li><a href="/engines/unreal/">Unreal assets</a></li>
              <li><a href="/engines/blender/">Blender models</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-head">HanX Assets</p>
            <ul>
              <li><a href="/bundles/">Bundle deals</a></li>
              <li><a href="/faq/">FAQ</a></li>
              <li><a href="/license/">License</a></li>
              <li><a href="/about/">About</a></li>
              <li><a href="/tr/" hreflang="tr">Türkçe</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-head">Elsewhere</p>
            <ul>
              <li><a href={SITE.itch} target="_blank" rel="noopener">itch.io store</a></li>
              <li><a href={SITE.twitterUrl} target="_blank" rel="noopener">X (Twitter)</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-legal">
          <span>© {year} {SITE.studio}. {assets.length} packs and {bundles.length} bundles, sold and delivered through itch.io.</span>
          <span>{lang === 'tr' ? 'Türkiye’de yapıldı.' : 'Made in Türkiye.'}</span>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-nav');
      btn?.addEventListener('click', () => {
        const open = menu!.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(open));
        btn.textContent = open ? 'Close' : 'Menu';
      });

      // Buy buttons open the itch.io checkout in a centred popup on desktop,
      // and navigate normally on phones or when popups are blocked.
      document.addEventListener('click', (ev) => {
        const a = (ev.target as HTMLElement).closest<HTMLAnchorElement>('a[data-buy]');
        if (!a || ev.metaKey || ev.ctrlKey || ev.shiftKey || window.innerWidth < 900) return;
        const w = 720, h = 760;
        const left = window.screenX + (window.outerWidth - w) / 2;
        const top = window.screenY + (window.outerHeight - h) / 2;
        const win = window.open(a.dataset.popup || a.href, 'itch_purchase', `width=${w},height=${h},left=${left},top=${top},resizable=yes,scrollbars=yes`);
        if (win) { ev.preventDefault(); win.focus(); }
      });
    </script>
  </body>
</html>
<style is:global>
  html, body { overflow-x: clip; }
</style>
