---
import Base from '../../layouts/Base.astro';
import AssetCard from '../../components/AssetCard.astro';
import BundleCard from '../../components/BundleCard.astro';
import ListingHero from '../../components/ListingHero.astro';
import { SITE, SERIES, bundles, membersOf, bundleName, bundleSeries, bundleSavings, absolute, fmtUSD, type Bundle } from '../../data/site';

export function getStaticPaths() {
  return bundles.map((b) => ({ params: { slug: b.slug }, props: { bundle: b } }));
}
const { bundle: b } = Astro.props as { bundle: Bundle };
const members = membersOf(b);
const S = SERIES[bundleSeries(b)];
const save = bundleSavings(b);
const name = bundleName(b);
const sumFull = members.reduce((n, a) => n + a.originalPriceValue, 0);
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `${name} — ${members.length} ${S.name} asset packs`,
    description: b.description || `${members.length} ${S.title.toLowerCase()} in one bundle.`,
    image: [absolute(b.og)],
    brand: { '@type': 'Brand', name: SITE.brand },
    sku: `bundle-${b.id}`,
    url: absolute(`/bundles/${b.slug}/`),
    offers: {
      '@type': 'Offer',
      url: b.url,
      price: b.bundlePriceValue.toFixed(2),
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      priceValidUntil: (b.ends || new Date(Date.now() + 180 * 864e5).toISOString()).slice(0, 10),
      seller: { '@type': 'Organization', name: SITE.studio },
    },
    isRelatedTo: members.map((a) => ({ '@type': 'Product', name: a.itchTitle, url: absolute(`/assets/${a.slug}/`) })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: 'Bundles', item: absolute('/bundles/') },
      { '@type': 'ListItem', position: 3, name, item: absolute(`/bundles/${b.slug}/`) },
    ],
  },
];
---
<Base
  title={`${name}: ${members.length} ${S.name} Asset Packs for ${b.bundlePrice}${save ? ` (Save ${save}%)` : ''}`}
  description={`Get all ${members.length} ${S.title.toLowerCase()} (${b.modelCount}+ models) for just ${b.bundlePrice} instead of ${fmtUSD(sumFull)}. Unity, Godot, Unreal & Blender ready. Limited-time deal.`}
  image={b.og}
  type="product"
  price={{ amount: b.bundlePriceValue, currency: 'USD' }}
  jsonld={jsonld}
>
  <ListingHero eyebrow={`${S.emoji} ${members.length} packs · ${b.modelCount}+ models`} title={`${name.replace(/Bundle$/, '<em>Bundle</em>')}`} accent={S.accent} covers={members} crumbs={[{ href: '/', label: 'Home' }, { href: '/bundles/', label: 'Bundles' }, { label: name }]}>
    {b.description && <p>{b.description}</p>}
  </ListingHero>
  <div class="wrap">
    <BundleCard bundle={b} />
    <h2 style="margin:60px 0 22px;font-size:1.5rem">Everything included in this bundle</h2>
    <div class="grid">{members.map((a) => <AssetCard asset={a} />)}</div>
    <div class="value reveal">
      <div><span class="pixel">Bought separately</span><s>{fmtUSD(sumFull)}</s></div>
      <div><span class="pixel">Bundle price</span><strong>{b.bundlePrice}</strong></div>
      <a class="btn btn-buy btn-lg" href={b.url} target="_blank" rel="noopener">Get all {members.length} packs on itch.io</a>
    </div>
  </div>
  <div style="height:80px"></div>
</Base>
<style>
  .value { margin-top: 50px; display: flex; align-items: center; justify-content: center; gap: 40px; flex-wrap: wrap; padding: 32px; border-radius: 24px; border: 1px dashed rgba(255, 138, 31, 0.5); background: rgba(255, 138, 31, 0.06); text-align: center; }
  .value div { display: grid; gap: 6px; }
  .value span { font-size: 0.72rem; color: var(--muted); }
  .value s { font: 700 1.6rem/1 var(--font-display); color: var(--dim); }
  .value strong { font: 900 2.4rem/1 var(--font-display); color: var(--green); }
</style>
