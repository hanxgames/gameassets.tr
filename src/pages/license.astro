---
import Base from '../layouts/Base.astro';
import ListingHero from '../components/ListingHero.astro';
---
<Base title="Asset License: Royalty-Free Commercial Use" description="The HanX Assets license in plain English: use the low poly and 3D pixel models in unlimited commercial games, apps and videos. No royalties, no attribution required.">
  <ListingHero title="Use it. Ship it. Sell your game." crumbs={[{ href: '/', label: 'Home' }, { label: 'License' }]}>
    <p>Every pack carries a royalty-free commercial license. The LICENSE.txt in each download is the full, binding text; this is the short version.</p>
  </ListingHero>
  <div class="container">
    <section class="section--s">
      <dl class="rows">
        <div><dt>You can</dt><dd>Use the assets in unlimited personal and commercial projects: games, apps, videos, client work, game jams and prototypes. Modify, recolour and combine them freely, and ship them inside packaged games on any store. Credit is welcome, never required.</dd></div>
        <div><dt>You can’t</dt><dd>Resell or redistribute the raw asset files, alone or inside another asset pack, upload them to model libraries or marketplaces, or claim the original models as your own artwork.</dd></div>
        <div><dt>Not sure?</dt><dd>Leave a comment on the pack’s itch.io page and describe your use. We answer.</dd></div>
      </dl>
    </section>
  </div>
</Base>
