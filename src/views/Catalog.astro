---
import Base from '../layouts/Base.astro';
import AssetCard from '../components/AssetCard.astro';
import { SITE, absolute } from '../data/site';
import { CATEGORIES, listings, popular, inCategory, activeCreators, listingsBy } from '../data/market';
import { useT, href } from '../i18n';

interface Props { lang: string }
const { lang } = Astro.props;
const t = useT(lang);
const L = (p: string) => href(lang, p);
const list = popular;
const assets = listings;
const cats = CATEGORIES.map((c) => ({ ...c, n: inCategory(c.key).length })).filter((c) => c.n > 0);
const nCreators = activeCreators.length;
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.home'), item: absolute(L('/')) },
    { '@type': 'ListItem', position: 2, name: t('nav.allPacks'), item: absolute(L('/assets/')) },
  ],
};
const collection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: t('cat.title', { packs: assets.length }),
  url: absolute(L('/assets/')),
  inLanguage: lang,
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: list.length,
    itemListElement: list.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: absolute(L(`/assets/${a.slug}/`)), name: a.title })),
  },
};
---
<Base
  lang={lang}
  path="/assets/"
  title={t('cat.title', { packs: assets.length })}
  description={t('cat.description', { packs: assets.length, creators: nCreators })}
  jsonld={[breadcrumb, collection]}
>
  <header class="listing-head">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href={L('/')}>{t('nav.home')}</a></li><li><span aria-current="page">{t('nav.allPacks')}</span></li></ol></nav>
      <h1>{t('cat.h1', { packs: assets.length })}</h1>
      <p class="lead">{t('cat.lead')}</p>
    </div>
  </header>

  <div class="container">
    <div class="filters" role="search">
      <label class="search">
        <span class="visually-hidden">{t('cat.searchLabel')}</span>
        <input id="q" type="search" name="q" placeholder={t('cat.searchPh')} autocomplete="off" />
      </label>
      <div class="chips" role="group" aria-label={t('cat.category')}>
        <button class="fchip active" type="button" data-cat="" aria-pressed="true">{t('cat.all', { n: assets.length })}</button>
        {cats.map((c) => <button class="fchip" type="button" data-cat={c.key} aria-pressed="false">{t(`catg.${c.key}.name`)} {c.n}</button>)}
      </div>
      <div class="selects">
        <label><span class="visually-hidden">{t('cat.price')}</span>
          <select id="price" name="price">
            <option value="">{t('cat.anyPrice')}</option>
            <option value="free">{t('cat.free')}</option>
            <option value="paid">{t('cat.paid')}</option>
          </select>
        </label>
        <label><span class="visually-hidden">{t('cat.sort')}</span>
          <select id="sort" name="sort">
            <option value="featured">{t('sort.popular')}</option>
            <option value="new">{t('sort.new')}</option>
            <option value="price-asc">{t('sort.priceAsc')}</option>
            <option value="price-desc">{t('sort.priceDesc')}</option>
            <option value="models">{t('sort.models')}</option>
          </select>
        </label>
      </div>
    </div>
    <ul class="creator-hits" id="creator-hits" aria-label={t('cat.creatorsMatch')} hidden>
      {activeCreators.map((c) => (
        <li data-search={`${c.name} ${c.handle}`.toLowerCase()} hidden><a href={L(`/creators/${c.handle}/`)}>{c.name} <span class="small">{t('creator.packsN', { n: listingsBy(c.handle).length })}</span></a></li>
      ))}
    </ul>
    <p class="small result-count" id="count" role="status" data-one={t('cat.countOne')} data-other={t('cat.countOther')}>{t('cat.countOther', { n: assets.length })}</p>

    <div class="pack-grid" id="grid">
      {list.map((a, i) => <AssetCard asset={a} lang={lang} eager={i < 4} headingLevel="h2" />)}
    </div>
    <p class="empty" id="empty" hidden>{t('cat.empty')} <button class="btn btn--sm" type="button" id="reset">{t('cat.reset')}</button></p>
  </div>
</Base>

<style>
  .filters { position: sticky; top: var(--nav-height); z-index: var(--z-sticky); display: flex; flex-wrap: wrap; gap: var(--space-md); align-items: center; padding-block: var(--space-lg); background: var(--color-paper); border-bottom: var(--rule-bar) solid var(--color-ink); }
  .search { flex: 1 1 280px; display: flex; }
  .search input { width: 100%; min-height: 48px; padding: 0 var(--space-md); border: var(--rule-bar) solid var(--color-ink); border-radius: var(--radius-pill); background: var(--color-paper); color: var(--color-ink); font-size: var(--text-md); }
  .search input::placeholder { color: var(--color-muted); }
  .search input:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .fchip { min-height: 44px; padding: 0 var(--space-md); border: var(--rule-bar) solid var(--color-ink); border-radius: var(--radius-pill); background: var(--color-paper); color: var(--color-ink); font-size: var(--text-sm); font-weight: 500; white-space: nowrap; cursor: pointer; transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out); }
  .fchip:hover { background: var(--color-paper-3); }
  .fchip.active { background: var(--color-ink); color: var(--color-paper); }
  .fchip:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .fchip:active { background: var(--color-ink-2); color: var(--color-paper); }
  .selects { display: flex; gap: var(--space-xs); }
  select { appearance: none; min-height: 48px; padding: 0 var(--space-xl) 0 var(--space-md); border: var(--rule-bar) solid var(--color-ink); border-radius: var(--radius-pill); background: var(--color-paper); color: var(--color-ink); font-size: var(--text-sm); font-weight: 500; cursor: pointer; background-image: linear-gradient(45deg, transparent 50%, var(--color-ink) 50%), linear-gradient(135deg, var(--color-ink) 50%, transparent 50%); background-position: calc(100% - 18px) 50%, calc(100% - 12px) 50%; background-size: 6px 6px; background-repeat: no-repeat; }
  select:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .creator-hits { list-style: none; margin: var(--space-lg) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .creator-hits a { display: inline-flex; gap: var(--space-xs); align-items: baseline; padding: var(--space-2xs) var(--space-md); border: var(--rule-bar) solid var(--color-ink); background: var(--color-accent); color: var(--color-accent-ink); font-weight: 500; text-decoration: none; transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out); }
  .creator-hits a:hover { background: var(--color-ink); color: var(--color-paper); }
  .creator-hits a:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .creator-hits li[hidden], .creator-hits[hidden] { display: none; }
  .result-count { margin-block: var(--space-lg) var(--space-xl); }
  .empty { padding-block: var(--space-3xl); font-size: var(--text-lead); display: flex; gap: var(--space-md); align-items: center; flex-wrap: wrap; }
  .pack[hidden] { display: none; }
  @media (max-width: 60rem) { .filters { position: static; } .selects { width: 100%; } .selects label, .selects select { flex: 1; width: 100%; } }
</style>

<script>
  const grid = document.getElementById('grid')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('.pack')];
  const original = [...cards];
  const q = document.getElementById('q') as HTMLInputElement;
  const price = document.getElementById('price') as HTMLSelectElement;
  const hitsBox = document.getElementById('creator-hits')!;
  const hits = [...hitsBox.querySelectorAll<HTMLElement>('li')];
  const sort = document.getElementById('sort') as HTMLSelectElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.fchip')];
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  let cat = '';

  const params = new URLSearchParams(location.search);
  q.value = params.get('q') || '';
  price.value = params.get('price') || '';
  sort.value = params.get('sort') || 'featured';
  cat = params.get('category') || '';
  chips.forEach((c) => { const on = c.dataset.cat === cat; c.classList.toggle('active', on); c.setAttribute('aria-pressed', String(on)); });

  function apply() {
    const terms = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const c of cards) {
      const p = Number(c.dataset.price || 0);
      const ok = (!cat || c.dataset.category === cat) &&
        (!price.value || (price.value === 'free' ? p === 0 : p > 0)) &&
        terms.every((t) => (c.dataset.search || '').includes(t));
      c.hidden = !ok;
      if (ok) shown++;
    }
    let anyHit = false;
    for (const h of hits) { const on = terms.length > 0 && terms.every((t) => (h.dataset.search || '').includes(t)); h.hidden = !on; anyHit ||= on; }
    hitsBox.hidden = !anyHit;
    const sorted = [...original];
    const num = (c: HTMLElement, k: string) => Number(c.dataset[k] || 0);
    if (sort.value === 'new') sorted.sort((a, b) => +new Date(b.dataset.date || 0) - +new Date(a.dataset.date || 0));
    if (sort.value === 'price-asc') sorted.sort((a, b) => num(a, 'price') - num(b, 'price'));
    if (sort.value === 'price-desc') sorted.sort((a, b) => num(b, 'price') - num(a, 'price'));
    if (sort.value === 'models') sorted.sort((a, b) => num(b, 'models') - num(a, 'models'));
    if (sort.value === 'views') sorted.sort((a, b) => num(b, 'views') - num(a, 'views'));
    sorted.forEach((c) => grid.appendChild(c));
    count.textContent = (shown === 1 ? count.dataset.one! : count.dataset.other!).replace('{n}', String(shown));
    empty.hidden = shown > 0;
    const p = new URLSearchParams();
    if (q.value) p.set('q', q.value);
    if (cat) p.set('category', cat);
    if (price.value) p.set('price', price.value);
    if (sort.value !== 'featured') p.set('sort', sort.value);
    history.replaceState(null, '', `${location.pathname}${p.toString() ? '?' + p : ''}`);
  }
  q.addEventListener('input', apply);
  price.addEventListener('change', apply);
  sort.addEventListener('change', apply);
  chips.forEach((c) => c.addEventListener('click', () => {
    cat = c.dataset.cat || '';
    chips.forEach((x) => { x.classList.toggle('active', x === c); x.setAttribute('aria-pressed', String(x === c)); });
    apply();
  }));
  document.getElementById('reset')!.addEventListener('click', () => {
    q.value = ''; price.value = ''; sort.value = 'featured'; cat = '';
    chips.forEach((x) => { x.classList.toggle('active', x.dataset.cat === ''); x.setAttribute('aria-pressed', String(x.dataset.cat === '')); });
    apply();
  });
  apply();
</script>
