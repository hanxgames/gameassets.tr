---
import View from '../../../views/Collection.astro';
import { OTHER_LOCALES } from '../../../i18n/locales';
import { assets, bundles, seriesOrder, bySeries, ENGINES } from '../../../data/site';
export function getStaticPaths() {
  return OTHER_LOCALES.flatMap((l) => seriesOrder.filter((s) => bySeries(s).length > 0).map((s) => ({ params: { series: s, lang: l.code } })));
}
---
<View lang={Astro.params.lang!} series={Astro.params.series as any} />
