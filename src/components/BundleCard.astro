---
import { bundleSavings, membersOf, type Bundle } from '../data/site';
import { useT, href, bundleLabel } from '../i18n';
import Countdown from './Countdown.astro';
interface Props { bundle: Bundle; lang?: string; compact?: boolean; eager?: boolean }
const { bundle: b, lang = 'en', compact = false, eager = false } = Astro.props;
const t = useT(lang);
const members = membersOf(b);
const save = bundleSavings(b);
const name = bundleLabel(t, b);
---
<article class="offer">
  <div class="offer-media">
    <div class="frame frame--cover tilt-l"><img src={members[0]?.cover.src} alt={t('bc.alt', { bundle: name, first: members[0]?.title ?? '', n: members.length - 1 })} width="1200" height="952" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" /></div>
    <span class="stamp offer-stamp">{t('bc.stamp', { n: members.length })}</span>
  </div>
  <div class="offer-body">
    <h3><a href={href(lang, `/bundles/${b.slug}/`)}>{name}</a></h3>
    {!compact && <p class="small">{members.map((m) => m.title.replace(/^(Low Poly|3D Pixel) (Halloween |Christmas )?/, '').replace(/ Pack$/, '')).join(', ')}.</p>}
    <p class="offer-price"><span class="price-figure">{b.bundlePrice}</span>{b.regularPrice && <span class="was">{b.regularPrice}</span>}</p>
    {save > 0 && <p class="small">{t('bc.save', { pct: save, n: members.length, models: b.modelCount })}</p>}
    {!compact && <Countdown ends={b.ends} label={t('bc.until')} lang={lang} />}
    <div class="actions">
      <a class="btn btn--primary" href={b.url} target="_blank" rel="noopener" aria-label={t('bc.getAria', { bundle: name, price: b.bundlePrice })}>{t('bc.getAll', { n: members.length })}</a>
      <a class="btn" href={href(lang, `/bundles/${b.slug}/`)}>{t('bc.see')}</a>
    </div>
  </div>
</article>
<style>
  .offer { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-2xl); align-items: center; padding-block: var(--space-2xl); border-top: var(--rule-bar) solid var(--color-accent-2); }
  .offer-media { position: relative; }
  .offer-stamp { left: calc(-1 * var(--space-sm)); bottom: calc(-1 * var(--space-sm)); }
  .offer-body { display: grid; gap: var(--space-md); justify-items: start; }
  .offer h3 { font-size: var(--text-section); }
  .offer h3 a { text-decoration: none; }
  .offer h3 a:hover { color: var(--color-accent-2); }
  .offer h3 a:focus-visible { outline: 2px solid var(--color-focus); }
  .offer-price { display: flex; align-items: baseline; gap: var(--space-md); }
  .offer-price .price-figure { font-size: var(--text-price); }
  .offer-price .was { font-size: var(--text-xl); }
  @media (max-width: 60rem) { .offer { grid-template-columns: minmax(0, 1fr); } }
</style>
