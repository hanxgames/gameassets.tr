---
/** The sale end date, stated once as a fact. */
import { fmtDate } from '../i18n';
interface Props { ends: string | null | undefined; label: string; lang?: string }
const { ends, label, lang = 'en' } = Astro.props;
const valid = ends && new Date(ends).getTime() > Date.now();
---
{valid && <p class="small">{label}{' '}<time datetime={ends}>{fmtDate(lang, ends!)}</time>.</p>}
