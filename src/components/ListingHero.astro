---
import type { Asset } from '../data/site';
interface Props { eyebrow?: string; title: string; accent?: string; covers?: Asset[]; crumbs: { href?: string; label: string }[] }
const { title, crumbs } = Astro.props;
---
<header class="listing-head">
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>{crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}</ol>
    </nav>
    <h1>{title}</h1>
    <div class="lead"><slot /></div>
  </div>
</header>
