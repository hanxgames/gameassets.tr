---
import Base from '../layouts/Base.astro';
import { FAQ, faqJsonLd } from '../data/faq';
---
<Base title="FAQ — Licensing, Engines & Checkout" description="Answers about HanX Assets: commercial license, Unity/Godot/Unreal support, file formats, mobile performance, bundles and instant itch.io checkout." jsonld={[faqJsonLd()]}>
  <div class="wrap narrow">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>FAQ</span></nav>
    <span class="eyebrow">Help center</span>
    <h1>Frequently asked <span class="grad-text">questions</span></h1>
    <p class="muted lead">Can’t find your answer? Ask in the comments of any pack on itch.io or ping us on X — we reply fast.</p>
    <div class="faq">{FAQ.map((f, i) => <details open={i < 2}><summary>{f.q}</summary><div class="answer">{f.a}</div></details>)}</div>
    <p style="margin-top:40px"><a class="btn btn-primary" href="/assets/">Browse asset packs →</a></p>
  </div>
</Base>
<style>.narrow { max-width: 860px; padding-bottom: 90px; } .lead { font-size: 1.1rem; margin-bottom: 36px; }</style>
