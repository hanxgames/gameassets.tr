---
import Base from '../layouts/Base.astro';
import ListingHero from '../components/ListingHero.astro';
import { absolute } from '../data/site';
import { activeCreators, listingsBy, creatorTotals } from '../data/market';
import { useT, href, fmtNum } from '../i18n';

interface Props { lang: string }
const { lang } = Astro.props;
const t = useT(lang);
const L = (p: string) => href(lang, p);
const list = [...activeCreators].sort((a, b) => creatorTotals(b).views - creatorTotals(a).views || listingsBy(b.handle).length - listingsBy(a.handle).length);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: t('creators.title'),
  url: absolute(L('/creators/')),
  inLanguage: lang,
  mainEntity: { '@type': 'ItemList', numberOfItems: list.length, itemListElement: list.map((c, i) => ({ '@type': 'ListItem', position: i + 1, url: absolute(L(`/creators/${c.handle}/`)), name: c.name })) },
};
---
<Base lang={lang} path="/creators/" title={t('creators.title')} description={t('creators.description', { n: list.length })} jsonld={[ld]}>
  <ListingHero title={t('creators.h1')} crumbs={[{ href: L('/'), label: t('nav.home') }, { label: t('nav.creators') }]}>
    <p>{t('creators.lead', { n: list.length })}</p>
  </ListingHero>
  <div class="container">
    <ul class="creator-grid">
      {list.map((c) => {
        const packs = listingsBy(c.handle);
        const tot = creatorTotals(c);
        return (
          <li class="creator-card">
            <div class={`covers covers-${Math.min(packs.length, 3)}`} aria-hidden="true">
              {packs.slice(0, 3).map((p) => <img src={p.cover.sm} alt="" width="630" height="500" loading="lazy" decoding="async" referrerpolicy="no-referrer" />)}
            </div>
            <div class="creator-body">
              {c.avatar && <img class="avatar" src={c.avatar} alt="" width="56" height="56" loading="lazy" referrerpolicy="no-referrer" />}
              <div>
                <h2><a href={L(`/creators/${c.handle}/`)}>{c.name}</a></h2>
                <p class="small">{t('creator.packsN', { n: packs.length })}{tot.views > 0 && <>, {t('pack.views', { n: fmtNum(lang, tot.views) })}</>}</p>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
    <p class="after"><a class="btn btn--primary" href={L('/sell/')}>{t('home.sellCta')}</a></p>
  </div>
</Base>
<style>
  .creator-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-2xl) var(--gap-columns); }
  .creator-card { position: relative; display: grid; border: var(--rule-bar) solid var(--color-ink); box-shadow: var(--shadow-card); background: var(--color-paper-2); transition: box-shadow var(--dur-micro) var(--ease-out); }
  .creator-card:hover { box-shadow: 6px 6px 0 var(--color-accent-2); }
  .covers { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) minmax(0, 1fr); aspect-ratio: 16 / 9; gap: 2px; background: var(--color-ink); border-bottom: var(--rule-bar) solid var(--color-ink); overflow: hidden; }
  .covers img { width: 100%; height: 100%; object-fit: cover; background: var(--color-paper-3); }
  .covers img:first-child { grid-row: span 2; }
  /* One or two packs: let the covers fill the frame instead of leaving empty cells. */
  .covers-1 { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); }
  .covers-1 img:first-child { grid-row: auto; }
  .covers-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: minmax(0, 1fr); }
  .covers-2 img:first-child { grid-row: auto; }
  .creator-body { display: flex; gap: var(--space-md); align-items: center; padding: var(--space-md); min-width: 0; }
  .avatar { width: 56px; height: 56px; object-fit: cover; border: var(--rule-bar) solid var(--color-ink); }
  .creator-body h2 { font-size: var(--text-xl); overflow-wrap: break-word; min-width: 0; }
  .creator-body h2 a { text-decoration: none; }
  .creator-body h2 a::after { content: ''; position: absolute; inset: 0; }
  .creator-body h2 a:hover { color: var(--color-accent-2); }
  .creator-body h2 a:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  .after { margin-top: var(--space-3xl); }
  @media (max-width: 60rem) { .creator-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 40rem) { .creator-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
