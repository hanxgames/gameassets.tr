---
import Base from '../../layouts/Base.astro';
import AssetCard from '../../components/AssetCard.astro';
import { seriesOrder, assets, bundles, bySeries, totalModels, minPrice, bundleName, bundleSavings, assetBySlug } from '../../data/site';

const modelsRounded = Math.floor(totalModels / 100) * 100;
const heroPack = assetBySlug('low-poly-christmas-village-pack') ?? assets[0];
const heroImage = heroPack.screenshots[0] ?? heroPack.cover;
const trSeries: Record<string, { t: string; d: string }> = {
  'low-poly': { t: 'Low poly 3D paketler', d: 'Şehir, trafik, köy, okul, inşaat, benzinlik ve SWAT. Tek doku, tek ölçek.' },
  '3d-pixel': { t: '3D pixel art paketler', d: 'Zindanlar, ortaçağ kasabaları, çiftlikler, ev içi ve RPG eşyaları.' },
  halloween: { t: 'Cadılar Bayramı paketleri', d: 'Balkabakları, perili evler ve ürkütücü sokaklar.' },
  christmas: { t: 'Yılbaşı paketleri', d: 'Karlı çatılar, ışıklar, yılbaşı ağaçları ve kış dekoru.' },
};
const faq = [
  { q: 'Ticari oyunlarda kullanabilir miyim?', a: 'Evet. Sınırsız kişisel ve ticari projede kullanılabilir, isim vermek zorunlu değildir. Yalnızca ham dosyaları yeniden satmak yasaktır.' },
  { q: 'Hangi motorlarla uyumlu?', a: 'Unity, Godot 4, Unreal Engine 5, Blender ve three.js. Her pakette GLB, FBX, OBJ ve .blend dosyaları var.' },
  { q: 'Nasıl satın alırım?', a: 'Satın Al butonu itch.io ödeme ekranını açar. Kart veya PayPal ile ödersin, dosyalar hemen iner ve itch.io kütüphanende kalır.' },
  { q: 'Mobil için uygun mu?', a: 'Evet. Modeller düşük poligonlu ve hepsi tek materyal ile tek palet dokusu kullanır, sahne çok az draw call ile çizilir.' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base
  lang="tr"
  title="Oyun Asset Paketleri: Low Poly ve 3D Pixel Modeller | Unity, Godot, Unreal"
  description={`${assets.length} hazır oyun asset paketi, ${modelsRounded}+ low poly ve 3D pixel model. Unity, Godot, Unreal ve Blender uyumlu, ticari lisanslı. $${minPrice.toFixed(2)}’dan başlayan fiyatlar.`}
  jsonld={[faqLd]}
  alternates={[{ lang: 'en', href: '/' }, { lang: 'tr', href: '/tr/' }, { lang: 'x-default', href: '/' }]}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>Oyun asset paketleri ${minPrice.toFixed(2)}’dan.</h1>
        <p class="lead">Unity, Godot, Unreal ve Blender için {assets.length} el yapımı 3D paket.</p>
        <div class="actions">
          <a class="btn btn--primary" href="/assets/">{assets.length} paketi incele</a>
          <a class="btn" href="/bundles/">Bundle fırsatları</a>
        </div>
      </div>
      <div class="frame hero-frame tilt-r"><img src={heroImage.src} alt={`${heroPack.title} sahnesi`} width="1600" height="1000" fetchpriority="high" decoding="async" /></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>Dört koleksiyon. Tek dünya.</h2></div>
      <dl class="rows">
        {seriesOrder.map((s) => (
          <div><dt><a class="link" href={`/collections/${s}/`}>{trSeries[s].t}</a></dt><dd>{trSeries[s].d} {bySeries(s).length} paket.</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>Öne çıkan paketler.</h2><p><a class="link" href="/assets/">Tüm {assets.length} paketi gör</a></p></div>
      <div class="pack-grid">{assets.slice(0, 8).map((a) => <AssetCard asset={a} />)}</div>
    </div>
  </section>

  {bundles.length > 0 && (
    <section class="band-paper">
      <div class="container">
        <div class="section-head"><h2>Tüm seri, tek ödeme.</h2></div>
        <div class="table-wrap">
          <table class="price-table">
            <thead><tr><th scope="col">Bundle</th><th scope="col">Paket</th><th scope="col">Tek tek</th><th scope="col">Bundle fiyatı</th><th scope="col"><span class="visually-hidden">Satın al</span></th></tr></thead>
            <tbody>
              {bundles.map((b) => (
                <tr>
                  <td class="name"><a href={`/bundles/${b.slug}/`}>{bundleName(b)}</a></td>
                  <td>{b.members.length}</td>
                  <td class="was">{b.regularPrice}</td>
                  <td class="big">{b.bundlePrice} <span class="small">%{bundleSavings(b)} tasarruf</span></td>
                  <td><a class="btn btn--sm" href={b.url} target="_blank" rel="noopener">Satın al</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>Sık sorulanlar.</h2></div>
      <div class="faq">{faq.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><div class="answer">{f.a}</div></details>)}</div>
      <p class="note small">Paket sayfaları uluslararası kitle için İngilizcedir. <a class="link" href="/" hreflang="en">English version</a></p>
    </div>
  </section>
</Base>
<style>
  .hero { padding-block: var(--space-2xl) var(--space-3xl); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-3xl); align-items: center; }
  .hero-copy { display: grid; gap: var(--space-lg); justify-items: start; }
  .hero-copy h1 { font-size: clamp(3rem, 5.2vw, 6rem); max-width: 11ch; overflow-wrap: break-word; min-width: 0; text-wrap: balance; }
  .hero-frame { aspect-ratio: 16 / 10; }
  .note { margin-top: var(--space-xl); }
  @media (max-width: 60rem) { .hero-grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); } }
</style>
