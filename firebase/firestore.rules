rules_version = '2';

// GameAssets.tr marketplace.
// Public data (creators, packs, stats, meta) is readable by anyone: the static
// site is built from it. Everything that proves ownership (verification,
// store import, slugs, handles) is written only by Cloud Functions.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // Admins are listed by e-mail in /admins/{email} (managed from the console).
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(db)/documents/admins/$(request.auth.token.email));
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function str(v, max) { return v is string && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || str(d[k], max); }
    function myCreator() { return get(/databases/$(db)/documents/creators/$(request.auth.uid)).data; }

    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /meta/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /handles/{handle} {
      allow read: if true;
      allow write: if false;
    }

    match /storeUsers/{user} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Private member details asked once after sign-up: who they are and their studio.
    match /users/{uid} {
      function roleOk(d) {
        return d.role in ['creator', 'developer', 'both', 'player']
          && optStr(d, 'studio', 60);
      }
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['role', 'studio', 'createdAt', 'updatedAt'])
        && roleOk(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isMe(uid)
        && changed().hasOnly(['role', 'studio', 'updatedAt'])
        && roleOk(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /creators/{uid} {
      allow read: if true;
      // Profile text the creator may edit. Status, verification and handle are server-side.
      allow update: if isMe(uid)
        && resource.data.status in ['active', 'restricted']
        && changed().hasOnly(['displayName', 'bio', 'website', 'twitter', 'updatedAt'])
        && str(request.resource.data.displayName, 60)
        && request.resource.data.displayName.size() >= 2
        && optStr(request.resource.data, 'bio', 600)
        && optStr(request.resource.data, 'website', 200)
        && optStr(request.resource.data, 'twitter', 40);
      allow update: if isAdmin()
        && changed().hasOnly(['status', 'adminNote', 'featured', 'updatedAt']);
      allow create, delete: if false;

      match /private/{doc} {
        allow read: if isMe(uid) || isAdmin();
        allow write: if false;
      }
    }

    match /packs/{id} {
      allow read: if true;
      allow create: if false;
      // Owners edit the listing text; store data (images, price, description) comes from import.
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && myCreator().status == 'active'
        && changed().hasOnly(['title', 'category', 'tags', 'short', 'ownerHidden', 'updatedAt'])
        && str(request.resource.data.title, 80)
        && request.resource.data.title.size() >= 2
        && request.resource.data.category in ['3d', '2d', 'ui', 'audio', 'vfx', 'shaders', 'fonts', 'tools']
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 12
        && str(request.resource.data.short, 200)
        && request.resource.data.ownerHidden is bool;
      allow update: if isAdmin()
        && changed().hasOnly(['status', 'adminNote', 'featured', 'updatedAt']);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid && myCreator().status in ['active', 'restricted']);
    }

    // Anonymous view / buy-click counters.
    //   v, c: all-time views and clicks
    //   d:    { "<day index since epoch>": { v, c } }, pruned by a scheduled function
    match /stats/{id} {
      allow read: if true;

      function today() { return int(request.time.toMillis() / 86400000); }
      function dayKeys() { return [string(today() - 1), string(today()), string(today() + 1)]; }
      function dayOk(nd, od, k) {
        return !(k in nd) || (
          nd[k] is map
          && nd[k].keys().hasOnly(['v', 'c'])
          && nd[k].get('v', 0) <= od.get(k, {}).get('v', 0) + 1
          && nd[k].get('c', 0) <= od.get(k, {}).get('c', 0) + 1
        );
      }
      function daysOk(nd, od) {
        return nd is map
          && nd.diff(od).affectedKeys().hasOnly(dayKeys())
          && dayOk(nd, od, dayKeys()[0])
          && dayOk(nd, od, dayKeys()[1])
          && dayOk(nd, od, dayKeys()[2]);
      }

      function delta(k) { return request.resource.data.get(k, 0) - resource.data.get(k, 0); }
      function slugOk() { return id.matches('^[a-z0-9][a-z0-9-]{1,119}$'); }

      allow create: if slugOk()
        && request.resource.data.keys().hasOnly(['v', 'c', 'd', 'l', 'dl'])
        && request.resource.data.get('v', 0) in [0, 1]
        && request.resource.data.get('c', 0) in [0, 1]
        && request.resource.data.get('l', 0) in [0, 1]
        && request.resource.data.get('dl', 0) in [0, 1]
        && daysOk(request.resource.data.get('d', {}), {});
      // One view or one buy click at a time.
      allow update: if changed().hasOnly(['v', 'c', 'd'])
        && (
          (delta('v') == 1 && delta('c') == 0)
          || (delta('c') == 1 && delta('v') == 0)
        )
        && daysOk(request.resource.data.get('d', {}), resource.data.get('d', {}));
      // Likes / dislikes: each moves by at most one (switching a vote moves both), never below zero.
      allow update: if changed().hasOnly(['l', 'dl'])
        && delta('l') in [-1, 0, 1] && delta('dl') in [-1, 0, 1]
        && request.resource.data.get('l', 0) >= 0 && request.resource.data.get('dl', 0) >= 0;
      allow delete: if false;
    }

    // Comments: public to read; posting needs a confirmed e-mail and a free account in good standing.
    // A per-user guard document, written in the same batch, allows one comment every 20 seconds.
    match /commentGuards/{uid} {
      allow read: if isMe(uid);
      allow create: if isMe(uid) && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
      allow update: if isMe(uid) && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
        && request.time > resource.data.at + duration.value(20, 's');
      allow delete: if false;
    }
    match /comments/{cid} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['slug', 'uid', 'name', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.slug is string && request.resource.data.slug.matches('^[a-z0-9][a-z0-9-]{1,119}$')
        && str(request.resource.data.name, 60) && request.resource.data.name.size() > 0
        && str(request.resource.data.text, 1000) && request.resource.data.text.size() > 0
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(db)/documents/commentGuards/$(request.auth.uid)).data.at == request.time
        && !(exists(/databases/$(db)/documents/creators/$(request.auth.uid))
             && get(/databases/$(db)/documents/creators/$(request.auth.uid)).data.status in ['suspended', 'banned']);
      allow update: if false;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
