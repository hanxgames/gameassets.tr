---
import Base from '../../layouts/Base.astro';
import AssetCard from '../../components/AssetCard.astro';
import BundleCard from '../../components/BundleCard.astro';
import ListingHero from '../../components/ListingHero.astro';
import { SITE, SERIES, bundles, membersOf, bundleName, bundleSeries, bundleSavings, absolute, fmtUSD, type Bundle } from '../../data/site';

export function getStaticPaths() {
  return bundles.map((b) => ({ params: { slug: b.slug }, props: { bundle: b } }));
}
const { bundle: b } = Astro.props as { bundle: Bundle };
const members = membersOf(b);
const S = SERIES[bundleSeries(b)];
const save = bundleSavings(b);
const name = bundleName(b);
const sumFull = members.reduce((n, a) => n + a.originalPriceValue, 0);
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `${name}: ${members.length} ${S.name} asset packs`,
    description: b.description || `${members.length} ${S.title.toLowerCase()} in one bundle.`,
    image: [absolute(b.og)],
    brand: { '@type': 'Brand', name: SITE.brand },
    sku: `bundle-${b.id}`,
    url: absolute(`/bundles/${b.slug}/`),
    offers: {
      '@type': 'Offer',
      url: b.url,
      price: b.bundlePriceValue.toFixed(2),
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      priceValidUntil: (b.ends || new Date(Date.now() + 180 * 864e5).toISOString()).slice(0, 10),
      seller: { '@type': 'Organization', name: SITE.studio },
    },
    isRelatedTo: members.map((a) => ({ '@type': 'Product', name: a.itchTitle, url: absolute(`/assets/${a.slug}/`) })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: 'Bundles', item: absolute('/bundles/') },
      { '@type': 'ListItem', position: 3, name, item: absolute(`/bundles/${b.slug}/`) },
    ],
  },
];
---
<Base
  title={`${name}: ${members.length} ${S.name} Asset Packs for ${b.bundlePrice}${save ? ` (Save ${save}%)` : ''}`}
  description={`Get all ${members.length} ${S.title.toLowerCase()} (${b.modelCount}+ models) for ${b.bundlePrice} instead of ${fmtUSD(sumFull)}. Unity, Godot, Unreal and Blender ready.`}
  image={b.og}
  type="product"
  price={{ amount: b.bundlePriceValue, currency: 'USD' }}
  jsonld={jsonld}
>
  <ListingHero title={`${name}.`} crumbs={[{ href: '/', label: 'Home' }, { href: '/bundles/', label: 'Bundles' }, { label: name }]}>
    {b.description && <p>{b.description.replace(/\s+[—–]\s+/g, ', ')}</p>}
  </ListingHero>
  <div class="container">
    <BundleCard bundle={b} eager />
    <section class="section">
      <h2 class="block-head">What is inside.</h2>
      <div class="pack-grid">{members.map((a) => <AssetCard asset={a} />)}</div>
    </section>
  </div>
</Base>
<style>.block-head { margin-bottom: var(--space-xl); }</style>
