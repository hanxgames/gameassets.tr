---
/** The sale end date, stated once as a fact. */
interface Props { ends: string | null | undefined; label?: string }
const { ends, label = 'Sale price until' } = Astro.props;
const valid = ends && new Date(ends).getTime() > Date.now();
const d = valid ? new Date(ends!) : null;
---
{d && <p class="small">{label}{' '}<time datetime={ends}>{d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>.</p>}
