---
import Base from '../../layouts/Base.astro';
import AssetCard from '../../components/AssetCard.astro';
import BundleCard from '../../components/BundleCard.astro';
import ListingHero from '../../components/ListingHero.astro';
import { SERIES, seriesOrder, bySeries, bundles, bundleSeries, absolute, type SeriesKey } from '../../data/site';

export function getStaticPaths() {
  return seriesOrder.filter((s) => bySeries(s).length > 0).map((s) => ({ params: { series: s } }));
}
const key = Astro.params.series as SeriesKey;
const S = SERIES[key];
const list = bySeries(key);
const models = list.reduce((n, a) => n + (a.modelCount || 0), 0);
const prices = list.map((a) => a.priceValue).filter((v) => v > 0);
const myBundles = bundles.filter((b) => bundleSeries(b) === key);
const others = seriesOrder.filter((s) => s !== key);
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: S.seoTitle,
    description: S.long,
    url: absolute(`/collections/${key}/`),
    mainEntity: { '@type': 'ItemList', numberOfItems: list.length, itemListElement: list.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: absolute(`/assets/${a.slug}/`), name: a.title })) },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: S.title, item: absolute(`/collections/${key}/`) },
    ],
  },
];
---
<Base
  title={S.seoTitle}
  description={`${list.length} ${S.title.toLowerCase()} with ${models}+ game-ready models for Unity, Godot & Unreal. ${S.blurb.split('—')[0].trim()} From $${Math.min(...prices).toFixed(2)}.`.slice(0, 165)}
  image={myBundles[0]?.og || list[0]?.cover.src}
  jsonld={jsonld}
>
  <ListingHero eyebrow={`${S.emoji} ${list.length} packs · ${models}+ models`} title={`${S.title.replace(S.name, `<em>${S.name}</em>`)}`} accent={S.accent} covers={list} crumbs={[{ href: '/', label: 'Home' }, { href: '/assets/', label: 'Assets' }, { label: S.title }]}>
    <p>{S.long}</p>
  </ListingHero>
  <div class="wrap">
    {myBundles.length > 0 && (
      <div class="b-list">{myBundles.map((b) => <BundleCard bundle={b} />)}</div>
    )}
    <h2 class="list-title">{list.length} {S.title}</h2>
    <div class="grid">{list.map((a, i) => <AssetCard asset={a} eager={i < 3} />)}</div>

    <section class="section">
      <h2>Explore other collections</h2>
      <div class="others">
        {others.map((o) => (
          <a href={`/collections/${o}/`} class="other" style={`--accent:${SERIES[o].accent}`}>
            <span>{SERIES[o].emoji}</span><b>{SERIES[o].title}</b><em>{bySeries(o).length} packs →</em>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
<style>
  .b-list { display: grid; gap: 20px; margin-bottom: 50px; }
  .list-title { font-size: 1.4rem; margin-bottom: 22px; }
  .others { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .other { display: grid; gap: 4px; padding: 22px; border-radius: 18px; border: 1px solid var(--line); background: var(--panel); transition: border-color 0.3s, transform 0.3s var(--ease); }
  .other:hover { border-color: var(--accent); transform: translateY(-3px); }
  .other span { font-size: 1.6rem; }
  .other em { font-style: normal; color: var(--accent); font-size: 0.88rem; font-weight: 700; }
  @media (max-width: 760px) { .others { grid-template-columns: 1fr; } }
</style>
