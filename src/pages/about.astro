---
import Base from '../layouts/Base.astro';
import { SITE, assets, totalModels } from '../data/site';
const about = { '@context': 'https://schema.org', '@type': 'AboutPage', name: 'About HanX Games', url: `${SITE.url}/about/`, mainEntity: { '@id': `${SITE.url}/#org` } };
---
<Base title="About HanX Games — Indie Studio Behind HanX Assets" description={`HanX Games is an indie game studio from Türkiye crafting handmade low poly and 3D pixel asset packs: ${assets.length} packs and ${totalModels}+ models for Unity, Godot and Unreal.`} jsonld={[about]}>
  <div class="wrap narrow">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>About</span></nav>
    <span class="eyebrow">The studio</span>
    <h1>We make the assets <span class="grad-text">we wish we had.</span></h1>
    <div class="prose">
      <p><strong>HanX Games</strong> is an independent game studio from Türkiye. While building our own games we kept running into the same problem: asset packs that didn’t match each other, used dozens of materials and tanked performance on mobile.</p>
      <p>So we built <strong>HanX Assets</strong> — a growing library of {assets.length} handmade packs and {totalModels}+ models that all share one palette texture, one real-world scale and one 8 m grid. Cities, traffic, villages, schools, construction sites, a full SWAT team, 3D pixel dungeons and seasonal Halloween & Christmas editions: everything snaps together into one consistent world and renders in a single draw call.</p>
      <p>Every model is made by hand — no generative AI — with clean topology, clean names and a README listing triangle counts and sizes.</p>
      <h2>Where to find us</h2>
      <ul>
        <li>Store &amp; downloads: <a href={SITE.itch} target="_blank" rel="noopener">hanx-games.itch.io</a></li>
        <li>News &amp; previews: <a href={SITE.twitterUrl} target="_blank" rel="noopener">X / Twitter {SITE.twitter}</a></li>
        <li>Requests &amp; support: comment on any pack’s itch.io page</li>
      </ul>
    </div>
    <p style="margin-top:30px"><a class="btn btn-primary" href="/assets/">See all packs →</a></p>
  </div>
</Base>
<style>.narrow { max-width: 860px; padding-bottom: 90px; }</style>
