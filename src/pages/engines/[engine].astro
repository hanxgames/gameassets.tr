---
import Base from '../../layouts/Base.astro';
import AssetCard from '../../components/AssetCard.astro';
import ListingHero from '../../components/ListingHero.astro';
import { ENGINES, byEngine, assets, absolute, minPrice, type EngineKey } from '../../data/site';

export function getStaticPaths() {
  return (Object.keys(ENGINES) as EngineKey[]).map((e) => ({ params: { engine: e } }));
}
const key = Astro.params.engine as EngineKey;
const E = ENGINES[key];
// Every pack ships GLB, FBX, OBJ and .blend, so all packs work everywhere; packs that name the engine come first.
const explicit = byEngine(key);
const list = [...explicit, ...assets.filter((a) => !explicit.includes(a))];
const models = list.reduce((n, a) => n + (a.modelCount || 0), 0);
const faq = [
  { q: `Do HanX Assets work in ${E.name}?`, a: `Yes. Every pack includes GLB, FBX and OBJ files plus a native .blend, so all ${assets.length} packs import into ${E.name}. ${E.how}` },
  { q: `Can I use these ${E.name} assets commercially?`, a: 'Yes. After purchase you can use them in unlimited commercial games and apps with no royalties and no attribution. Only reselling the raw files is not allowed.' },
  { q: `Do they run well on mobile with ${E.name}?`, a: 'Yes. The models share one material and one small palette texture, so scenes batch into very few draw calls, and triangle counts stay low enough for budget phones and WebGL builds.' },
];
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: E.title,
    url: absolute(`/engines/${key}/`),
    mainEntity: { '@type': 'ItemList', numberOfItems: list.length, itemListElement: list.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: absolute(`/assets/${a.slug}/`), name: a.title })) },
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: E.title, item: absolute(`/engines/${key}/`) },
    ],
  },
];
---
<Base
  title={`${E.title}: ${list.length} Game-Ready Packs`}
  description={`${list.length} low poly and 3D pixel asset packs (${models}+ models) ready for ${E.name}: cities, cars, SWAT, dungeons and more. One material, commercial license, from $${minPrice.toFixed(2)}.`}
  jsonld={jsonld}
>
  <ListingHero title={`${E.title}.`} crumbs={[{ href: '/', label: 'Home' }, { label: E.title }]}>
    <p>{list.length} packs and {models}+ models with clean low poly meshes, real-world scale and one shared material.</p>
  </ListingHero>
  <div class="container">
    <section class="section--s">
      <div class="pack-grid">{list.map((a, i) => <AssetCard asset={a} eager={i < 4} />)}</div>
    </section>
    <section class="section how">
      <h2>Into {E.name} in a minute.</h2>
      <p class="lead">{E.how}</p>
    </section>
    <section class="section">
      <h2 class="block-head">{E.name} questions.</h2>
      <div class="faq">{faq.map((f) => <details><summary>{f.q}</summary><div class="answer">{f.a}</div></details>)}</div>
      <p class="other">
        Other engines: {(Object.keys(ENGINES) as EngineKey[]).filter((e) => e !== key).map((e, i) => <>{i > 0 && ', '}<a class="link" href={`/engines/${e}/`}>{ENGINES[e].title}</a></>)}
      </p>
    </section>
  </div>
</Base>
<style>
  .block-head { margin-bottom: var(--space-xl); }
  .how { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gap-columns); }
  .how h2 { grid-column: 1 / span 5; text-wrap: balance; }
  .how .lead { grid-column: 6 / span 7; max-width: 60ch; }
  .other { margin-top: var(--space-xl); }
  @media (max-width: 60rem) { .how h2, .how .lead { grid-column: 1 / -1; } }
</style>
