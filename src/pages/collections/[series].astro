---
import Base from '../../layouts/Base.astro';
import AssetCard from '../../components/AssetCard.astro';
import BundleCard from '../../components/BundleCard.astro';
import ListingHero from '../../components/ListingHero.astro';
import { SERIES, seriesOrder, bySeries, bundles, bundleSeries, absolute, type SeriesKey } from '../../data/site';

export function getStaticPaths() {
  return seriesOrder.filter((s) => bySeries(s).length > 0).map((s) => ({ params: { series: s } }));
}
const key = Astro.params.series as SeriesKey;
const S = SERIES[key];
const list = bySeries(key);
const models = list.reduce((n, a) => n + (a.modelCount || 0), 0);
const prices = list.map((a) => a.priceValue).filter((v) => v > 0);
const myBundles = bundles.filter((b) => bundleSeries(b) === key);
const others = seriesOrder.filter((s) => s !== key);
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: S.seoTitle,
    description: S.long,
    url: absolute(`/collections/${key}/`),
    mainEntity: { '@type': 'ItemList', numberOfItems: list.length, itemListElement: list.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: absolute(`/assets/${a.slug}/`), name: a.title })) },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: S.title, item: absolute(`/collections/${key}/`) },
    ],
  },
];
---
<Base
  title={S.seoTitle}
  description={`${list.length} ${S.title.toLowerCase()} with ${models}+ game-ready models for Unity, Godot and Unreal. From $${Math.min(...prices).toFixed(2)}.`}
  image={myBundles[0]?.og || list[0]?.cover.src}
  jsonld={jsonld}
>
  <ListingHero title={`${S.title}.`} crumbs={[{ href: '/', label: 'Home' }, { href: '/assets/', label: 'All packs' }, { label: S.title }]}>
    <p>{list.length} packs, {models}+ models. {S.blurb}</p>
  </ListingHero>
  <div class="container">
    <section class="section--s">
      <div class="pack-grid">{list.map((a, i) => <AssetCard asset={a} eager={i < 4} />)}</div>
    </section>

    {myBundles.length > 0 && (
      <section class="section">
        <h2 class="block-head">All {list.length} in one bundle.</h2>
        {myBundles.map((b) => <BundleCard bundle={b} />)}
      </section>
    )}

    <section class="section about-series">
      <h2>About this collection.</h2>
      <p class="lead">{S.long}</p>
    </section>

    <section class="section">
      <h2 class="block-head">Other collections.</h2>
      <ul class="others">
        {others.map((o) => (
          <li><a href={`/collections/${o}/`}><span>{SERIES[o].title}</span><span class="small">{bySeries(o).length} packs</span></a></li>
        ))}
      </ul>
    </section>
  </div>
</Base>
<style>
  .block-head { margin-bottom: var(--space-xl); }
  .about-series { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gap-columns); }
  .about-series h2 { grid-column: 1 / span 5; text-wrap: balance; }
  .about-series .lead { grid-column: 6 / span 7; max-width: 60ch; }
  .others { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap-columns); }
  .others a { display: grid; gap: var(--space-xs); padding: var(--space-lg); border: var(--rule-bar) solid var(--color-ink); box-shadow: var(--shadow-card); text-decoration: none; background: var(--color-paper); transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out); }
  .others a span:first-child { font: var(--display-weight) var(--text-xl)/1.1 var(--font-display); text-transform: uppercase; letter-spacing: var(--tracking-display); }
  .others a:hover { background: var(--color-ink); color: var(--color-paper); }
  .others a:hover .small { color: var(--color-paper-3); }
  .others a:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  .others a:active { box-shadow: var(--shadow-press); }
  @media (max-width: 60rem) { .about-series h2, .about-series .lead { grid-column: 1 / -1; } .others { grid-template-columns: minmax(0, 1fr); } }
</style>
