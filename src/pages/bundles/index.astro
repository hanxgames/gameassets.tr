---
import Base from '../../layouts/Base.astro';
import BundleCard from '../../components/BundleCard.astro';
import ListingHero from '../../components/ListingHero.astro';
import { bundles, bundleSavings, bundleName, absolute } from '../../data/site';
const maxSave = Math.max(0, ...bundles.map(bundleSavings));
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'HanX Assets bundle deals',
    itemListElement: bundles.map((b, i) => ({ '@type': 'ListItem', position: i + 1, url: absolute(`/bundles/${b.slug}/`), name: bundleName(b) })),
  },
];
---
<Base
  title={`Game Asset Bundles: Save up to ${maxSave}% on Low Poly & 3D Pixel Packs`}
  description={`${bundles.length} game asset bundles: get every low poly, 3D pixel, Halloween or Christmas pack in one checkout and save up to ${maxSave}%. Unity, Godot and Unreal ready.`}
  image={bundles[0]?.og}
  jsonld={jsonld}
>
  <ListingHero title={`Bundles. Save up to ${maxSave}%.`} crumbs={[{ href: '/', label: 'Home' }, { label: 'Bundles' }]}>
    <p>Each bundle is a whole collection in one itch.io checkout, for a fraction of the pack prices.</p>
  </ListingHero>
  <div class="container">
    {bundles.map((b, i) => <BundleCard bundle={b} eager={i === 0} />)}
  </div>
</Base>
