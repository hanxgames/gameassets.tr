---
import Base from '../../layouts/Base.astro';
import AssetCard from '../../components/AssetCard.astro';
import BuyButton from '../../components/BuyButton.astro';
import Countdown from '../../components/Countdown.astro';
import { SITE, SERIES, ENGINES, assets, bundlesFor, bundleName, bundleSavings, assetSeoTitle, assetSeoDescription, absolute, type Asset, type SeriesKey, type EngineKey } from '../../data/site';

export function getStaticPaths() {
  return assets.map((a) => ({ params: { slug: a.slug }, props: { asset: a } }));
}
const { asset: a } = Astro.props as { asset: Asset };
const series = SERIES[a.series as SeriesKey];
const onSale = a.originalPrice && a.originalPriceValue > a.priceValue;
const gallery = [a.cover, ...a.screenshots];
const myBundles = bundlesFor(a);
const theme = a.slug.replace(/^(low-poly|3d-pixel)-/, '').replace(/^(halloween|christmas)-/, '').replace(/-pack$/, '');
const themeOf = (x: Asset) => x.slug.replace(/^(low-poly|3d-pixel)-/, '').replace(/^(halloween|christmas)-/, '').replace(/-pack$/, '');
const related = [
  ...assets.filter((x) => x.slug !== a.slug && themeOf(x) === theme),
  ...assets.filter((x) => x.slug !== a.slug && x.series === a.series && themeOf(x) !== theme),
].slice(0, 4);
const engines = (a.engines as string[]).filter((e) => e in ENGINES) as EngineKey[];
const formats = (a.formats as string[]).filter((f) => f !== 'PNG');
const published = a.published ? new Date(a.published) : null;

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': absolute(`/assets/${a.slug}/#product`),
  name: a.itchTitle,
  description: a.shortDescription,
  sku: String(a.id),
  mpn: `HANX-${a.id}`,
  category: 'Game Assets > 3D Models',
  image: gallery.slice(0, 6).map((g) => absolute(g.src)),
  brand: { '@type': 'Brand', name: SITE.brand },
  manufacturer: { '@id': `${SITE.url}/#org` },
  url: absolute(`/assets/${a.slug}/`),
  keywords: (a.tags as string[]).join(', '),
  offers: {
    '@type': 'Offer',
    url: a.url,
    price: a.priceValue.toFixed(2),
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    priceValidUntil: (a.sale?.ends || new Date(Date.now() + 365 * 864e5).toISOString()).slice(0, 10),
    seller: { '@type': 'Organization', name: SITE.studio, url: SITE.itch },
  },
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
    { '@type': 'ListItem', position: 2, name: series.title, item: absolute(`/collections/${a.series}/`) },
    { '@type': 'ListItem', position: 3, name: a.title, item: absolute(`/assets/${a.slug}/`) },
  ],
};
---
<Base
  title={assetSeoTitle(a)}
  description={assetSeoDescription(a)}
  image={a.cover.src}
  imageAlt={`${a.title} preview`}
  type="product"
  price={{ amount: a.priceValue, currency: 'USD' }}
  jsonld={[productLd, breadcrumb]}
>
  <Fragment slot="head"><link rel="preload" as="image" href={a.cover.src} fetchpriority="high" /></Fragment>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      <a href={`/collections/${a.series}/`}>{series.title}</a><span aria-hidden="true">/</span>
      <span>{a.title}</span>
    </nav>

    <div class="pdp" style={`--accent:${series.accent}`}>
      <!-- Gallery -->
      <section class="gallery" aria-label={`${a.title} screenshots`}>
        <button class="main-shot" id="main-shot" data-index="0" aria-label="Open full-size gallery">
          <img id="main-img" src={a.cover.src} width={a.cover.width} height={a.cover.height} alt={`${a.title} — ${a.shortDescription}`} fetchpriority="high" decoding="async" style={`view-transition-name: cover-${a.slug}`} />
          <span class="zoom pixel">⤢ Zoom</span>
        </button>
        {gallery.length > 1 && (
          <div class="thumbs" role="list">
            {gallery.map((g, i) => (
              <button class={`thumb ${i === 0 ? 'active' : ''}`} role="listitem" data-index={i} data-src={g.src} aria-label={`Show image ${i + 1}`}>
                <img src={g.sm} alt={`${a.title} screenshot ${i + 1}`} loading="lazy" decoding="async" width="160" height="120" />
              </button>
            ))}
          </div>
        )}
      </section>

      <!-- Buy panel -->
      <aside class="buy" aria-label="Purchase">
        <div class="buy-inner">
          <a class="chip" href={`/collections/${a.series}/`}>{series.emoji} {series.title}</a>
          <h1>{a.title}</h1>
          {a.headline && <p class="headline">{a.headline.replace(/^\p{Extended_Pictographic}️?\s*/u, '').replace(a.title, '').replace(/^\s*[—-]\s*/, '') || a.shortDescription}</p>}
          <p class="muted short">{a.shortDescription}</p>

          <div class="price-box">
            <div class="big-price">
              <strong>{a.price}</strong>
              {onSale && <s>{a.originalPrice}</s>}
              {onSale && <span class="badge-sale">-{a.sale?.rate}%</span>}
            </div>
            {onSale && a.sale && <Countdown ends={a.sale.ends} />}
          </div>

          <BuyButton asset={a} size="lg" full label={`Buy now — ${a.price}`} />
          <p class="secure"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4"><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg> Secure checkout by itch.io · Card & PayPal · Instant download</p>

          {myBundles.map((b) => (
            <a class="upsell" href={b.url} target="_blank" rel="noopener">
              <span class="pixel">Bundle deal · save {bundleSavings(b)}%</span>
              <b>Get this + {b.members.length - 1} more packs for {b.bundlePrice}</b>
              <em>{bundleName(b)} →</em>
            </a>
          ))}

          <dl class="specs">
            {a.modelCount && <><dt>Models</dt><dd>{a.modelCount}</dd></>}
            {a.triangles && <><dt>Triangles</dt><dd>{a.triangles.min.toLocaleString('en-US')}–{a.triangles.max.toLocaleString('en-US')} / model</dd></>}
            {formats.length > 0 && <><dt>Formats</dt><dd>{formats.map((f) => (f === 'BLEND' ? '.blend' : f)).join(' · ')}</dd></>}
            {engines.length > 0 && <><dt>Engines</dt><dd>{engines.map((e, i) => <>{i > 0 && ' · '}<a href={`/engines/${e}/`}>{ENGINES[e].name}</a></>)}</dd></>}
            <dt>License</dt><dd><a href="/license/">Commercial, royalty-free</a></dd>
            {published && <><dt>Released</dt><dd><time datetime={a.published}>{published.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time></dd></>}
          </dl>
          <a class="itch-link" href={a.url} target="_blank" rel="noopener">View this pack on itch.io ↗</a>
        </div>
      </aside>
    </div>

    <!-- Description -->
    <div class="details">
      <article class="prose reveal">
        <h2>About the {a.title}</h2>
        <Fragment set:html={a.descriptionHtml} />
      </article>
      <aside class="side reveal">
        <h2 class="side-title">Tags</h2>
        <ul class="tags">{(a.tags as string[]).map((t) => <li><a href={`/assets/?q=${encodeURIComponent(t.replace(/-/g, ' '))}`}>#{t}</a></li>)}</ul>
        <div class="howto">
          <h2 class="side-title">Quick start</h2>
          {engines.slice(0, 3).map((e) => <p><b>{ENGINES[e].name}:</b> {ENGINES[e].how}</p>)}
        </div>
        <BuyButton asset={a} full label={`Get it for ${a.price}`} />
      </aside>
    </div>

    {related.length > 0 && (
      <section class="section" style="padding-top:40px">
        <div class="section-head reveal"><div><span class="eyebrow">Same palette, same grid</span><h2>Works great with</h2></div><a class="btn" href="/assets/">All packs →</a></div>
        <div class="grid">{related.map((r) => <AssetCard asset={r} />)}</div>
      </section>
    )}
  </div>

  <!-- Mobile sticky buy bar -->
  <div class="sticky-buy" id="sticky-buy">
    <div><b>{a.title}</b><span>{a.price}{onSale && <s>{a.originalPrice}</s>}</span></div>
    <BuyButton asset={a} label="Buy now" />
  </div>

  <dialog class="lightbox" id="lightbox" aria-label="Gallery">
    <img id="lb-img" alt={a.title} />
    <button class="lb-btn lb-prev" id="lb-prev" aria-label="Previous image">‹</button>
    <button class="lb-btn lb-next" id="lb-next" aria-label="Next image">›</button>
    <button class="lb-btn lb-close" id="lb-close" aria-label="Close">✕</button>
    <span class="lb-count pixel" id="lb-count"></span>
  </dialog>
  <script is:inline type="application/json" id="gallery-data" set:html={JSON.stringify(gallery.map((g) => g.src))} />
</Base>

<style>
  .pdp { display: grid; grid-template-columns: 1.35fr 1fr; gap: 36px; align-items: start; }
  .gallery { display: grid; gap: 12px; min-width: 0; }
  .main-shot { position: relative; padding: 0; border: 1px solid var(--line); border-radius: 22px; overflow: hidden; background: var(--bg-3); cursor: zoom-in; display: block; width: 100%; }
  .main-shot img { width: 100%; aspect-ratio: 315 / 250; object-fit: cover; transition: opacity 0.25s; }
  .zoom { position: absolute; right: 12px; bottom: 12px; padding: 7px 10px; border-radius: 9px; background: rgba(4, 6, 26, 0.75); font-size: 0.7rem; color: var(--text); }
  .thumbs { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 6px; scrollbar-width: thin; }
  .thumb { flex: none; width: 112px; padding: 0; border: 2px solid transparent; border-radius: 12px; overflow: hidden; cursor: pointer; background: var(--bg-3); opacity: 0.6; transition: opacity 0.2s, border-color 0.2s; }
  .thumb img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .thumb:hover, .thumb.active { opacity: 1; border-color: var(--accent); }

  .buy { position: sticky; top: 88px; }
  .buy-inner { display: grid; gap: 14px; padding: 26px; border-radius: 24px; border: 1px solid var(--line-2); background: radial-gradient(100% 60% at 100% 0%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%), var(--bg-2); box-shadow: var(--shadow); justify-items: start; }
  .buy-inner > :global(.btn) { justify-self: stretch; }
  .buy h1 { font-size: clamp(1.7rem, 3vw, 2.4rem); margin: 4px 0 0; }
  .headline { margin: 0; font-weight: 700; color: var(--accent); }
  .short { margin: 0; }
  .price-box { display: grid; gap: 12px; padding: 14px 0; border-block: 1px solid var(--line); width: 100%; }
  .big-price { display: flex; align-items: baseline; gap: 12px; }
  .big-price strong { font: 900 2.6rem/1 var(--font-display); }
  .big-price s { color: var(--dim); font-size: 1.2rem; }
  .secure { display: flex; align-items: center; gap: 6px; font-size: 0.8rem; color: var(--muted); margin: -4px 0 0; justify-self: center; text-align: center; }
  .upsell { display: grid; gap: 3px; width: 100%; padding: 14px 16px; border-radius: 14px; border: 1px dashed rgba(255, 138, 31, 0.5); background: rgba(255, 138, 31, 0.07); transition: background 0.2s, transform 0.3s var(--ease); }
  .upsell:hover { background: rgba(255, 138, 31, 0.14); transform: translateY(-2px); }
  .upsell span { font-size: 0.68rem; color: var(--orange); }
  .upsell em { font-style: normal; color: var(--muted); font-size: 0.85rem; }
  .specs { display: grid; grid-template-columns: auto 1fr; gap: 8px 18px; margin: 4px 0 0; font-size: 0.9rem; width: 100%; }
  .specs dt { color: var(--dim); font: 400 0.7rem/1.9 var(--font-pixel); text-transform: uppercase; letter-spacing: 0.06em; }
  .specs dd { margin: 0; font-weight: 600; }
  .specs a { color: var(--cyan); }
  .itch-link { font-size: 0.85rem; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }

  .details { display: grid; grid-template-columns: 1.35fr 1fr; gap: 36px; margin-top: 56px; align-items: start; }
  .details .prose { padding: 32px; border-radius: 24px; border: 1px solid var(--line); background: var(--panel); min-width: 0; }
  .details .prose > h2:first-child { margin-top: 0; font-size: 1.6rem; }
  .side { display: grid; gap: 22px; position: sticky; top: 88px; }
  .side-title { font: 400 0.75rem/1 var(--font-pixel); letter-spacing: 0.12em; color: var(--cyan); text-transform: uppercase; margin: 0 0 12px; }
  .tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags a { display: inline-block; padding: 6px 11px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; font-weight: 600; }
  .tags a:hover { color: var(--text); border-color: var(--accent); }
  .howto p { color: var(--muted); font-size: 0.9rem; }
  .howto b { color: var(--text); }

  .sticky-buy { display: none; }
  @media (max-width: 960px) {
    .pdp, .details { grid-template-columns: 1fr; }
    .buy, .side { position: static; }
    .sticky-buy { display: flex; position: fixed; left: 10px; right: 10px; bottom: 10px; z-index: 60; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 10px 10px 16px; border-radius: 18px; background: rgba(8, 11, 43, 0.92); backdrop-filter: blur(14px); border: 1px solid var(--line-2); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6); transform: translateY(140%); transition: transform 0.4s var(--ease); }
    .sticky-buy.show { transform: none; }
    .sticky-buy div { display: grid; min-width: 0; }
    .sticky-buy b { font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sticky-buy span { font-weight: 800; color: var(--green); }
    .sticky-buy s { color: var(--dim); margin-left: 6px; font-weight: 500; }
    .details .prose { padding: 22px; }
  }

  .lightbox { width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(2, 3, 14, 0.94); color: var(--text); }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: rgba(2, 3, 14, 0.8); backdrop-filter: blur(6px); }
  .lightbox img { max-width: 92vw; max-height: 86vh; border-radius: 14px; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.8); }
  .lb-btn { position: fixed; top: 50%; translate: 0 -50%; width: 52px; height: 52px; border-radius: 50%; border: 1px solid var(--line-2); background: rgba(8, 11, 43, 0.8); color: var(--text); font-size: 1.8rem; cursor: pointer; display: grid; place-items: center; }
  .lb-btn:hover { border-color: var(--cyan); }
  .lb-prev { left: 18px; } .lb-next { right: 18px; }
  .lb-close { top: 34px; right: 18px; translate: none; font-size: 1.1rem; }
  .lb-count { position: fixed; bottom: 20px; left: 50%; translate: -50% 0; font-size: 0.75rem; color: var(--muted); }
</style>

<script>
  const srcs: string[] = JSON.parse(document.getElementById('gallery-data')!.textContent || '[]');
  const mainImg = document.getElementById('main-img') as HTMLImageElement;
  const mainBtn = document.getElementById('main-shot') as HTMLButtonElement;
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.thumb')];
  let current = 0;
  const show = (i: number) => {
    current = (i + srcs.length) % srcs.length;
    mainImg.style.opacity = '0.4';
    const pre = new Image();
    pre.onload = () => { mainImg.src = srcs[current]; mainImg.style.opacity = '1'; };
    pre.src = srcs[current];
    thumbs.forEach((t, k) => t.classList.toggle('active', k === current));
    thumbs[current]?.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
  };
  thumbs.forEach((t, i) => { t.addEventListener('click', () => show(i)); t.addEventListener('mouseenter', () => show(i)); });

  const lb = document.getElementById('lightbox') as HTMLDialogElement;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbCount = document.getElementById('lb-count')!;
  const lbShow = (i: number) => { current = (i + srcs.length) % srcs.length; lbImg.src = srcs[current]; lbCount.textContent = `${current + 1} / ${srcs.length}`; };
  mainBtn.addEventListener('click', () => { lbShow(current); lb.showModal(); });
  document.getElementById('lb-prev')!.addEventListener('click', () => lbShow(current - 1));
  document.getElementById('lb-next')!.addEventListener('click', () => lbShow(current + 1));
  document.getElementById('lb-close')!.addEventListener('click', () => lb.close());
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
  lb.addEventListener('close', () => show(current));
  addEventListener('keydown', (e) => {
    if (!lb.open) return;
    if (e.key === 'ArrowLeft') lbShow(current - 1);
    if (e.key === 'ArrowRight') lbShow(current + 1);
  });
  let sx = 0;
  lb.addEventListener('touchstart', (e) => (sx = e.touches[0].clientX), { passive: true });
  lb.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 40) lbShow(current + (dx < 0 ? 1 : -1)); });

  // Mobile sticky buy bar appears once the main buy button scrolls out of view
  const bar = document.getElementById('sticky-buy');
  const mainBuy = document.querySelector('.buy-inner a[data-buy]');
  if (bar && mainBuy) new IntersectionObserver(([e]) => bar.classList.toggle('show', !e.isIntersecting && e.boundingClientRect.top < 0)).observe(mainBuy);
</script>
