---
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../data/market';
import { useT, href, safeJson } from '../i18n';
import en from '../i18n/ui/en.json';
import catalog from '../data/catalog.json';
import { panelHidden } from '../data/site';

interface Props { lang: string }
const { lang } = Astro.props;
const t = useT(lang);
const L = (p: string) => href(lang, p);
const ROLES = ['creator', 'developer', 'both', 'player'];
// Every dashboard string the client script needs, in this page's language.
const keys = Object.keys(en).filter((k) => /^(dash|join|err)\./.test(k));
const strings = Object.fromEntries(keys.map((k) => [k, t(k)]));
const cats = CATEGORIES.map((c) => ({ key: c.key, name: t(`catg.${c.key}.name`) }));
// HanX Games' own packs (every one, hidden included) for the house account's dashboard.
const house = catalog.assets.map((a) => ({ id: a.slug, title: a.title, cover: a.cover.sm, url: a.url, panelHidden: panelHidden.has(a.slug) }));
const cfg = { strings, cats, lang, creatorBase: L('/creators/'), assetBase: L('/assets/'), house };
const terms = `<a class="link" href="${L('/terms/')}">${t('footer.terms')}</a>`;
const privacy = `<a class="link" href="${L('/privacy/')}">${t('footer.privacy')}</a>`;
---
<Base lang={lang} path="/dashboard/" title={t('dash.title')} description={t('join.lead')} noindex>
  <div class="container app" id="app" aria-live="polite">
    <p class="loading" id="loading">{t('dash.loading')}</p>

    <!-- Sign in / sign up -->
    <section class="panel auth" id="v-auth" hidden>
      <h1>{t('join.h1')}</h1>
      <p class="lead">{t('join.lead')}</p>
      <button class="btn btn--primary btn--block" type="button" id="google">{t('join.google')}</button>
      <p class="or small">{t('join.or')}</p>
      <form id="email-form" class="form" novalidate>
        <label>{t('join.email')}<input type="email" name="email" autocomplete="email" required /></label>
        <label>{t('join.password')}<input type="password" name="password" autocomplete="current-password" minlength="6" required /></label>
        <button class="btn btn--block" type="submit" id="email-submit" data-in={t('join.signIn')} data-up={t('join.signUp')}>{t('join.signIn')}</button>
      </form>
      <p class="row small">
        <button class="linkish" type="button" id="toggle-mode" data-in={t('join.toSignUp')} data-up={t('join.toSignIn')}>{t('join.toSignUp')}</button>
        <button class="linkish" type="button" id="forgot">{t('join.forgot')}</button>
      </p>
      <p class="small" set:html={t('join.agree', { terms, privacy })} />
    </section>

    <!-- Who are you? Asked once after the first sign-in. -->
    <section class="panel" id="v-role" hidden>
      <h1>{t('join.role.h1')}</h1>
      <p class="lead">{t('join.role.lead')}</p>
      <form id="role-form" class="form" novalidate>
        <fieldset class="roles">
          <legend>{t('join.role.legend')}</legend>
          {ROLES.map((r) => <label class="choice"><input type="radio" name="role" value={r} required /><span>{t(`join.role.${r}`)}</span></label>)}
        </fieldset>
        <label id="studio-field">{t('join.role.studio')}<input name="studio" maxlength="60" autocomplete="organization" /></label>
        <p class="row">
          <button class="btn btn--primary" type="submit">{t('join.role.continue')}</button>
          <button class="btn" type="button" id="role-back" hidden>{t('join.back')}</button>
        </p>
      </form>
    </section>

    <!-- Signed-in member without a creator profile -->
    <section class="panel" id="v-member" hidden>
      <h1 id="member-hello"></h1>
      <p class="lead">{t('join.member.lead')}</p>
      <p class="small" id="member-role"></p>
      <p class="row">
        <a class="btn btn--primary" href={L('/assets/')}>{t('join.member.browse')}</a>
        <button class="btn" type="button" id="member-sell">{t('join.member.sell')}</button>
      </p>
      <p class="row small">
        <button class="linkish" type="button" id="member-edit">{t('join.member.edit')}</button>
        <button class="linkish" type="button" id="member-out">{t('dash.signOut')}</button>
      </p>
    </section>

    <!-- First profile -->
    <section class="panel" id="v-onboard" hidden>
      <h1>{t('join.profileH2')}</h1>
      <form id="onboard-form" class="form" novalidate>
        <label>{t('join.displayName')}<input name="displayName" maxlength="60" required /></label>
        <label>{t('join.handle')}<input name="handle" maxlength="30" pattern="[a-z0-9][a-z0-9-]{1,28}[a-z0-9]" autocapitalize="off" spellcheck="false" required /><span class="hint small">{t('join.handleHint')}</span></label>
        <p class="row">
          <button class="btn btn--primary" type="submit">{t('join.create')}</button>
          <button class="btn" type="button" id="onboard-back" hidden>{t('join.back')}</button>
        </p>
      </form>
    </section>

    <!-- Dashboard -->
    <div id="v-dash" hidden>
      <header class="dash-head">
        <h1 id="hello"></h1>
        <p class="row">
          <a class="link" id="profile-link" href="#">{t('dash.viewProfile')}</a>
          <button class="btn btn--sm" type="button" id="sign-out">{t('dash.signOut')}</button>
        </p>
      </header>
      <p class="notice" id="status-banner" hidden></p>
      <p class="notice" id="verify-banner" hidden><span id="verify-text"></span> <button class="linkish" type="button" id="resend">{t('dash.resend')}</button></p>

      <section class="panel" id="store">
        <h2>{t('dash.storeH2')}</h2>
        <div id="store-done" hidden><p class="ok" id="store-ok"></p></div>
        <div id="store-todo" hidden>
          <p>{t('dash.storeLead')}</p>
          <form id="code-form" class="form inline" novalidate>
            <label>{t('dash.storeUser')}<input name="storeUser" autocapitalize="off" spellcheck="false" required /></label>
            <button class="btn" type="submit">{t('dash.getCode')}</button>
          </form>
          <div id="code-box" hidden>
            <p class="code" id="code"></p>
            <p>{t('dash.codeSteps')}</p>
            <button class="btn btn--primary" type="button" id="verify">{t('dash.verify')}</button>
          </div>
        </div>
      </section>

      <section class="panel" id="add">
        <h2>{t('dash.addH2')}</h2>
        <p>{t('dash.addLead')}</p>
        <form id="url-form" class="form inline" novalidate>
          <label>{t('dash.packUrl')}<input name="url" type="url" placeholder="https://name.itch.io/pack" required /></label>
          <button class="btn" type="submit">{t('dash.preview')}</button>
        </form>
        <form id="publish-form" class="form preview" hidden novalidate>
          <div class="frame frame--cover"><img id="pv-cover" alt="" referrerpolicy="no-referrer" /></div>
          <div class="pv-fields">
            <p class="small" id="pv-price"></p>
            <label>{t('dash.titleField')}<input name="title" maxlength="80" required /></label>
            <label>{t('dash.categoryField')}<select name="category">{cats.map((c) => <option value={c.key}>{c.name}</option>)}</select></label>
            <label>{t('dash.tagsField')}<input name="tags" maxlength="400" /></label>
            <label>{t('dash.shortField')}<textarea name="short" maxlength="200" rows="3"></textarea></label>
            <p class="row"><button class="btn btn--primary" type="submit">{t('dash.publish')}</button><button class="btn" type="button" id="pv-cancel">{t('dash.cancel')}</button></p>
          </div>
        </form>
      </section>

      <section class="panel stats" id="stats-panel" hidden>
        <div class="st-head">
          <h2>{t('dash.statsH2')}</h2>
          <div class="st-controls">
            <div class="seg" role="group" aria-label={t('dash.rangeLabel')}>
              <button type="button" data-range="7" aria-pressed="true">{t('dash.range7')}</button>
              <button type="button" data-range="30" aria-pressed="false">{t('dash.range30')}</button>
            </div>
            <label class="visually-hidden" for="st-pack">{t('dash.packFilter')}</label>
            <select id="st-pack"><option value="">{t('dash.allPacks')}</option></select>
          </div>
        </div>
        <div class="kpis">
          <button class="kpi" type="button" data-metric="v" aria-pressed="true"><span class="k-label">{t('dash.kViews')}</span><span class="k-num" id="k-v">0</span><span class="k-sub" id="k-v-sub"></span></button>
          <button class="kpi" type="button" data-metric="c" aria-pressed="false"><span class="k-label">{t('dash.kClicks')}</span><span class="k-num" id="k-c">0</span><span class="k-sub" id="k-c-sub"></span></button>
          <div class="kpi"><span class="k-label">{t('dash.kRate')}</span><span class="k-num" id="k-r">0%</span><span class="k-sub" id="k-r-sub"></span></div>
          <div class="kpi"><span class="k-label">{t('dash.kLikes')}</span><span class="k-num" id="k-l">0</span><span class="k-sub" id="k-l-sub"></span></div>
        </div>
        <figure class="chart">
          <figcaption class="small" id="chart-cap"></figcaption>
          <div class="chart-box" id="chart"></div>
          <div class="chart-tip" id="chart-tip" role="status" hidden></div>
          <table class="visually-hidden" id="chart-table"></table>
        </figure>
        <p class="small" id="st-empty" hidden>{t('dash.noData')}</p>
      </section>

      <section class="panel">
        <h2>{t('dash.packsH2')}</h2>
        <p class="small" id="house-note" hidden>{t('dash.houseNote')}</p>
        <p id="no-packs">{t('dash.noPacks')}</p>
        <div class="table-wrap" id="packs-wrap" hidden>
          <table class="packs">
            <thead><tr>
              <th scope="col" aria-sort="none"><button type="button" class="sort" data-sort="title">{t('dash.colPack')}</button></th>
              <th scope="col" aria-sort="descending"><button type="button" class="sort" data-sort="v">{t('dash.kViews')}</button></th>
              <th scope="col">{t('dash.colTrend')}</th>
              <th scope="col" aria-sort="none"><button type="button" class="sort" data-sort="c">{t('dash.kClicks')}</button></th>
              <th scope="col" aria-sort="none"><button type="button" class="sort" data-sort="r">{t('dash.colRate')}</button></th>
              <th scope="col" aria-sort="none"><button type="button" class="sort" data-sort="l">{t('dash.colLikes')}</button></th>
              <th scope="col">{t('dash.colStatus')}</th>
              <th scope="col"><span class="visually-hidden">{t('dash.edit')}</span></th>
            </tr></thead>
            <tbody id="packs"></tbody>
          </table>
        </div>
      </section>

      <section class="panel" id="profile-panel">
        <h2>{t('dash.profileH2')}</h2>
        <form id="profile-form" class="form" novalidate>
          <label>{t('join.displayName')}<input name="displayName" maxlength="60" required /></label>
          <label>{t('dash.bio')}<textarea name="bio" maxlength="600" rows="4"></textarea></label>
          <label>{t('dash.website')}<input name="website" type="url" maxlength="200" placeholder="https://" /></label>
          <label>{t('dash.twitter')}<input name="twitter" maxlength="40" placeholder="@" /></label>
          <button class="btn" type="submit">{t('dash.saveProfile')}</button>
        </form>
      </section>
    </div>

    <p class="toast" id="toast" role="status" hidden></p>
  </div>
  <script is:inline type="application/json" id="dash-cfg" set:html={safeJson(cfg)} />
</Base>

<style>
  .app { padding-block: var(--space-2xl) var(--section-gap); display: grid; gap: var(--space-2xl); max-width: 76rem; }
  .loading { font-size: var(--text-lead); }
  .panel { display: grid; gap: var(--space-md); padding: var(--space-xl); border: var(--rule-bar) solid var(--color-ink); box-shadow: var(--shadow-card); background: var(--color-paper); }
  .panel h2 { font-size: var(--text-title); }
  .auth { max-width: 30rem; }
  .or { text-align: center; }
  .roles { display: grid; gap: var(--space-sm); margin: 0; padding: 0; border: 0; min-width: 0; }
  .roles legend { padding: 0; margin-bottom: var(--space-xs); font-weight: 500; }
  .form .choice { display: flex; gap: var(--space-sm); align-items: center; min-height: 48px; padding: var(--space-xs) var(--space-md); border: var(--rule-bar) solid var(--color-ink); background: var(--color-paper); font-size: var(--text-md); font-weight: 400; cursor: pointer; transition: background-color var(--dur-micro) var(--ease-out); }
  .form .choice:hover { background: var(--color-paper-2); }
  .form .choice:has(input:checked) { background: var(--color-accent); color: var(--color-accent-ink); font-weight: 500; }
  .form .choice:has(input:focus-visible) { outline: 3px solid var(--color-focus); outline-offset: 0; }
  .form .choice input { width: 20px; height: 20px; min-height: 0; margin: 0; padding: 0; flex: none; accent-color: var(--color-ink); }
  #v-role, #v-member, #v-onboard { max-width: 36rem; }
  #member-hello { overflow-wrap: break-word; min-width: 0; }
  .form { display: grid; gap: var(--space-md); }
  .form.inline { grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
  .form label { display: grid; gap: var(--space-2xs); font-size: var(--text-sm); font-weight: 500; }
  .form input, .form select, .form textarea { width: 100%; min-height: 48px; padding: var(--space-xs) var(--space-md); border: var(--rule-bar) solid var(--color-ink); background: var(--color-paper); color: var(--color-ink); font: inherit; font-size: var(--text-md); font-weight: 400; }
  .form textarea { resize: vertical; }
  .form :is(input, select, textarea):focus-visible { outline: 3px solid var(--color-focus); outline-offset: 0; }
  .hint { color: var(--color-muted); font-weight: 400; }
  .row { display: flex; flex-wrap: wrap; gap: var(--space-md); align-items: center; }
  .linkish { padding: 0; border: 0; background: none; color: var(--color-ink); font: inherit; text-decoration: underline; text-decoration-color: var(--color-accent-2); text-decoration-thickness: 2px; cursor: pointer; }
  .linkish:hover { color: var(--color-accent-2); }
  .linkish:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .dash-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-md); }
  .dash-head h1 { font-size: var(--text-display); overflow-wrap: break-word; min-width: 0; }
  .notice { padding: var(--space-md); border: var(--rule-bar) solid var(--color-ink); background: var(--color-accent-2); color: var(--color-on-accent-2); font-weight: 500; }
  .notice .linkish { color: inherit; }
  .ok { font-weight: 500; }
  .ok::before { content: '✓ '; color: var(--color-accent-2); }
  .code { font: var(--display-weight) var(--text-price)/1 var(--font-display); letter-spacing: 0.04em; padding: var(--space-sm) var(--space-md); background: var(--color-accent); color: var(--color-accent-ink); border: var(--rule-bar) solid var(--color-ink); justify-self: start; user-select: all; }
  #code-box { display: grid; gap: var(--space-md); justify-items: start; }
  .preview { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; gap: var(--space-xl); padding-top: var(--space-md); border-top: var(--rule-bar) solid var(--color-ink); }
  .pv-fields { display: grid; gap: var(--space-md); }
  .packs { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  .packs :global(th), .packs :global(td) { text-align: left; padding: var(--space-sm) var(--space-xs); border-bottom: var(--rule-hair) solid var(--color-ink); vertical-align: top; }
  .packs th { font-weight: 500; color: var(--color-muted); }
  .packs :global(td.num) { font-variant-numeric: tabular-nums; }
  .packs :global(.pk) { display: flex; gap: var(--space-sm); align-items: center; min-width: 0; }
  .packs :global(.pk > div) { min-width: 0; overflow-wrap: anywhere; }
  .packs :global(.pk img) { width: 64px; aspect-ratio: 315 / 250; object-fit: cover; border: var(--rule-hair) solid var(--color-ink); }
  /* Desktop: actions stack in one narrow column so the table never needs a sideways scroll. */
  .packs :global(.acts) { display: grid; gap: var(--space-2xs); justify-items: stretch; }
  .packs :global(.acts .btn) { justify-content: center; padding-inline: var(--space-xs); }
  .packs th { white-space: normal; }
  .packs :global(.edit-row td) { background: var(--color-paper-2); }
  .packs th .sort { padding: 0; border: 0; background: none; color: inherit; font: inherit; cursor: pointer; text-align: left; }
  .packs th .sort:hover { color: var(--color-ink); text-decoration: underline; }
  .packs th .sort:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .packs th[aria-sort='descending'] .sort::after { content: ' ↓'; }
  .packs th[aria-sort='ascending'] .sort::after { content: ' ↑'; }
  .packs :global(tr.is-picked td) { background: var(--color-paper-2); }
  .packs :global(.pick-btn) { padding: 0; border: 0; background: none; color: var(--color-ink); font: inherit; font-weight: 500; text-align: left; cursor: pointer; text-decoration: underline; text-decoration-color: var(--color-accent-2); text-decoration-thickness: 2px; }
  .packs :global(.pick-btn:hover) { color: var(--color-accent-2); }
  .packs :global(.pick-btn:focus-visible) { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .packs :global(.spark) { display: block; width: 72px; height: 28px; color: var(--color-accent-2); }
  .packs :global(.muted) { color: var(--color-muted); }
  .st-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-md); }
  .st-controls { display: flex; flex-wrap: wrap; gap: var(--space-sm); align-items: center; }
  .seg { display: inline-flex; border: var(--rule-bar) solid var(--color-ink); }
  .seg button { min-height: 40px; padding: 0 var(--space-md); border: 0; background: var(--color-paper); color: var(--color-ink); font: 500 var(--text-sm)/1 var(--font-body); cursor: pointer; transition: background-color var(--dur-micro) var(--ease-out); }
  .seg button + button { border-left: var(--rule-bar) solid var(--color-ink); }
  .seg button[aria-pressed='true'] { background: var(--color-ink); color: var(--color-paper); }
  .seg button:hover:not([aria-pressed='true']) { background: var(--color-paper-2); }
  .seg button:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  #st-pack { min-height: 40px; max-width: 18rem; padding: 0 var(--space-sm); border: var(--rule-bar) solid var(--color-ink); background: var(--color-paper); color: var(--color-ink); font: inherit; font-size: var(--text-sm); }
  #st-pack:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 0; }
  .kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-sm); }
  .kpi { display: grid; gap: var(--space-2xs); align-content: start; padding: var(--space-md); border: var(--rule-bar) solid var(--color-ink); background: var(--color-paper); color: var(--color-ink); font: inherit; text-align: left; min-width: 0; }
  button.kpi { cursor: pointer; transition: background-color var(--dur-micro) var(--ease-out), box-shadow var(--dur-micro) var(--ease-out); }
  button.kpi:hover { background: var(--color-paper-2); }
  button.kpi[aria-pressed='true'] { box-shadow: inset 0 -6px 0 var(--color-accent-2); }
  button.kpi:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .k-label { font-size: var(--text-sm); font-weight: 500; color: var(--color-muted); }
  .k-num { font: var(--display-weight) clamp(1.75rem, 3vw, 2.5rem)/1 var(--font-display); white-space: nowrap; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .k-sub { font-size: var(--text-xs); color: var(--color-muted); min-height: 1.2em; }
  .k-sub.up { color: var(--color-ink); font-weight: 500; }
  .chart { position: relative; margin: 0; display: grid; gap: var(--space-xs); }
  .chart-box { position: relative; height: 220px; }
  .chart-box :global(svg) { display: block; width: 100%; height: 100%; overflow: visible; }
  .chart-box :global(.grid line) { stroke: var(--color-ink); stroke-opacity: 0.12; }
  .chart-box :global(.axis text) { fill: var(--color-muted); font-size: 11px; font-variant-numeric: tabular-nums; }
  .chart-box :global(.bar) { fill: var(--color-accent-2); }
  .chart-box :global(.bar.on) { fill: var(--color-ink); }
  .chart-box :global(.hit) { fill: transparent; cursor: default; }
  .chart-tip { position: absolute; z-index: var(--z-raised); pointer-events: none; padding: var(--space-2xs) var(--space-sm); background: var(--color-ink); color: var(--color-paper); font-size: var(--text-xs); white-space: nowrap; translate: -50% -100%; }
  /* Phones: each pack becomes a card with its numbers in a 2 x 2 grid. */
  @media (max-width: 64rem) {
    .packs thead { display: none; }
    .packs :global(tbody tr:not(.edit-row)) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-xs) var(--space-sm); padding-block: var(--space-md); border-bottom: var(--rule-hair) solid var(--color-ink); }
    .packs :global(tbody td) { padding: 0; border: 0; min-width: 0; }
    .packs :global(td:first-child), .packs :global(td.state), .packs :global(td.act) { grid-column: 1 / -1; }
    .packs :global(td.trend) { display: none; }
    .packs :global(td[data-label])::before { content: attr(data-label); display: block; font-size: var(--text-xs); color: var(--color-muted); }
    .packs :global(td.state) { font-size: var(--text-sm); }
    .packs :global(.acts) { flex-wrap: wrap; }
    .packs :global(.pk) { min-width: 0; }
  }
  @media (max-width: 50rem) { .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } .chart-box { height: 180px; } }
  .toast { position: fixed; left: 50%; bottom: var(--space-xl); translate: -50% 0; z-index: var(--z-sticky); max-width: min(36rem, calc(100% - 2 * var(--gutter))); padding: var(--space-sm) var(--space-lg); background: var(--color-ink); color: var(--color-paper); border: var(--rule-bar) solid var(--color-ink); box-shadow: var(--shadow-card); }
  @media (max-width: 40rem) { .form.inline, .preview { grid-template-columns: minmax(0, 1fr); } .panel { padding: var(--space-lg); } }
</style>

<script>
  import { initializeApp } from 'firebase/app';
  import {
    connectAuthEmulator, getAuth, onAuthStateChanged, GoogleAuthProvider, signInWithPopup, signInWithEmailAndPassword,
    createUserWithEmailAndPassword, sendEmailVerification, sendPasswordResetEmail, signOut, type User,
  } from 'firebase/auth';
  import { connectFirestoreEmulator, getFirestore, doc, onSnapshot, collection, query, where, getDoc, setDoc, updateDoc, deleteDoc, serverTimestamp } from 'firebase/firestore';
  import { connectFunctionsEmulator, getFunctions, httpsCallable } from 'firebase/functions';
  import { FIREBASE, FUNCTIONS_REGION } from '../data/firebase.config.mjs';

  const cfg = JSON.parse(document.getElementById('dash-cfg')!.textContent || '{}');
  const S = cfg.strings as Record<string, string>;
  const tr = (k: string, v: Record<string, string | number> = {}) => (S[k] ?? k).replace(/\{(\w+)\}/g, (m, x) => (x in v ? String(v[x]) : m));
  const app = initializeApp(FIREBASE);
  const auth = getAuth(app);
  auth.languageCode = cfg.lang;
  const db = getFirestore(app);
  const fns = getFunctions(app, FUNCTIONS_REGION);
  // Local testing against the Firebase emulators: open /dashboard/?emu on localhost.
  if (location.hostname === 'localhost' && (location.search.includes('emu') || sessionStorage.getItem('ga_emu'))) {
    sessionStorage.setItem('ga_emu', '1');
    connectAuthEmulator(auth, 'http://127.0.0.1:9099', { disableWarnings: true });
    connectFirestoreEmulator(db, '127.0.0.1', 8080);
    connectFunctionsEmulator(fns, '127.0.0.1', 5001);
  }
  const call = async (name: string, data: unknown) => {
    // A freshly confirmed e-mail only reaches the server after the ID token is refreshed.
    const u = auth.currentUser;
    if (u) {
      await u.reload().catch(() => {});
      const tok = await u.getIdTokenResult();
      if (u.emailVerified && tok.claims.email_verified !== true) await u.getIdToken(true);
    }
    return httpsCallable(fns, name)(data).then((r) => r.data as any);
  };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const show = (id: string, on = true) => { $(id).hidden = !on; };
  let toastTimer = 0;
  const toast = (msg: string) => { const el = $('toast'); el.textContent = msg; el.hidden = false; clearTimeout(toastTimer); toastTimer = window.setTimeout(() => (el.hidden = true), 5000); };
  const fail = (e: any) => {
    const code = String(e?.message || e?.code || '').replace(/^auth\//, '').replace(/\s*\[\d+\]\s*$/, '').trim();
    const k = S[`err.${code}`] ? `err.${code}` : /auth\//.test(String(e?.code)) ? 'err.auth' : '';
    toast(k ? tr(k) : tr('dash.error', { msg: code || 'unknown' }));
  };
  const busy = async (btn: HTMLButtonElement | null, fn: () => Promise<void>) => {
    if (btn) btn.disabled = true;
    try { await fn(); } catch (e) { fail(e); } finally { if (btn) btn.disabled = false; }
  };
  const el = (tag: string, attrs: Record<string, string> = {}, ...kids: (Node | string)[]) => {
    const n = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, v);
    for (const c of kids) n.append(c);
    return n;
  };

  // ---------- auth ----------
  let signUp = false;
  const setMode = () => {
    const b = $<HTMLButtonElement>('email-submit');
    b.textContent = signUp ? b.dataset.up! : b.dataset.in!;
    const tgl = $('toggle-mode');
    tgl.textContent = signUp ? tgl.dataset.up! : tgl.dataset.in!;
    ($('email-form').querySelector('[name=password]') as HTMLInputElement).autocomplete = signUp ? 'new-password' : 'current-password';
  };
  $('toggle-mode').addEventListener('click', () => { signUp = !signUp; setMode(); });
  $('google').addEventListener('click', (e) => busy(e.currentTarget as HTMLButtonElement, async () => { await signInWithPopup(auth, new GoogleAuthProvider()); }));
  $('email-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(e.currentTarget as HTMLFormElement);
    const email = String(f.get('email')).trim(), pw = String(f.get('password'));
    busy($('email-submit') as HTMLButtonElement, async () => {
      if (signUp) {
        const cred = await createUserWithEmailAndPassword(auth, email, pw);
        await sendEmailVerification(cred.user).catch(() => {});
      } else await signInWithEmailAndPassword(auth, email, pw);
    });
  });
  $('forgot').addEventListener('click', () => {
    const email = ($('email-form').querySelector('[name=email]') as HTMLInputElement).value.trim();
    if (!email) return ($('email-form').querySelector('[name=email]') as HTMLInputElement).focus();
    busy(null, async () => { await sendPasswordResetEmail(auth, email); toast(tr('join.resetSent')); });
  });
  $('sign-out').addEventListener('click', () => signOut(auth));
  $('resend').addEventListener('click', (e) => busy(e.currentTarget as HTMLButtonElement, async () => { if (auth.currentUser) await sendEmailVerification(auth.currentUser); toast(tr('dash.saved')); }));

  // ---------- who are you ----------
  let account: any = undefined; // users/{uid}: role and studio; null when not asked yet
  let creatorDoc: any = undefined; // creators/{uid}; null when there is no creator profile
  let editingRole = false;
  let wantCreator = false;
  const roleForm = $<HTMLFormElement>('role-form');
  const studioField = $('studio-field');
  const syncStudio = () => {
    const r = (roleForm.elements.namedItem('role') as RadioNodeList).value;
    studioField.hidden = r === 'player';
  };
  roleForm.addEventListener('change', syncStudio);
  roleForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const user = auth.currentUser;
    const role = (roleForm.elements.namedItem('role') as RadioNodeList).value;
    if (!user) return;
    if (!role) return (roleForm.querySelector('input[name=role]') as HTMLInputElement).focus();
    const studio = role === 'player' ? '' : String((roleForm.elements.namedItem('studio') as HTMLInputElement).value).trim().slice(0, 60);
    busy(roleForm.querySelector('button[type=submit]'), async () => {
      const data: Record<string, unknown> = { role, studio, updatedAt: serverTimestamp() };
      if (!account) data.createdAt = serverTimestamp();
      await setDoc(doc(db, 'users', user.uid), data, { merge: true });
      editingRole = false;
      wantCreator = role === 'creator' || role === 'both';
      if (wantCreator && studio && !nameInput.value) { nameInput.value = studio; nameInput.dispatchEvent(new Event('input')); }
    });
  });
  $('role-back').addEventListener('click', () => { editingRole = false; decide(); });
  $('member-edit').addEventListener('click', () => { editingRole = true; decide(); });
  $('member-sell').addEventListener('click', () => {
    wantCreator = true;
    if (account?.studio && !nameInput.value) { nameInput.value = account.studio; nameInput.dispatchEvent(new Event('input')); }
    decide();
  });
  $('onboard-back').addEventListener('click', () => { wantCreator = false; decide(); });
  $('member-out').addEventListener('click', () => signOut(auth));

  function decide() {
    const user = auth.currentUser;
    if (!user || account === undefined || creatorDoc === undefined) return;
    if (creatorDoc) return view('dash');
    if (!account || editingRole) {
      if (account) {
        for (const r of roleForm.querySelectorAll<HTMLInputElement>('input[name=role]')) r.checked = r.value === account.role;
        (roleForm.elements.namedItem('studio') as HTMLInputElement).value = account.studio || '';
      }
      $('role-back').hidden = !account;
      syncStudio();
      return view('role');
    }
    const sells = account.role === 'creator' || account.role === 'both';
    if (sells || wantCreator) {
      $('onboard-back').hidden = sells;
      return view('onboard');
    }
    const name = account.studio || user.displayName || (user.email || '').split('@')[0];
    $('member-hello').textContent = tr('dash.h1', { name });
    const role = tr(`join.role.short.${account.role}`);
    $('member-role').textContent = tr('join.member.you', { role: account.studio ? `${role}, ${account.studio}` : role });
    view('member');
  }

  // ---------- onboarding ----------
  $('onboard-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const f = new FormData(form);
    busy(form.querySelector('button'), async () => {
      await call('createProfile', { handle: String(f.get('handle')).trim().toLowerCase(), displayName: String(f.get('displayName')).trim() });
    });
  });
  const handleInput = $('onboard-form').querySelector('[name=handle]') as HTMLInputElement;
  const nameInput = $('onboard-form').querySelector('[name=displayName]') as HTMLInputElement;
  nameInput.addEventListener('input', () => {
    if (handleInput.dataset.touched) return;
    handleInput.value = nameInput.value.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/ı/g, 'i').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 30);
  });
  handleInput.addEventListener('input', () => (handleInput.dataset.touched = '1'));

  // ---------- store verification ----------
  $('code-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const user = String(new FormData(form).get('storeUser')).trim();
    busy(form.querySelector('button'), async () => {
      const r = await call('startVerify', { storeUser: user });
      $('code').textContent = r.code;
      $('code-box').dataset.user = r.storeUser;
      show('code-box');
    });
  });
  $('verify').addEventListener('click', (e) => busy(e.currentTarget as HTMLButtonElement, async () => {
    const r = await call('checkVerify', {});
    if (!r.verified) toast(tr('dash.notFound', { url: `${$('code-box').dataset.user}.itch.io` }));
  }));

  // ---------- add a pack ----------
  let previewUrl = '';
  $('url-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    previewUrl = String(new FormData(form).get('url')).trim();
    busy(form.querySelector('button'), async () => {
      const p = await call('previewPack', { url: previewUrl });
      const pf = $<HTMLFormElement>('publish-form');
      ($('pv-cover') as HTMLImageElement).src = p.cover?.sm || p.cover?.src || '';
      $('pv-price').textContent = p.free ? '' : p.price;
      (pf.elements.namedItem('title') as HTMLInputElement).value = String(p.title || '').replace(/\s*[-–|]\s*[^-–|]*assets?\s*$/i, '').trim() || p.title;
      (pf.elements.namedItem('category') as HTMLSelectElement).value = p.suggestedCategory || '3d';
      (pf.elements.namedItem('tags') as HTMLInputElement).value = (p.tags || []).join(', ');
      (pf.elements.namedItem('short') as HTMLTextAreaElement).value = p.short || '';
      pf.hidden = false;
      (pf.elements.namedItem('title') as HTMLInputElement).focus();
    });
  });
  $('pv-cancel').addEventListener('click', () => { $('publish-form').hidden = true; });
  $('publish-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const f = new FormData(form);
    busy(form.querySelector('button[type=submit]'), async () => {
      await call('publishPack', { url: previewUrl, title: f.get('title'), category: f.get('category'), tags: f.get('tags'), short: f.get('short') });
      form.hidden = true;
      ($('url-form') as HTMLFormElement).reset();
      toast(tr('dash.published'));
    });
  });

  // ---------- profile ----------
  $('profile-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const f = new FormData(form);
    busy(form.querySelector('button'), async () => {
      await updateDoc(doc(db, 'creators', auth.currentUser!.uid), {
        displayName: String(f.get('displayName')).trim(),
        bio: String(f.get('bio')).trim(),
        website: String(f.get('website')).trim(),
        twitter: String(f.get('twitter')).trim().replace(/^@/, ''),
        updatedAt: serverTimestamp(),
      });
      toast(tr('dash.saved'));
    });
  });

  // ---------- packs and stats ----------
  const catName = (k: string) => (cfg.cats as { key: string; name: string }[]).find((c) => c.key === k)?.name ?? k;
  const nf = new Intl.NumberFormat(cfg.lang);
  const pf = new Intl.NumberFormat(cfg.lang, { style: 'percent', maximumFractionDigits: 1 });
  const DAY = 864e5;
  type Raw = { v?: number; c?: number; l?: number; dl?: number; d?: Record<string, { v?: number; c?: number }> };
  type Row = { id: string; title: string; cover: string; sub: string; status: string; actions: (box: HTMLElement, row: HTMLElement) => void; s: Raw };
  const statCache = new Map<string, Promise<Raw>>();
  const stat = (id: string) => {
    if (!statCache.has(id)) statCache.set(id, getDoc(doc(db, 'stats', id)).then((s) => (s.data() as Raw) || {}).catch(() => ({})));
    return statCache.get(id)!;
  };
  let rows: Row[] = [];
  let range = 7;
  let metric: 'v' | 'c' = 'v';
  let picked = '';
  let sortKey = 'v';
  let sortDir = -1;
  const today = () => Math.floor(Date.now() / DAY);
  /** Sum of one counter over the days (end - n, end]. */
  const sumDays = (s: Raw, key: 'v' | 'c', n: number, end = today()) =>
    Object.entries(s.d || {}).reduce((t, [k, x]) => (Number(k) > end - n && Number(k) <= end ? t + (x?.[key] || 0) : t), 0);
  const daily = (list: Row[], key: 'v' | 'c', n: number) => {
    const end = today();
    return Array.from({ length: n }, (_, i) => {
      const day = end - n + 1 + i;
      return { day, n: list.reduce((t, r) => t + (r.s.d?.[String(day)]?.[key] || 0), 0) };
    });
  };
  const rate = (c: number, v: number) => (v > 0 ? c / v : 0);
  const fmtDay = (day: number, opts: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'short' }) => new Date(day * DAY).toLocaleDateString(cfg.lang, { ...opts, timeZone: 'UTC' });

  function setRows(next: Row[]) {
    rows = next;
    show('no-packs', rows.length === 0);
    show('packs-wrap', rows.length > 0);
    show('stats-panel', rows.length > 0);
    const sel = $<HTMLSelectElement>('st-pack');
    const keep = picked;
    sel.replaceChildren(el('option', { value: '' }, tr('dash.allPacks')), ...rows.map((r) => el('option', { value: r.id }, r.title)));
    picked = rows.some((r) => r.id === keep) ? keep : '';
    sel.value = picked;
    Promise.all(rows.map(async (r) => { r.s = await stat(r.id); })).then(renderStats);
    renderStats();
  }

  function renderStats() {
    const sel = picked ? rows.filter((r) => r.id === picked) : rows;
    const tot = (k: 'v' | 'c') => sel.reduce((t, r) => t + (r.s[k] || 0), 0);
    const cur = (k: 'v' | 'c') => sel.reduce((t, r) => t + sumDays(r.s, k, range), 0);
    const prev = (k: 'v' | 'c') => sel.reduce((t, r) => t + sumDays(r.s, k, range, today() - range), 0);
    const change = (k: 'v' | 'c') => {
      if (range !== 7) return { text: tr('dash.allTime', { n: nf.format(tot(k)) }), up: false };
      const a = cur(k), b = prev(k);
      if (!a && !b) return { text: tr('dash.allTime', { n: nf.format(tot(k)) }), up: false };
      if (!b) return { text: tr('dash.newData'), up: true };
      const d = (a - b) / b;
      if (Math.abs(d) < 0.005) return { text: tr('dash.noChange'), up: false };
      return { text: tr('dash.vsPrev', { d: `${d > 0 ? '+' : '−'}${pf.format(Math.abs(d))}` }), up: d > 0 };
    };
    for (const k of ['v', 'c'] as const) {
      $(`k-${k}`).textContent = nf.format(cur(k));
      const ch = change(k);
      const sub = $(`k-${k}-sub`);
      sub.textContent = ch.text;
      sub.classList.toggle('up', ch.up);
    }
    $('k-r').textContent = pf.format(rate(cur('c'), cur('v')));
    $('k-r-sub').textContent = tr('dash.allTime', { n: pf.format(rate(tot('c'), tot('v'))) });
    const likes = sel.reduce((t, r) => t + (r.s.l || 0), 0), dislikes = sel.reduce((t, r) => t + (r.s.dl || 0), 0);
    $('k-l').textContent = nf.format(likes);
    $('k-l-sub').textContent = tr('dash.dislikes', { n: nf.format(dislikes) });
    for (const b of document.querySelectorAll<HTMLButtonElement>('.kpi[data-metric]')) b.setAttribute('aria-pressed', String(b.dataset.metric === metric));
    for (const b of document.querySelectorAll<HTMLButtonElement>('.seg [data-range]')) b.setAttribute('aria-pressed', String(Number(b.dataset.range) === range));
    const data = daily(sel, metric, range);
    const name = picked ? sel[0]?.title || '' : tr('dash.allPacks');
    $('chart-cap').textContent = `${tr(metric === 'v' ? 'dash.chartViews' : 'dash.chartClicks', { n: range })}: ${name}`;
    show('st-empty', rows.length > 0 && data.every((x) => !x.n) && !tot('v'));
    drawChart(data);
    renderTable();
  }

  // Single-series daily bar chart: thin bars from a zero baseline, recessive grid, per-bar hover tooltip.
  function drawChart(data: { day: number; n: number }[]) {
    const box = $('chart');
    const W = Math.max(box.clientWidth, 280), H = box.clientHeight || 220;
    const padL = 36, padR = 4, padT = 8, padB = 22;
    const max = Math.max(...data.map((d) => d.n), 0);
    // Nice round top: the half-way tick lands on 1, 1.2, 1.5, 2, 2.5, 3, 4, 5, 6 or 8 x 10^k.
    const half = Math.max(max / 2, 1);
    const mag = Math.pow(10, Math.floor(Math.log10(half)));
    const top = Math.max(2, 2 * Math.ceil(mag * ([1, 1.2, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10].find((m) => m * mag >= half) || 10)));
    const ticks = [0, top / 2, top];
    const iw = W - padL - padR, ih = H - padT - padB;
    const band = iw / data.length;
    const bw = Math.max(2, Math.min(28, band - Math.max(2, band * 0.3)));
    const y = (v: number) => padT + ih - (v / top) * ih;
    const NS = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(NS, 'svg');
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    svg.setAttribute('role', 'img');
    svg.setAttribute('aria-label', $('chart-cap').textContent || '');
    const g = (cls: string) => { const n = document.createElementNS(NS, 'g'); n.setAttribute('class', cls); svg.append(n); return n; };
    const grid = g('grid'), axis = g('axis axis-y'), xa = g('axis axis-x'), bars = g('bars'), hits = g('hits');
    for (const v of ticks) {
      const ln = document.createElementNS(NS, 'line');
      ln.setAttribute('x1', String(padL)); ln.setAttribute('x2', String(W - padR));
      ln.setAttribute('y1', String(y(v))); ln.setAttribute('y2', String(y(v)));
      grid.append(ln);
      const tx = document.createElementNS(NS, 'text');
      tx.setAttribute('x', String(padL - 6)); tx.setAttribute('y', String(y(v) + 4)); tx.setAttribute('text-anchor', 'end');
      tx.textContent = nf.format(v);
      axis.append(tx);
    }
    const every = data.length <= 7 ? 1 : Math.ceil(data.length / 6);
    const tip = $('chart-tip');
    data.forEach((d, i) => {
      const cx = padL + band * i + band / 2;
      if (d.n > 0) {
        const h = Math.max(1, y(0) - y(d.n)), x = cx - bw / 2, r = Math.min(4, bw / 2, h);
        const p = document.createElementNS(NS, 'path');
        p.setAttribute('class', 'bar');
        p.setAttribute('d', `M${x},${y(0)} V${y(0) - h + r} Q${x},${y(0) - h} ${x + r},${y(0) - h} H${x + bw - r} Q${x + bw},${y(0) - h} ${x + bw},${y(0) - h + r} V${y(0)} Z`);
        p.dataset.i = String(i);
        bars.append(p);
      }
      if ((data.length - 1 - i) % every === 0) {
        const tx = document.createElementNS(NS, 'text');
        tx.setAttribute('x', String(cx)); tx.setAttribute('y', String(H - 6)); tx.setAttribute('text-anchor', 'middle');
        tx.textContent = fmtDay(d.day);
        xa.append(tx);
      }
      const hit = document.createElementNS(NS, 'rect');
      hit.setAttribute('class', 'hit');
      hit.setAttribute('x', String(padL + band * i)); hit.setAttribute('y', String(padT));
      hit.setAttribute('width', String(band)); hit.setAttribute('height', String(ih));
      const on = () => {
        bars.querySelectorAll('.bar').forEach((b) => b.classList.toggle('on', (b as SVGElement).dataset.i === String(i)));
        tip.textContent = tr('dash.tip', { date: fmtDay(d.day, { weekday: 'short', day: 'numeric', month: 'short' }), n: nf.format(d.n) });
        tip.style.left = `${(cx / W) * 100}%`;
        tip.style.top = `${Math.max(y(d.n) - 6, 14)}px`;
        tip.hidden = false;
      };
      hit.addEventListener('mouseenter', on);
      hit.addEventListener('touchstart', on, { passive: true });
      hit.addEventListener('mouseleave', () => { tip.hidden = true; bars.querySelectorAll('.bar').forEach((b) => b.classList.remove('on')); });
      hits.append(hit);
    });
    box.replaceChildren(svg);
    // Screen readers get the same numbers as a table.
    const t = $('chart-table');
    t.replaceChildren(el('caption', {}, $('chart-cap').textContent || ''), ...data.map((d) => el('tr', {}, el('th', { scope: 'row' }, fmtDay(d.day)), el('td', {}, nf.format(d.n)))));
  }
  new ResizeObserver(() => { if (rows.length && !$('stats-panel').hidden) renderStats(); }).observe($('chart'));

  function spark(s: Raw) {
    const vals = Array.from({ length: range }, (_, i) => s.d?.[String(today() - range + 1 + i)]?.v || 0);
    const max = Math.max(...vals, 1);
    const pts = vals.map((v, i) => `${((i / (vals.length - 1)) * 94 + 1).toFixed(1)},${(26 - (v / max) * 24).toFixed(1)}`).join(' ');
    const wrap = document.createElement('span');
    wrap.innerHTML = `<svg class="spark" viewBox="0 0 96 28" aria-hidden="true" focusable="false"><polyline points="${pts}" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></svg>`;
    return wrap.firstElementChild!;
  }

  function renderTable() {
    const body = $('packs');
    body.replaceChildren();
    const val = (r: Row) => {
      const v = sumDays(r.s, 'v', range), c = sumDays(r.s, 'c', range);
      return { v, c, r: rate(c, v), l: r.s.l || 0 };
    };
    const sorted = [...rows].sort((a, b) => {
      if (sortKey === 'title') return sortDir * a.title.localeCompare(b.title, cfg.lang);
      return sortDir * ((val(a) as any)[sortKey] - (val(b) as any)[sortKey]) || a.title.localeCompare(b.title, cfg.lang);
    });
    for (const th of document.querySelectorAll<HTMLElement>('.packs th[aria-sort]')) {
      const k = th.querySelector<HTMLElement>('.sort')!.dataset.sort;
      th.setAttribute('aria-sort', k === sortKey ? (sortDir < 0 ? 'descending' : 'ascending') : 'none');
    }
    for (const r of sorted) {
      const x = val(r);
      const pick = el('button', { class: 'pick-btn', type: 'button', 'aria-pressed': String(picked === r.id) }, r.title);
      pick.addEventListener('click', () => { picked = picked === r.id ? '' : r.id; $<HTMLSelectElement>('st-pack').value = picked; renderStats(); $('stats-panel').scrollIntoView({ behavior: 'smooth', block: 'start' }); });
      const img = el('img', { src: r.cover, alt: '', referrerpolicy: 'no-referrer', loading: 'lazy' });
      const open = el('a', { class: 'link small', href: `${cfg.assetBase}${r.id}/`, target: '_blank', rel: 'noopener' }, tr('dash.viewPage'));
      const acts = el('div', { class: 'acts' });
      const row = el('tr', { class: picked === r.id ? 'is-picked' : '' },
        el('td', {}, el('div', { class: 'pk' }, img, el('div', {}, pick, el('div', { class: 'small muted' }, r.sub, ' ', open)))),
        el('td', { class: 'num', 'data-label': tr('dash.kViews') }, nf.format(x.v), el('div', { class: 'small muted' }, tr('dash.allTime', { n: nf.format(r.s.v || 0) }))),
        el('td', { class: 'trend' }, spark(r.s)),
        el('td', { class: 'num', 'data-label': tr('dash.kClicks') }, nf.format(x.c)),
        el('td', { class: 'num', 'data-label': tr('dash.colRate') }, x.v ? pf.format(x.r) : '–'),
        el('td', { class: 'num', 'data-label': tr('dash.colLikes') }, nf.format(x.l)),
        el('td', { class: 'state' }, r.status),
        el('td', { class: 'act' }, acts),
      );
      r.actions(acts, row);
      body.append(row);
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.seg [data-range]').forEach((b) => b.addEventListener('click', () => { range = Number(b.dataset.range); renderStats(); }));
  document.querySelectorAll<HTMLButtonElement>('.kpi[data-metric]').forEach((b) => b.addEventListener('click', () => { metric = b.dataset.metric as 'v' | 'c'; renderStats(); }));
  $<HTMLSelectElement>('st-pack').addEventListener('change', (e) => { picked = (e.target as HTMLSelectElement).value; renderStats(); });
  document.querySelectorAll<HTMLButtonElement>('.packs .sort').forEach((b) => b.addEventListener('click', () => {
    const k = b.dataset.sort!;
    sortDir = sortKey === k ? -sortDir : k === 'title' ? 1 : -1;
    sortKey = k;
    renderTable();
  }));

  const actionButton = (box: HTMLElement, label: string, fn: () => Promise<void>) => {
    const b = el('button', { class: 'btn btn--sm', type: 'button' }, label) as HTMLButtonElement;
    b.addEventListener('click', () => busy(b, fn));
    box.append(b);
  };
  /** Rows for packs the creator listed through the dashboard. */
  function packRows(list: any[], creator: any): Row[] {
    const canEdit = creator.status === 'active';
    return list.map((p) => ({
      id: p.id,
      title: p.title,
      cover: p.cover?.sm || '',
      sub: catName(p.category),
      status: p.status !== 'published' ? tr('dash.hiddenByAdmin') : p.ownerHidden ? tr('dash.hiddenByYou') : tr('dash.live'),
      s: {},
      actions: (box, row) => {
        if (canEdit) {
          actionButton(box, tr('dash.edit'), async () => toggleEdit(row, p));
          actionButton(box, p.ownerHidden ? tr('dash.show') : tr('dash.hide'), async () => { await updateDoc(doc(db, 'packs', p.id), { ownerHidden: !p.ownerHidden, updatedAt: serverTimestamp() }); });
          actionButton(box, tr('dash.refresh'), async () => { await call('refreshPack', { id: p.id }); toast(tr('dash.refreshed')); });
        }
        if (creator.status === 'active' || creator.status === 'restricted')
          actionButton(box, tr('dash.delete'), async () => { if (confirm(tr('dash.confirmDelete', { title: p.title }))) await deleteDoc(doc(db, 'packs', p.id)); });
      },
    }));
  }
  /** Rows for HanX Games' own packs (house account): hide or show them on the site. */
  function houseRows(hidden: Set<string>): Row[] {
    return (cfg.house as { id: string; title: string; cover: string; url: string; panelHidden: boolean }[]).map((h) => ({
      id: h.id,
      title: h.title,
      cover: h.cover,
      sub: 'HanX Games',
      status: h.panelHidden ? tr('dash.hiddenByPanel') : hidden.has(h.id) ? tr('dash.hiddenByYou') : tr('dash.live'),
      s: {},
      actions: (box) => {
        if (!h.panelHidden) actionButton(box, hidden.has(h.id) ? tr('dash.show') : tr('dash.hide'), async () => {
          await setDoc(doc(db, 'houseOverrides', h.id), { hidden: !hidden.has(h.id), updatedAt: serverTimestamp() });
          toast(tr('dash.saved'));
        });
        box.append(el('a', { class: 'btn btn--sm', href: h.url, target: '_blank', rel: 'noopener' }, tr('dash.openStore')));
      },
    }));
  }
  function toggleEdit(row: HTMLElement, p: any) {
    const next = row.nextElementSibling;
    if (next?.classList.contains('edit-row')) return next.remove();
    const form = el('form', { class: 'form' }) as HTMLFormElement;
    const field = (label: string, input: HTMLElement) => el('label', {}, label, input);
    const title = el('input', { name: 'title', maxlength: '80', required: '' }) as HTMLInputElement; title.value = p.title;
    const cat = el('select', { name: 'category' }) as HTMLSelectElement;
    for (const c of cfg.cats) cat.append(el('option', { value: c.key }, c.name));
    cat.value = p.category;
    const tags = el('input', { name: 'tags', maxlength: '400' }) as HTMLInputElement; tags.value = (p.tags || []).join(', ');
    const short = el('textarea', { name: 'short', maxlength: '200', rows: '3' }) as HTMLTextAreaElement; short.value = p.short || '';
    const save = el('button', { class: 'btn btn--primary btn--sm', type: 'submit' }, tr('dash.save')) as HTMLButtonElement;
    form.append(field(tr('dash.titleField'), title), field(tr('dash.categoryField'), cat), field(tr('dash.tagsField'), tags), field(tr('dash.shortField'), short), save);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      busy(save, async () => {
        const tagList = [...new Set(tags.value.split(',').map((x) => x.trim().toLowerCase().slice(0, 30)).filter(Boolean))].slice(0, 12);
        await updateDoc(doc(db, 'packs', p.id), { title: title.value.trim().slice(0, 80), category: cat.value, tags: tagList, short: short.value.trim().slice(0, 200), updatedAt: serverTimestamp() });
        toast(tr('dash.saved'));
      });
    });
    const td = el('td', { colspan: '8' }, form);
    row.after(el('tr', { class: 'edit-row' }, td));
  }

  // ---------- state ----------
  let unsubs: (() => void)[] = [];
  const reset = () => { unsubs.forEach((u) => u()); unsubs = []; };
  function view(name: 'auth' | 'role' | 'member' | 'onboard' | 'dash') {
    show('loading', false);
    show('v-auth', name === 'auth');
    show('v-role', name === 'role');
    show('v-member', name === 'member');
    show('v-onboard', name === 'onboard');
    show('v-dash', name === 'dash');
  }
  function renderCreator(user: User, c: any) {
    $('hello').textContent = tr('dash.h1', { name: c.displayName });
    ($('profile-link') as HTMLAnchorElement).href = `${cfg.creatorBase}${c.handle}/`;
    const st = $('status-banner');
    st.hidden = c.status === 'active';
    st.textContent = c.status === 'active' ? '' : tr(`dash.status.${c.status}`);
    const needsEmail = !user.emailVerified && user.providerData.some((p) => p.providerId === 'password');
    show('verify-banner', needsEmail);
    $('verify-text').textContent = tr('dash.verifyEmail', { email: user.email || '' });
    show('store-done', Boolean(c.verified));
    show('store-todo', !c.verified);
    if (c.verified) $('store-ok').textContent = tr('dash.verified', { user: c.storeUser });
    show('add', Boolean(c.verified) && c.status === 'active' && !c.house);
    show('house-note', Boolean(c.house));
    show('profile-panel', !c.house);
    const pf = $<HTMLFormElement>('profile-form');
    for (const k of ['displayName', 'bio', 'website', 'twitter']) {
      const input = pf.elements.namedItem(k) as HTMLInputElement;
      if (document.activeElement !== input) input.value = c[k] || '';
    }
  }

  onAuthStateChanged(auth, (user) => {
    reset();
    try { localStorage.setItem('ga_signed_in', user ? '1' : '0'); } catch {}
    window.dispatchEvent(new CustomEvent('ga:account', { detail: Boolean(user) }));
    if (!user) return view('auth');
    if (!user.emailVerified) user.reload().then(() => (user.emailVerified ? user.getIdToken(true) : null)).catch(() => {});
    let creator: any = null;
    account = undefined; creatorDoc = undefined; editingRole = false; wantCreator = false;
    unsubs.push(onSnapshot(doc(db, 'users', user.uid), (snap) => {
      account = snap.exists() ? snap.data() : null;
      decide();
    }, (e) => { account = null; fail(e); decide(); }));
    unsubs.push(onSnapshot(doc(db, 'creators', user.uid), (snap) => {
      creator = snap.exists() ? snap.data() : null;
      creatorDoc = creator;
      if (creator) renderCreator(user, creator);
      decide();
    }, fail));
    let myPacks: any[] = [];
    let houseHidden: Set<string> | null = null;
    let houseSub = false;
    const rebuild = () => {
      if (!creator) return;
      if (creator.house && !houseSub) {
        houseSub = true;
        unsubs.push(onSnapshot(collection(db, 'houseOverrides'), (snap) => {
          houseHidden = new Set(snap.docs.filter((d) => d.data().hidden === true).map((d) => d.id));
          rebuild();
        }, fail));
      }
      setRows([...packRows(myPacks, creator), ...(creator.house && houseHidden ? houseRows(houseHidden) : [])]);
    };
    unsubs.push(onSnapshot(doc(db, 'creators', user.uid), () => setTimeout(rebuild, 0), () => {}));
    unsubs.push(onSnapshot(query(collection(db, 'packs'), where('ownerUid', '==', user.uid)), (snap) => {
      myPacks = snap.docs.map((d) => ({ id: d.id, ...d.data() })).sort((a: any, b: any) => (b.createdAt?.seconds || 0) - (a.createdAt?.seconds || 0));
      rebuild();
    }, fail));
  });
</script>
