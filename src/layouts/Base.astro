---
import '../styles/global.css';
import { SITE, seriesOrder, absolute } from '../data/site';
import { CATEGORIES, listings, activeCreators } from '../data/market';
import { LOCALES, localeOf, localePath, DEFAULT_LOCALE } from '../i18n/locales';
import { useT, fmtDate, safeJson } from '../i18n';
import campaign from '../data/campaign.json';

interface Props {
  title: string;
  description: string;
  /** Locale code of this page. */
  lang?: string;
  /** The page path without a locale prefix, e.g. "/assets/low-poly-city-pack/". Drives canonical, hreflang and the language menu. */
  path?: string;
  /** Set false for pages that exist in one language only (404). */
  localized?: boolean;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'product' | 'article';
  jsonld?: object[];
  noindex?: boolean;
  /** Product-specific OG price tags */
  price?: { amount: number; currency: string };
}
const { title, description, lang = DEFAULT_LOCALE, path = '/', localized = true, image = '/og/home.jpg', imageAlt, type = 'website', jsonld = [], noindex = false, price } = Astro.props;
const t = useT(lang);
const loc = localeOf(lang);
const L = (p: string) => localePath(lang, p);
const canonical = absolute(localized ? L(path) : Astro.url.pathname);
const ogImage = absolute(image);
const fullTitle = title.includes(SITE.brand) || title.includes(SITE.name) ? title : `${title} | ${SITE.brand}`;
const current = Astro.url.pathname;
const nav = [
  { href: L('/assets/'), label: t('nav.allPacks') },
  { href: L('/creators/'), label: t('nav.creators') },
  { href: L('/bundles/'), label: t('nav.bundles') },
  { href: L('/sell/'), label: t('nav.sell') },
  { href: L('/faq/'), label: t('nav.faq') },
];
const fontFamilies = ['family=Big+Shoulders+Display:wght@800', 'family=Golos+Text:wght@400;500', loc.fonts].filter(Boolean).join('&');
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#org`,
  name: SITE.studio,
  alternateName: [SITE.brand, SITE.name],
  url: SITE.url,
  logo: absolute('/icon-512.png'),
  sameAs: [SITE.twitterUrl],
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  alternateName: SITE.brand,
  url: SITE.url,
  inLanguage: LOCALES.map((l) => l.hreflang),
  description: t('site.description'),
  publisher: { '@id': `${SITE.url}/#org` },
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}${L('/assets/')}?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};
const year = new Date().getFullYear();
// Campaign strip from the admin panel (src/data/campaign.json). Hidden after its end date, also client-side.
const campaignTexts = campaign.text as Record<string, string>;
const campaignText = (campaignTexts[lang] || campaignTexts.en || '').trim();
const campaignLive = campaign.enabled && campaignText && (!campaign.ends || new Date(campaign.ends).getTime() > Date.now());
const campaignHref = campaign.link ? (campaign.link.startsWith('/') ? localePath(lang, campaign.link) : campaign.link) : '';
---
<!doctype html>
<html lang={loc.hreflang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    {localized && LOCALES.map((l) => <link rel="alternate" hreflang={l.hreflang} href={absolute(localePath(l.code, path))} />)}
    {localized && <link rel="alternate" hreflang="x-default" href={absolute(path)} />}
    <meta name="theme-color" content="#f6efd9" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Apply the remembered theme before first paint, so there is no light flash.
      try { if (localStorage.getItem('ga_theme') === 'dark') { document.documentElement.dataset.theme = 'dark'; document.querySelector('meta[name=theme-color]').content = '#17221a'; } } catch (e) {}
    </script>
    <meta name="author" content={SITE.studio} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type === 'product' ? 'product' : type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt || title} />
    <meta property="og:locale" content={loc.og} />
    {localized && LOCALES.filter((l) => l.code !== lang).map((l) => <meta property="og:locale:alternate" content={l.og} />)}
    {price && <meta property="product:price:amount" content={price.amount.toFixed(2)} />}
    {price && <meta property="product:price:currency" content={price.currency} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:creator" content={SITE.twitter} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Game Assets: new asset packs" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fontFamilies}&display=swap`} />
    {localized && lang === DEFAULT_LOCALE && (
      <script is:inline define:vars={{ codes: LOCALES.map((l) => l.code).filter((c) => c !== DEFAULT_LOCALE) }}>
        // English is the default at the root. Send a first-time visitor to their browser's language,
        // unless they picked a language in the menu before. Crawlers are left alone.
        (function () {
          if (/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent)) return;
          var saved = null;
          try { saved = localStorage.getItem('lang'); } catch (e) {}
          if (saved === 'en') return;
          var target = saved && codes.indexOf(saved) > -1 ? saved : null;
          if (!target) {
            var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'en'];
            for (var i = 0; i < langs.length; i++) {
              var l = String(langs[i]).toLowerCase();
              var code = l.indexOf('pt') === 0 ? 'pt' : /^zh(-hans|-cn|-sg)?$|^zh-hans-/.test(l) ? 'zh' : l.indexOf('zh') === 0 ? '' : l.split('-')[0];
              if (code === 'en') return;
              if (code && codes.indexOf(code) > -1) { target = code; break; }
            }
          }
          if (target) location.replace('/' + target + location.pathname + location.search + location.hash);
        })();
      </script>
    )}
    <slot name="head" />

    <script type="application/ld+json" set:html={safeJson(org)} />
    <script type="application/ld+json" set:html={safeJson(website)} />
    {jsonld.map((j) => <script type="application/ld+json" set:html={safeJson(j)} />)}
  </head>
  <body>
    <a class="skip visually-hidden-focusable" href="#main">{t('nav.skip')}</a>
    {campaignLive && (
      <aside class="campaign" data-ends={campaign.ends || undefined} aria-label={campaignText}>
        <div class="container">
          {campaignHref
            ? <a href={campaignHref} target={campaignHref.startsWith('http') ? '_blank' : undefined} rel={campaignHref.startsWith('http') ? 'noopener' : undefined}>{campaignText}</a>
            : <p>{campaignText}</p>}
          {campaign.ends && <span class="campaign-until">{t('campaign.until', { date: fmtDate(lang, campaign.ends) })}</span>}
        </div>
      </aside>
    )}
    {campaignLive && campaign.ends && (
      <script is:inline>
        (function () { var c = document.querySelector('.campaign[data-ends]'); if (c && Date.now() > new Date(c.dataset.ends).getTime()) c.remove(); })();
      </script>
    )}
    <header class="masthead">
      <div class="container">
        <nav aria-label="Shop">
          {nav.slice(0, 3).map((n) => <a href={n.href} aria-current={current.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <a class="wordmark" href={L('/')} aria-label={t('nav.homeAria')}>Game <b>Assets</b></a>
        <nav aria-label="Info">
          {nav.slice(3).map((n) => <a href={n.href} aria-current={current.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          <a class="join-link" href={L('/dashboard/')} data-account data-signed-in={t('nav.dashboard')}>{t('nav.join')}</a>
          <button class="theme-btn" type="button" data-theme-toggle aria-pressed="false" data-dark={t('nav.themeDark')} data-light={t('nav.themeLight')} aria-label={t('nav.themeDark')} title={t('nav.themeDark')}><svg class="i-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg><svg class="i-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg></button>
          {localized && (
            <details class="lang-menu">
              <summary aria-label={t('nav.language')}>{lang.toUpperCase()}</summary>
              <ul>
                {LOCALES.map((l) => <li><a href={localePath(l.code, path)} hreflang={l.hreflang} lang={l.hreflang} data-set-lang={l.code} aria-current={l.code === lang ? 'true' : undefined}>{l.name}</a></li>)}
              </ul>
            </details>
          )}
        </nav>
        <a class="join-btn" href={L('/dashboard/')} data-account data-signed-in={t('nav.dashboard')}>{t('nav.joinShort')}</a>
        <button class="menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" data-open={t('nav.menu')} data-close={t('nav.close')}><svg class="mi-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" /></svg><svg class="mi-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg><span class="visually-hidden" data-menu-label>{t('nav.menu')}</span></button>
      </div>
      <div class="mobile-nav" id="mobile-nav">
        <ul class="container">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><button class="theme-row" type="button" data-theme-toggle aria-pressed="false" data-dark={t('nav.themeDark')} data-light={t('nav.themeLight')}><svg class="i-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg><svg class="i-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg><span data-theme-label>{t('nav.themeDark')}</span></button></li>
        </ul>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="footer">
      <div class="container">
        <p class="wordmark-xl" aria-hidden="true">Game <b>Assets</b></p>
        <div class="footer-links">
          <div>
            <p class="footer-head">{t('footer.marketplace')}</p>
            <ul>{CATEGORIES.map((c) => <li><a href={L(`/category/${c.slug}/`)}>{t(`catg.${c.key}.name`)}</a></li>)}</ul>
          </div>
          <div>
            <p class="footer-head">{t('footer.collections')}</p>
            <ul>
              {seriesOrder.map((s) => <li><a href={L(`/collections/${s}/`)}>{t('footer.seriesPacks', { name: t(`series.${s}.name`) })}</a></li>)}
              <li><a href={L('/bundles/')}>{t('footer.bundleDeals')}</a></li>
              <li><a href={L('/engines/unity/')}>{t('footer.unity')}</a></li>
              <li><a href={L('/engines/godot/')}>{t('footer.godot')}</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-head">{t('footer.brand')}</p>
            <ul>
              <li><a href={L('/creators/')}>{t('nav.creators')}</a></li>
              <li><a href={L('/sell/')}>{t('nav.sell')}</a></li>
              <li><a href={L('/faq/')}>{t('nav.faq')}</a></li>
              <li><a href={L('/license/')}>{t('footer.license')}</a></li>
              <li><a href={L('/about/')}>{t('footer.about')}</a></li>
              <li><a href={L('/privacy/')}>{t('footer.privacy')}</a></li>
              <li><a href={L('/terms/')}>{t('footer.terms')}</a></li>
              <li><a href={SITE.twitterUrl} target="_blank" rel="noopener">X (Twitter)</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-head">{t('footer.languages')}</p>
            <ul class="footer-langs">
              {LOCALES.map((l) => <li><a href={localePath(l.code, localized ? path : '/')} hreflang={l.hreflang} lang={l.hreflang} data-set-lang={l.code}>{l.name}</a></li>)}
            </ul>
          </div>
        </div>
        <div class="footer-legal">
          <span>{(activeCreators.length > 1 ? t('footer.legal', { year, packs: listings.length, creators: activeCreators.length }) : t('footer.legalOne', { year }))}</span>
          <span>{t('footer.made')}</span>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-nav');
      btn?.addEventListener('click', () => {
        const open = menu!.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(open));
        btn.querySelector('[data-menu-label]')!.textContent = open ? btn.dataset.close! : btn.dataset.open!;
      });

      // Light / dark theme toggle, remembered per browser.
      const themeBtns = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
      const syncTheme = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        themeBtns.forEach((b) => {
          const label = dark ? b.dataset.light! : b.dataset.dark!;
          b.setAttribute('aria-pressed', String(dark));
          const span = b.querySelector('[data-theme-label]');
          if (span) span.textContent = label; else { b.setAttribute('aria-label', label); b.title = label; }
        });
        const meta = document.querySelector<HTMLMetaElement>('meta[name=theme-color]');
        if (meta) meta.content = dark ? '#17221a' : '#f6efd9';
      };
      themeBtns.forEach((b) => b.addEventListener('click', () => {
        const dark = document.documentElement.dataset.theme !== 'dark';
        if (dark) document.documentElement.dataset.theme = 'dark'; else delete document.documentElement.dataset.theme;
        try { localStorage.setItem('ga_theme', dark ? 'dark' : 'light'); } catch {}
        syncTheme();
      }));
      syncTheme();

      // Remember a language picked by hand, so the browser-language redirect never overrides it.
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-set-lang]');
        if (a) { try { localStorage.setItem('lang', a.dataset.setLang!); } catch {} }
      });

      // Close the language menu on outside click or Escape.
      const langMenu = document.querySelector<HTMLDetailsElement>('.lang-menu');
      document.addEventListener('click', (e) => { if (langMenu?.open && !langMenu.contains(e.target as Node)) langMenu.open = false; });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && langMenu?.open) { langMenu.open = false; langMenu.querySelector('summary')?.focus(); } });

      // Anonymous view / buy-click counters (no cookies, one count per page per session).
      const bot = /bot|crawl|spider|slurp|lighthouse|headless/i.test(navigator.userAgent);
      const track = (slug: string | undefined, field: 'v' | 'c') => {
        if (!slug || bot || !/^[a-z0-9-]{2,120}$/.test(slug)) return;
        const key = `ga_${field}_${slug}`;
        try { if (sessionStorage.getItem(key)) return; sessionStorage.setItem(key, '1'); } catch {}
        const day = Math.floor(Date.now() / 864e5);
        const doc = `projects/gameassets-tr/databases/(default)/documents/stats/${slug}`;
        fetch('https://firestore.googleapis.com/v1/projects/gameassets-tr/databases/(default)/documents:commit', {
          method: 'POST',
          keepalive: true,
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ writes: [{ transform: { document: doc, fieldTransforms: [
            { fieldPath: field, increment: { integerValue: '1' } },
            { fieldPath: 'd.`' + day + '`.' + field, increment: { integerValue: '1' } },
          ] } }] }),
        }).catch(() => {});
      };
      const viewed = document.querySelector<HTMLElement>('[data-track-view]');
      if (viewed) setTimeout(() => track(viewed.dataset.trackView, 'v'), 1500);

      // Signed-in creators see "Dashboard" instead of "Sign in" (flag set by the dashboard).
      // The dashboard announces sign-in / sign-out (ga:account); other tabs follow through the storage event.
      const accountLinks = document.querySelectorAll<HTMLElement>('[data-account]');
      accountLinks.forEach((a) => (a.dataset.signedOut = a.textContent || ''));
      const setAccount = (signedIn: boolean) => accountLinks.forEach((a) => (a.textContent = signedIn ? a.dataset.signedIn! : a.dataset.signedOut!));
      try { setAccount(localStorage.getItem('ga_signed_in') === '1'); } catch {}
      window.addEventListener('ga:account', (e) => setAccount(Boolean((e as CustomEvent).detail)));
      window.addEventListener('storage', (e) => { if (e.key === 'ga_signed_in') setAccount(e.newValue === '1'); });

      // Buy buttons open the creator's checkout in a centred popup on desktop,
      // and navigate normally on phones or when popups are blocked.
      document.addEventListener('click', (ev) => {
        const a = (ev.target as HTMLElement).closest<HTMLAnchorElement>('a[data-buy]');
        if (a) track(a.dataset.slug, 'c');
        if (!a || ev.metaKey || ev.ctrlKey || ev.shiftKey || window.innerWidth < 900) return;
        const w = 720, h = 760;
        const left = window.screenX + (window.outerWidth - w) / 2;
        const top = window.screenY + (window.outerHeight - h) / 2;
        const win = window.open(a.dataset.popup || a.href, 'checkout', `width=${w},height=${h},left=${left},top=${top},resizable=yes,scrollbars=yes`);
        if (win) { ev.preventDefault(); win.focus(); }
      });
    </script>
  </body>
</html>
<style is:global>
  html, body { overflow-x: clip; }
</style>
