---
import '../styles/global.css';
import { SITE, seriesOrder, absolute, assets, bundles, minPrice } from '../data/site';
import { LOCALES, localeOf, localePath, DEFAULT_LOCALE } from '../i18n/locales';
import { useT } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** Locale code of this page. */
  lang?: string;
  /** The page path without a locale prefix, e.g. "/assets/low-poly-city-pack/". Drives canonical, hreflang and the language menu. */
  path?: string;
  /** Set false for pages that exist in one language only (404). */
  localized?: boolean;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'product' | 'article';
  jsonld?: object[];
  noindex?: boolean;
  /** Product-specific OG price tags */
  price?: { amount: number; currency: string };
}
const { title, description, lang = DEFAULT_LOCALE, path = '/', localized = true, image = '/og/home.jpg', imageAlt, type = 'website', jsonld = [], noindex = false, price } = Astro.props;
const t = useT(lang);
const loc = localeOf(lang);
const L = (p: string) => localePath(lang, p);
const canonical = absolute(localized ? L(path) : Astro.url.pathname);
const ogImage = absolute(image);
const fullTitle = title.includes(SITE.brand) || title.includes(SITE.name) ? title : `${title} | ${SITE.brand}`;
const current = Astro.url.pathname;
const nav = [
  { href: L('/assets/'), label: t('nav.allPacks') },
  { href: L('/bundles/'), label: t('nav.bundles') },
  { href: L('/collections/low-poly/'), label: t('nav.lowPoly') },
  { href: L('/collections/3d-pixel/'), label: t('nav.pixel') },
  { href: L('/faq/'), label: t('nav.faq') },
];
const fontFamilies = ['family=Big+Shoulders+Display:wght@800', 'family=Golos+Text:wght@400;500', loc.fonts].filter(Boolean).join('&');
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#org`,
  name: SITE.studio,
  alternateName: [SITE.brand, SITE.name],
  url: SITE.url,
  logo: absolute('/icon-512.png'),
  sameAs: [SITE.itch, SITE.twitterUrl],
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  alternateName: SITE.brand,
  url: SITE.url,
  inLanguage: LOCALES.map((l) => l.hreflang),
  description: t('site.description', { min: `$${minPrice.toFixed(2)}` }),
  publisher: { '@id': `${SITE.url}/#org` },
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}${L('/assets/')}?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={loc.hreflang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    {localized && LOCALES.map((l) => <link rel="alternate" hreflang={l.hreflang} href={absolute(localePath(l.code, path))} />)}
    {localized && <link rel="alternate" hreflang="x-default" href={absolute(path)} />}
    <meta name="theme-color" content="#f6efd9" />
    <meta name="color-scheme" content="light" />
    <meta name="author" content={SITE.studio} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type === 'product' ? 'product' : type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt || title} />
    <meta property="og:locale" content={loc.og} />
    {localized && LOCALES.filter((l) => l.code !== lang).map((l) => <meta property="og:locale:alternate" content={l.og} />)}
    {price && <meta property="product:price:amount" content={price.amount.toFixed(2)} />}
    {price && <meta property="product:price:currency" content={price.currency} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:creator" content={SITE.twitter} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="HanX Assets: new asset packs" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fontFamilies}&display=swap`} />
    {localized && lang === DEFAULT_LOCALE && (
      <script is:inline define:vars={{ codes: LOCALES.map((l) => l.code).filter((c) => c !== DEFAULT_LOCALE) }}>
        // English is the default at the root. Send a first-time visitor to their browser's language,
        // unless they picked a language in the menu before. Crawlers are left alone.
        (function () {
          if (/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent)) return;
          var saved = null;
          try { saved = localStorage.getItem('lang'); } catch (e) {}
          if (saved === 'en') return;
          var target = saved && codes.indexOf(saved) > -1 ? saved : null;
          if (!target) {
            var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'en'];
            for (var i = 0; i < langs.length; i++) {
              var l = String(langs[i]).toLowerCase();
              var code = l.indexOf('pt') === 0 ? 'pt' : /^zh(-hans|-cn|-sg)?$|^zh-hans-/.test(l) ? 'zh' : l.indexOf('zh') === 0 ? '' : l.split('-')[0];
              if (code === 'en') return;
              if (code && codes.indexOf(code) > -1) { target = code; break; }
            }
          }
          if (target) location.replace('/' + target + location.pathname + location.search + location.hash);
        })();
      </script>
    )}
    <slot name="head" />

    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="skip visually-hidden-focusable" href="#main">{t('nav.skip')}</a>
    <header class="masthead">
      <div class="container">
        <nav aria-label="Shop">
          {nav.slice(0, 3).map((n) => <a href={n.href} aria-current={current.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <a class="wordmark" href={L('/')} aria-label={t('nav.homeAria')}>HanX <b>Assets</b></a>
        <nav aria-label="Info">
          {nav.slice(3).map((n) => <a href={n.href} aria-current={current.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          {localized && (
            <details class="lang-menu">
              <summary aria-label={t('nav.language')}>{lang.toUpperCase()}</summary>
              <ul>
                {LOCALES.map((l) => <li><a href={localePath(l.code, path)} hreflang={l.hreflang} lang={l.hreflang} data-set-lang={l.code} aria-current={l.code === lang ? 'true' : undefined}>{l.name}</a></li>)}
              </ul>
            </details>
          )}
        </nav>
        <button class="menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" data-open={t('nav.menu')} data-close={t('nav.close')}>{t('nav.menu')}</button>
      </div>
      <div class="mobile-nav" id="mobile-nav">
        <ul class="container">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href={SITE.itch} target="_blank" rel="noopener">{t('nav.itch')}</a></li>
        </ul>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="footer">
      <div class="container">
        <p class="wordmark-xl" aria-hidden="true">HanX <b>Assets</b></p>
        <div class="footer-links">
          <div>
            <p class="footer-head">{t('footer.collections')}</p>
            <ul>{seriesOrder.map((s) => <li><a href={L(`/collections/${s}/`)}>{t('footer.seriesPacks', { name: t(`series.${s}.name`) })}</a></li>)}</ul>
          </div>
          <div>
            <p class="footer-head">{t('footer.byEngine')}</p>
            <ul>
              <li><a href={L('/engines/unity/')}>{t('footer.unity')}</a></li>
              <li><a href={L('/engines/godot/')}>{t('footer.godot')}</a></li>
              <li><a href={L('/engines/unreal/')}>{t('footer.unreal')}</a></li>
              <li><a href={L('/engines/blender/')}>{t('footer.blender')}</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-head">{t('footer.brand')}</p>
            <ul>
              <li><a href={L('/bundles/')}>{t('footer.bundleDeals')}</a></li>
              <li><a href={L('/faq/')}>{t('nav.faq')}</a></li>
              <li><a href={L('/license/')}>{t('footer.license')}</a></li>
              <li><a href={L('/about/')}>{t('footer.about')}</a></li>
              <li><a href={SITE.itch} target="_blank" rel="noopener">{t('nav.itch')}</a></li>
              <li><a href={SITE.twitterUrl} target="_blank" rel="noopener">X (Twitter)</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-head">{t('footer.languages')}</p>
            <ul class="footer-langs">
              {LOCALES.map((l) => <li><a href={localePath(l.code, localized ? path : '/')} hreflang={l.hreflang} lang={l.hreflang} data-set-lang={l.code}>{l.name}</a></li>)}
            </ul>
          </div>
        </div>
        <div class="footer-legal">
          <span>{t('footer.legal', { year, studio: SITE.studio, packs: assets.length, bundles: bundles.length })}</span>
          <span>{t('footer.made')}</span>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-nav');
      btn?.addEventListener('click', () => {
        const open = menu!.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(open));
        btn.textContent = open ? btn.dataset.close! : btn.dataset.open!;
      });

      // Remember a language picked by hand, so the browser-language redirect never overrides it.
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-set-lang]');
        if (a) { try { localStorage.setItem('lang', a.dataset.setLang!); } catch {} }
      });

      // Close the language menu on outside click or Escape.
      const langMenu = document.querySelector<HTMLDetailsElement>('.lang-menu');
      document.addEventListener('click', (e) => { if (langMenu?.open && !langMenu.contains(e.target as Node)) langMenu.open = false; });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && langMenu?.open) { langMenu.open = false; langMenu.querySelector('summary')?.focus(); } });

      // Buy buttons open the itch.io checkout in a centred popup on desktop,
      // and navigate normally on phones or when popups are blocked.
      document.addEventListener('click', (ev) => {
        const a = (ev.target as HTMLElement).closest<HTMLAnchorElement>('a[data-buy]');
        if (!a || ev.metaKey || ev.ctrlKey || ev.shiftKey || window.innerWidth < 900) return;
        const w = 720, h = 760;
        const left = window.screenX + (window.outerWidth - w) / 2;
        const top = window.screenY + (window.outerHeight - h) / 2;
        const win = window.open(a.dataset.popup || a.href, 'itch_purchase', `width=${w},height=${h},left=${left},top=${top},resizable=yes,scrollbars=yes`);
        if (win) { ev.preventDefault(); win.focus(); }
      });
    </script>
  </body>
</html>
<style is:global>
  html, body { overflow-x: clip; }
</style>
