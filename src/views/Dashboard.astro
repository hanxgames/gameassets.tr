---
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../data/market';
import { useT, href } from '../i18n';
import en from '../i18n/ui/en.json';

interface Props { lang: string }
const { lang } = Astro.props;
const t = useT(lang);
const L = (p: string) => href(lang, p);
// Every dashboard string the client script needs, in this page's language.
const keys = Object.keys(en).filter((k) => /^(dash|join|err)\./.test(k));
const strings = Object.fromEntries(keys.map((k) => [k, t(k)]));
const cats = CATEGORIES.map((c) => ({ key: c.key, name: t(`catg.${c.key}.name`) }));
const cfg = { strings, cats, lang, creatorBase: L('/creators/'), assetBase: L('/assets/') };
const terms = `<a class="link" href="${L('/terms/')}">${t('footer.terms')}</a>`;
const privacy = `<a class="link" href="${L('/privacy/')}">${t('footer.privacy')}</a>`;
---
<Base lang={lang} path="/dashboard/" title={t('dash.title')} description={t('join.lead')} noindex>
  <div class="container app" id="app" aria-live="polite">
    <p class="loading" id="loading">{t('dash.loading')}</p>

    <!-- Sign in / sign up -->
    <section class="panel auth" id="v-auth" hidden>
      <h1>{t('join.h1')}</h1>
      <p class="lead">{t('join.lead')}</p>
      <button class="btn btn--primary btn--block" type="button" id="google">{t('join.google')}</button>
      <p class="or small">{t('join.or')}</p>
      <form id="email-form" class="form" novalidate>
        <label>{t('join.email')}<input type="email" name="email" autocomplete="email" required /></label>
        <label>{t('join.password')}<input type="password" name="password" autocomplete="current-password" minlength="6" required /></label>
        <button class="btn btn--block" type="submit" id="email-submit" data-in={t('join.signIn')} data-up={t('join.signUp')}>{t('join.signIn')}</button>
      </form>
      <p class="row small">
        <button class="linkish" type="button" id="toggle-mode" data-in={t('join.toSignUp')} data-up={t('join.toSignIn')}>{t('join.toSignUp')}</button>
        <button class="linkish" type="button" id="forgot">{t('join.forgot')}</button>
      </p>
      <p class="small" set:html={t('join.agree', { terms, privacy })} />
    </section>

    <!-- First profile -->
    <section class="panel" id="v-onboard" hidden>
      <h1>{t('join.profileH2')}</h1>
      <form id="onboard-form" class="form" novalidate>
        <label>{t('join.displayName')}<input name="displayName" maxlength="60" required /></label>
        <label>{t('join.handle')}<input name="handle" maxlength="30" pattern="[a-z0-9][a-z0-9-]{1,28}[a-z0-9]" autocapitalize="off" spellcheck="false" required /><span class="hint small">{t('join.handleHint')}</span></label>
        <button class="btn btn--primary" type="submit">{t('join.create')}</button>
      </form>
    </section>

    <!-- Dashboard -->
    <div id="v-dash" hidden>
      <header class="dash-head">
        <h1 id="hello"></h1>
        <p class="row">
          <a class="link" id="profile-link" href="#">{t('dash.viewProfile')}</a>
          <button class="btn btn--sm" type="button" id="sign-out">{t('dash.signOut')}</button>
        </p>
      </header>
      <p class="notice" id="status-banner" hidden></p>
      <p class="notice" id="verify-banner" hidden><span id="verify-text"></span> <button class="linkish" type="button" id="resend">{t('dash.resend')}</button></p>

      <section class="panel" id="store">
        <h2>{t('dash.storeH2')}</h2>
        <div id="store-done" hidden><p class="ok" id="store-ok"></p></div>
        <div id="store-todo" hidden>
          <p>{t('dash.storeLead')}</p>
          <form id="code-form" class="form inline" novalidate>
            <label>{t('dash.storeUser')}<input name="storeUser" autocapitalize="off" spellcheck="false" required /></label>
            <button class="btn" type="submit">{t('dash.getCode')}</button>
          </form>
          <div id="code-box" hidden>
            <p class="code" id="code"></p>
            <p>{t('dash.codeSteps')}</p>
            <button class="btn btn--primary" type="button" id="verify">{t('dash.verify')}</button>
          </div>
        </div>
      </section>

      <section class="panel" id="add">
        <h2>{t('dash.addH2')}</h2>
        <p>{t('dash.addLead')}</p>
        <form id="url-form" class="form inline" novalidate>
          <label>{t('dash.packUrl')}<input name="url" type="url" placeholder="https://name.itch.io/pack" required /></label>
          <button class="btn" type="submit">{t('dash.preview')}</button>
        </form>
        <form id="publish-form" class="form preview" hidden novalidate>
          <div class="frame frame--cover"><img id="pv-cover" alt="" referrerpolicy="no-referrer" /></div>
          <div class="pv-fields">
            <p class="small" id="pv-price"></p>
            <label>{t('dash.titleField')}<input name="title" maxlength="80" required /></label>
            <label>{t('dash.categoryField')}<select name="category">{cats.map((c) => <option value={c.key}>{c.name}</option>)}</select></label>
            <label>{t('dash.tagsField')}<input name="tags" maxlength="400" /></label>
            <label>{t('dash.shortField')}<textarea name="short" maxlength="200" rows="3"></textarea></label>
            <p class="row"><button class="btn btn--primary" type="submit">{t('dash.publish')}</button><button class="btn" type="button" id="pv-cancel">{t('dash.cancel')}</button></p>
          </div>
        </form>
      </section>

      <section class="panel">
        <h2>{t('dash.packsH2')}</h2>
        <p id="no-packs">{t('dash.noPacks')}</p>
        <div class="table-wrap" id="packs-wrap" hidden>
          <table class="packs">
            <thead><tr><th scope="col">{t('dash.colPack')}</th><th scope="col">{t('dash.colViews')}</th><th scope="col">{t('dash.colWeek')}</th><th scope="col">{t('dash.colClicks')}</th><th scope="col">{t('dash.colStatus')}</th><th scope="col"><span class="visually-hidden">{t('dash.edit')}</span></th></tr></thead>
            <tbody id="packs"></tbody>
          </table>
        </div>
      </section>

      <section class="panel">
        <h2>{t('dash.profileH2')}</h2>
        <form id="profile-form" class="form" novalidate>
          <label>{t('join.displayName')}<input name="displayName" maxlength="60" required /></label>
          <label>{t('dash.bio')}<textarea name="bio" maxlength="600" rows="4"></textarea></label>
          <label>{t('dash.website')}<input name="website" type="url" maxlength="200" placeholder="https://" /></label>
          <label>{t('dash.twitter')}<input name="twitter" maxlength="40" placeholder="@" /></label>
          <button class="btn" type="submit">{t('dash.saveProfile')}</button>
        </form>
      </section>
    </div>

    <p class="toast" id="toast" role="status" hidden></p>
  </div>
  <script is:inline type="application/json" id="dash-cfg" set:html={JSON.stringify(cfg)} />
</Base>

<style>
  .app { padding-block: var(--space-2xl) var(--section-gap); display: grid; gap: var(--space-2xl); max-width: 64rem; }
  .loading { font-size: var(--text-lead); }
  .panel { display: grid; gap: var(--space-md); padding: var(--space-xl); border: var(--rule-bar) solid var(--color-ink); box-shadow: var(--shadow-card); background: var(--color-paper); }
  .panel h2 { font-size: var(--text-title); }
  .auth { max-width: 30rem; }
  .or { text-align: center; }
  .form { display: grid; gap: var(--space-md); }
  .form.inline { grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
  .form label { display: grid; gap: var(--space-2xs); font-size: var(--text-sm); font-weight: 500; }
  .form input, .form select, .form textarea { width: 100%; min-height: 48px; padding: var(--space-xs) var(--space-md); border: var(--rule-bar) solid var(--color-ink); background: var(--color-paper); color: var(--color-ink); font: inherit; font-size: var(--text-md); font-weight: 400; }
  .form textarea { resize: vertical; }
  .form :is(input, select, textarea):focus-visible { outline: 3px solid var(--color-focus); outline-offset: 0; }
  .hint { color: var(--color-muted); font-weight: 400; }
  .row { display: flex; flex-wrap: wrap; gap: var(--space-md); align-items: center; }
  .linkish { padding: 0; border: 0; background: none; color: var(--color-ink); font: inherit; text-decoration: underline; text-decoration-color: var(--color-accent-2); text-decoration-thickness: 2px; cursor: pointer; }
  .linkish:hover { color: var(--color-accent-2); }
  .linkish:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .dash-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-md); }
  .dash-head h1 { font-size: var(--text-display); overflow-wrap: break-word; min-width: 0; }
  .notice { padding: var(--space-md); border: var(--rule-bar) solid var(--color-ink); background: var(--color-accent-2); color: var(--color-on-accent-2); font-weight: 500; }
  .notice .linkish { color: inherit; }
  .ok { font-weight: 500; }
  .ok::before { content: '✓ '; color: var(--color-accent-2); }
  .code { font: var(--display-weight) var(--text-price)/1 var(--font-display); letter-spacing: 0.04em; padding: var(--space-sm) var(--space-md); background: var(--color-accent); color: var(--color-accent-ink); border: var(--rule-bar) solid var(--color-ink); justify-self: start; user-select: all; }
  #code-box { display: grid; gap: var(--space-md); justify-items: start; }
  .preview { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; gap: var(--space-xl); padding-top: var(--space-md); border-top: var(--rule-bar) solid var(--color-ink); }
  .pv-fields { display: grid; gap: var(--space-md); }
  .packs { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  .packs th, .packs td { text-align: left; padding: var(--space-sm); border-bottom: var(--rule-hair) solid var(--color-ink); vertical-align: top; }
  .packs th { font-weight: 500; color: var(--color-muted); }
  .packs td.num { font-variant-numeric: tabular-nums; }
  .packs .pk { display: flex; gap: var(--space-sm); align-items: center; min-width: 12rem; }
  .packs .pk img { width: 64px; aspect-ratio: 315 / 250; object-fit: cover; border: var(--rule-hair) solid var(--color-ink); }
  .packs .acts { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .packs .edit-row td { background: var(--color-paper-2); }
  .toast { position: fixed; left: 50%; bottom: var(--space-xl); translate: -50% 0; z-index: var(--z-sticky); max-width: min(36rem, calc(100% - 2 * var(--gutter))); padding: var(--space-sm) var(--space-lg); background: var(--color-ink); color: var(--color-paper); border: var(--rule-bar) solid var(--color-ink); box-shadow: var(--shadow-card); }
  @media (max-width: 40rem) { .form.inline, .preview { grid-template-columns: minmax(0, 1fr); } .panel { padding: var(--space-lg); } }
</style>

<script>
  import { initializeApp } from 'firebase/app';
  import {
    connectAuthEmulator, getAuth, onAuthStateChanged, GoogleAuthProvider, signInWithPopup, signInWithEmailAndPassword,
    createUserWithEmailAndPassword, sendEmailVerification, sendPasswordResetEmail, signOut, type User,
  } from 'firebase/auth';
  import { connectFirestoreEmulator, getFirestore, doc, onSnapshot, collection, query, where, getDoc, updateDoc, deleteDoc, serverTimestamp } from 'firebase/firestore';
  import { connectFunctionsEmulator, getFunctions, httpsCallable } from 'firebase/functions';
  import { FIREBASE, FUNCTIONS_REGION } from '../data/firebase.config.mjs';

  const cfg = JSON.parse(document.getElementById('dash-cfg')!.textContent || '{}');
  const S = cfg.strings as Record<string, string>;
  const tr = (k: string, v: Record<string, string | number> = {}) => (S[k] ?? k).replace(/\{(\w+)\}/g, (m, x) => (x in v ? String(v[x]) : m));
  const app = initializeApp(FIREBASE);
  const auth = getAuth(app);
  auth.languageCode = cfg.lang;
  const db = getFirestore(app);
  const fns = getFunctions(app, FUNCTIONS_REGION);
  // Local testing against the Firebase emulators: open /dashboard/?emu on localhost.
  if (location.hostname === 'localhost' && (location.search.includes('emu') || sessionStorage.getItem('ga_emu'))) {
    sessionStorage.setItem('ga_emu', '1');
    connectAuthEmulator(auth, 'http://127.0.0.1:9099', { disableWarnings: true });
    connectFirestoreEmulator(db, '127.0.0.1', 8080);
    connectFunctionsEmulator(fns, '127.0.0.1', 5001);
  }
  const call = async (name: string, data: unknown) => {
    // A freshly confirmed e-mail only reaches the server after the ID token is refreshed.
    const u = auth.currentUser;
    if (u) {
      await u.reload().catch(() => {});
      const tok = await u.getIdTokenResult();
      if (u.emailVerified && tok.claims.email_verified !== true) await u.getIdToken(true);
    }
    return httpsCallable(fns, name)(data).then((r) => r.data as any);
  };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const show = (id: string, on = true) => { $(id).hidden = !on; };
  let toastTimer = 0;
  const toast = (msg: string) => { const el = $('toast'); el.textContent = msg; el.hidden = false; clearTimeout(toastTimer); toastTimer = window.setTimeout(() => (el.hidden = true), 5000); };
  const fail = (e: any) => {
    const code = String(e?.message || e?.code || '').replace(/^auth\//, '').replace(/\s*\[\d+\]\s*$/, '').trim();
    const k = S[`err.${code}`] ? `err.${code}` : /auth\//.test(String(e?.code)) ? 'err.auth' : '';
    toast(k ? tr(k) : tr('dash.error', { msg: code || 'unknown' }));
  };
  const busy = async (btn: HTMLButtonElement | null, fn: () => Promise<void>) => {
    if (btn) btn.disabled = true;
    try { await fn(); } catch (e) { fail(e); } finally { if (btn) btn.disabled = false; }
  };
  const el = (tag: string, attrs: Record<string, string> = {}, ...kids: (Node | string)[]) => {
    const n = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, v);
    for (const c of kids) n.append(c);
    return n;
  };

  // ---------- auth ----------
  let signUp = false;
  const setMode = () => {
    const b = $<HTMLButtonElement>('email-submit');
    b.textContent = signUp ? b.dataset.up! : b.dataset.in!;
    const tgl = $('toggle-mode');
    tgl.textContent = signUp ? tgl.dataset.up! : tgl.dataset.in!;
    ($('email-form').querySelector('[name=password]') as HTMLInputElement).autocomplete = signUp ? 'new-password' : 'current-password';
  };
  $('toggle-mode').addEventListener('click', () => { signUp = !signUp; setMode(); });
  $('google').addEventListener('click', (e) => busy(e.currentTarget as HTMLButtonElement, async () => { await signInWithPopup(auth, new GoogleAuthProvider()); }));
  $('email-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(e.currentTarget as HTMLFormElement);
    const email = String(f.get('email')).trim(), pw = String(f.get('password'));
    busy($('email-submit') as HTMLButtonElement, async () => {
      if (signUp) {
        const cred = await createUserWithEmailAndPassword(auth, email, pw);
        await sendEmailVerification(cred.user).catch(() => {});
      } else await signInWithEmailAndPassword(auth, email, pw);
    });
  });
  $('forgot').addEventListener('click', () => {
    const email = ($('email-form').querySelector('[name=email]') as HTMLInputElement).value.trim();
    if (!email) return ($('email-form').querySelector('[name=email]') as HTMLInputElement).focus();
    busy(null, async () => { await sendPasswordResetEmail(auth, email); toast(tr('join.resetSent')); });
  });
  $('sign-out').addEventListener('click', () => signOut(auth));
  $('resend').addEventListener('click', (e) => busy(e.currentTarget as HTMLButtonElement, async () => { if (auth.currentUser) await sendEmailVerification(auth.currentUser); toast(tr('dash.saved')); }));

  // ---------- onboarding ----------
  $('onboard-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const f = new FormData(form);
    busy(form.querySelector('button'), async () => {
      await call('createProfile', { handle: String(f.get('handle')).trim().toLowerCase(), displayName: String(f.get('displayName')).trim() });
    });
  });
  const handleInput = $('onboard-form').querySelector('[name=handle]') as HTMLInputElement;
  const nameInput = $('onboard-form').querySelector('[name=displayName]') as HTMLInputElement;
  nameInput.addEventListener('input', () => {
    if (handleInput.dataset.touched) return;
    handleInput.value = nameInput.value.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '').replace(/ı/g, 'i').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 30);
  });
  handleInput.addEventListener('input', () => (handleInput.dataset.touched = '1'));

  // ---------- store verification ----------
  $('code-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const user = String(new FormData(form).get('storeUser')).trim();
    busy(form.querySelector('button'), async () => {
      const r = await call('startVerify', { storeUser: user });
      $('code').textContent = r.code;
      $('code-box').dataset.user = r.storeUser;
      show('code-box');
    });
  });
  $('verify').addEventListener('click', (e) => busy(e.currentTarget as HTMLButtonElement, async () => {
    const r = await call('checkVerify', {});
    if (!r.verified) toast(tr('dash.notFound', { url: `${$('code-box').dataset.user}.itch.io` }));
  }));

  // ---------- add a pack ----------
  let previewUrl = '';
  $('url-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    previewUrl = String(new FormData(form).get('url')).trim();
    busy(form.querySelector('button'), async () => {
      const p = await call('previewPack', { url: previewUrl });
      const pf = $<HTMLFormElement>('publish-form');
      ($('pv-cover') as HTMLImageElement).src = p.cover?.sm || p.cover?.src || '';
      $('pv-price').textContent = p.free ? '' : p.price;
      (pf.elements.namedItem('title') as HTMLInputElement).value = String(p.title || '').replace(/\s*[-–|]\s*[^-–|]*assets?\s*$/i, '').trim() || p.title;
      (pf.elements.namedItem('category') as HTMLSelectElement).value = p.suggestedCategory || '3d';
      (pf.elements.namedItem('tags') as HTMLInputElement).value = (p.tags || []).join(', ');
      (pf.elements.namedItem('short') as HTMLTextAreaElement).value = p.short || '';
      pf.hidden = false;
      (pf.elements.namedItem('title') as HTMLInputElement).focus();
    });
  });
  $('pv-cancel').addEventListener('click', () => { $('publish-form').hidden = true; });
  $('publish-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const f = new FormData(form);
    busy(form.querySelector('button[type=submit]'), async () => {
      await call('publishPack', { url: previewUrl, title: f.get('title'), category: f.get('category'), tags: f.get('tags'), short: f.get('short') });
      form.hidden = true;
      ($('url-form') as HTMLFormElement).reset();
      toast(tr('dash.published'));
    });
  });

  // ---------- profile ----------
  $('profile-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const f = new FormData(form);
    busy(form.querySelector('button'), async () => {
      await updateDoc(doc(db, 'creators', auth.currentUser!.uid), {
        displayName: String(f.get('displayName')).trim(),
        bio: String(f.get('bio')).trim(),
        website: String(f.get('website')).trim(),
        twitter: String(f.get('twitter')).trim().replace(/^@/, ''),
        updatedAt: serverTimestamp(),
      });
      toast(tr('dash.saved'));
    });
  });

  // ---------- packs ----------
  const catName = (k: string) => (cfg.cats as { key: string; name: string }[]).find((c) => c.key === k)?.name ?? k;
  const statCache = new Map<string, any>();
  async function stat(id: string) {
    if (!statCache.has(id)) statCache.set(id, getDoc(doc(db, 'stats', id)).then((s) => s.data() || {}).catch(() => ({})));
    const s = await statCache.get(id);
    const today = Math.floor(Date.now() / 864e5);
    const v7 = Object.entries(s.d || {}).reduce((n, [k, v]: [string, any]) => (Number(k) > today - 7 ? n + (v?.v || 0) : n), 0);
    return { v: s.v || 0, c: s.c || 0, v7 };
  }
  function renderPacks(list: any[], creator: any) {
    const body = $('packs');
    body.replaceChildren();
    show('no-packs', list.length === 0);
    show('packs-wrap', list.length > 0);
    const canEdit = creator.status === 'active';
    for (const p of list) {
      const status = p.status !== 'published' ? tr('dash.hiddenByAdmin') : p.ownerHidden ? tr('dash.hiddenByYou') : tr('dash.live');
      const nV = el('td', { class: 'num' }, '…'), nW = el('td', { class: 'num' }, '…'), nC = el('td', { class: 'num' }, '…');
      stat(p.id).then((s) => { nV.textContent = String(s.v); nW.textContent = String(s.v7); nC.textContent = String(s.c); });
      const link = el('a', { class: 'link', href: `${cfg.assetBase}${p.id}/`, target: '_blank', rel: 'noopener' }, p.title);
      const img = el('img', { src: p.cover?.sm || '', alt: '', referrerpolicy: 'no-referrer', loading: 'lazy' });
      const acts = el('div', { class: 'acts' });
      const btn = (label: string, fn: (b: HTMLButtonElement) => Promise<void>) => {
        const b = el('button', { class: 'btn btn--sm', type: 'button' }, label) as HTMLButtonElement;
        b.addEventListener('click', () => busy(b, () => fn(b)));
        acts.append(b);
      };
      const tr_ = el('tr', {}, el('td', {}, el('div', { class: 'pk' }, img, el('div', {}, link, el('div', { class: 'small' }, catName(p.category))))), nV, nW, nC, el('td', {}, status), el('td', {}, acts));
      if (canEdit) {
        btn(tr('dash.edit'), async () => toggleEdit(tr_, p));
        btn(p.ownerHidden ? tr('dash.show') : tr('dash.hide'), async () => { await updateDoc(doc(db, 'packs', p.id), { ownerHidden: !p.ownerHidden, updatedAt: serverTimestamp() }); });
        btn(tr('dash.refresh'), async () => { await call('refreshPack', { id: p.id }); toast(tr('dash.refreshed')); });
      }
      if (creator.status === 'active' || creator.status === 'restricted')
        btn(tr('dash.delete'), async () => { if (confirm(tr('dash.confirmDelete', { title: p.title }))) await deleteDoc(doc(db, 'packs', p.id)); });
      body.append(tr_);
    }
  }
  function toggleEdit(row: HTMLElement, p: any) {
    const next = row.nextElementSibling;
    if (next?.classList.contains('edit-row')) return next.remove();
    const form = el('form', { class: 'form' }) as HTMLFormElement;
    const field = (label: string, input: HTMLElement) => el('label', {}, label, input);
    const title = el('input', { name: 'title', maxlength: '80', required: '' }) as HTMLInputElement; title.value = p.title;
    const cat = el('select', { name: 'category' }) as HTMLSelectElement;
    for (const c of cfg.cats) cat.append(el('option', { value: c.key }, c.name));
    cat.value = p.category;
    const tags = el('input', { name: 'tags', maxlength: '400' }) as HTMLInputElement; tags.value = (p.tags || []).join(', ');
    const short = el('textarea', { name: 'short', maxlength: '200', rows: '3' }) as HTMLTextAreaElement; short.value = p.short || '';
    const save = el('button', { class: 'btn btn--primary btn--sm', type: 'submit' }, tr('dash.save')) as HTMLButtonElement;
    form.append(field(tr('dash.titleField'), title), field(tr('dash.categoryField'), cat), field(tr('dash.tagsField'), tags), field(tr('dash.shortField'), short), save);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      busy(save, async () => {
        const tagList = [...new Set(tags.value.split(',').map((x) => x.trim().toLowerCase().slice(0, 30)).filter(Boolean))].slice(0, 12);
        await updateDoc(doc(db, 'packs', p.id), { title: title.value.trim().slice(0, 80), category: cat.value, tags: tagList, short: short.value.trim().slice(0, 200), updatedAt: serverTimestamp() });
        toast(tr('dash.saved'));
      });
    });
    const td = el('td', { colspan: '6' }, form);
    row.after(el('tr', { class: 'edit-row' }, td));
  }

  // ---------- state ----------
  let unsubs: (() => void)[] = [];
  const reset = () => { unsubs.forEach((u) => u()); unsubs = []; };
  function view(name: 'auth' | 'onboard' | 'dash') {
    show('loading', false);
    show('v-auth', name === 'auth');
    show('v-onboard', name === 'onboard');
    show('v-dash', name === 'dash');
  }
  function renderCreator(user: User, c: any) {
    $('hello').textContent = tr('dash.h1', { name: c.displayName });
    ($('profile-link') as HTMLAnchorElement).href = `${cfg.creatorBase}${c.handle}/`;
    const st = $('status-banner');
    st.hidden = c.status === 'active';
    st.textContent = c.status === 'active' ? '' : tr(`dash.status.${c.status}`);
    const needsEmail = !user.emailVerified && user.providerData.some((p) => p.providerId === 'password');
    show('verify-banner', needsEmail);
    $('verify-text').textContent = tr('dash.verifyEmail', { email: user.email || '' });
    show('store-done', Boolean(c.verified));
    show('store-todo', !c.verified);
    if (c.verified) $('store-ok').textContent = tr('dash.verified', { user: c.storeUser });
    show('add', Boolean(c.verified) && c.status === 'active');
    const pf = $<HTMLFormElement>('profile-form');
    for (const k of ['displayName', 'bio', 'website', 'twitter']) {
      const input = pf.elements.namedItem(k) as HTMLInputElement;
      if (document.activeElement !== input) input.value = c[k] || '';
    }
  }

  onAuthStateChanged(auth, (user) => {
    reset();
    try { localStorage.setItem('ga_signed_in', user ? '1' : '0'); } catch {}
    if (!user) return view('auth');
    if (!user.emailVerified) user.reload().then(() => (user.emailVerified ? user.getIdToken(true) : null)).catch(() => {});
    let creator: any = null;
    unsubs.push(onSnapshot(doc(db, 'creators', user.uid), (snap) => {
      if (!snap.exists()) { creator = null; return view('onboard'); }
      creator = snap.data();
      renderCreator(user, creator);
      view('dash');
    }, fail));
    unsubs.push(onSnapshot(query(collection(db, 'packs'), where('ownerUid', '==', user.uid)), (snap) => {
      const list = snap.docs.map((d) => ({ id: d.id, ...d.data() })).sort((a: any, b: any) => (b.createdAt?.seconds || 0) - (a.createdAt?.seconds || 0));
      const draw = () => (creator ? renderPacks(list, creator) : setTimeout(draw, 200));
      draw();
    }, fail));
  });
</script>
