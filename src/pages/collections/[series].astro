---
import View from '../../views/Collection.astro';
import { assets, bundles, seriesOrder, bySeries, ENGINES } from '../../data/site';
export function getStaticPaths() {
  return seriesOrder.filter((s) => bySeries(s).length > 0).map((s) => ({ params: { series: s } }));
}
---
<View lang="en" series={Astro.params.series as any} />
