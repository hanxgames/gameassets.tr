---
import Base from '../layouts/Base.astro';
import AssetCard from '../components/AssetCard.astro';
import { SITE, bundles, absolute, bundleSavings } from '../data/site';
import { CATEGORIES, listings, inCategory, popular, mostClicked, freeListings, newest, activeCreators } from '../data/market';
import { useT, href, bundleLabel } from '../i18n';

interface Props { lang: string }
const { lang } = Astro.props;
const t = useT(lang);
const L = (p: string) => href(lang, p);
const nPacks = listings.length;
const nCreators = activeCreators.length;
const PER_TAB = 15;
// Tab names reuse the section titles, minus their closing punctuation.
const bare = (s: string) => s.replace(/[.。!！]+$/u, '');

const cats = CATEGORIES.map((c) => ({ ...c, n: inCategory(c.key).length }));
const tabs = [
  { id: 'popular', label: t('sort.popular'), list: popular, more: L('/assets/') },
  { id: 'new', label: t('sort.new'), list: newest, more: L('/assets/?sort=new') },
  { id: 'free', label: t('price.free'), list: freeListings, more: L('/assets/?price=free') },
  { id: 'clicked', label: bare(t('home.clickedH2')), list: mostClicked, more: L('/assets/') },
].filter((x) => x.list.length >= 3);

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t('home.title'),
  numberOfItems: nPacks,
  itemListElement: popular.slice(0, 30).map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: absolute(L(`/assets/${a.slug}/`)), name: a.title })),
};
---
<Base
  lang={lang}
  path="/"
  title={`${t('home.title')} | ${SITE.name}`}
  description={t('home.description', { packs: nPacks, creators: nCreators })}
  jsonld={[itemList]}
>
  <section class="mk-top">
    <div class="container mk-top-grid">
      <h1>{t('home.h1')}</h1>
      <form class="mk-search" action={L('/assets/')} method="get" role="search">
        <label class="visually-hidden" for="home-q">{t('home.searchLabel')}</label>
        <input id="home-q" type="search" name="q" placeholder={t('home.searchPh')} autocomplete="off" />
        <button class="btn btn--primary" type="submit">{t('home.searchBtn')}</button>
      </form>
    </div>
  </section>

  <section class="mk-cats" aria-labelledby="cats-h">
    <div class="container">
      <h2 id="cats-h" class="visually-hidden">{t('home.catsH2')}</h2>
      <ul class="cat-row">
        {cats.map((c) => (
          <li>
            <a class="cat" href={L(`/category/${c.slug}/`)}>
              <span class="cat-img"><img src={`/img/categories/${c.key}.webp`} alt="" width="630" height="500" loading="eager" decoding="async" /></span>
              <span class="cat-name">{t(`catg.${c.key}.name`)}</span>
              {c.n > 0 && <span class="cat-n">{t('home.catN', { n: c.n })}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mk-packs" aria-labelledby="packs-h">
    <div class="container">
      <h2 id="packs-h" class="visually-hidden">{t('nav.allPacks')}</h2>
      <div class="mk-bar">
        <div class="mk-tabs" role="tablist" aria-label={t('nav.allPacks')}>
          {tabs.map((x, i) => (
            <button type="button" role="tab" id={`tab-${x.id}`} aria-controls={`panel-${x.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-more={x.more}>{x.label}</button>
          ))}
        </div>
        <a class="link mk-all" id="mk-all" href={tabs[0]?.more ?? L('/assets/')}>{t('home.seeAll', { packs: nPacks })}</a>
      </div>
      {tabs.map((x, i) => (
        <div class="mk-grid" role="tabpanel" id={`panel-${x.id}`} aria-labelledby={`tab-${x.id}`} hidden={i !== 0}>
          {x.list.slice(0, PER_TAB).map((a, j) => <AssetCard asset={a} lang={lang} compact eager={i === 0 && j < 5} />)}
        </div>
      ))}
    </div>
  </section>

  <section class="mk-sell-wrap">
    <div class="container">
      <div class="mk-sell">
        <p class="mk-sell-text">{t('home.sellH2')}</p>
        <a class="btn btn--primary" href={L('/sell/')}>{t('home.sellCta')}</a>
      </div>
    </div>
  </section>

  {bundles.length > 0 && (
    <section class="mk-bundles">
      <div class="container">
        <div class="section-head"><h2>{t('home.bundlesH2')}</h2></div>
        <div class="table-wrap">
          <table class="price-table">
            <thead><tr><th scope="col">{t('table.bundle')}</th><th scope="col">{t('table.packs')}</th><th scope="col">{t('table.oneByOne')}</th><th scope="col">{t('table.bundlePrice')}</th><th scope="col"><span class="visually-hidden">{t('table.buy')}</span></th></tr></thead>
            <tbody>
              {bundles.map((b) => (
                <tr>
                  <td class="name"><a href={L(`/bundles/${b.slug}/`)}>{bundleLabel(t, b)}</a></td>
                  <td>{b.members.length}</td>
                  <td class="was">{b.regularPrice}</td>
                  <td class="big">{b.bundlePrice} <span class="small">{t('table.save', { pct: bundleSavings(b) })}</span></td>
                  <td><a class="btn btn--sm" href={b.url} target="_blank" rel="noopener" aria-label={t('table.getAria', { bundle: bundleLabel(t, b) })}>{t('table.get')}</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}
</Base>

<script>
  // Market tabs: one grid visible at a time, arrow keys move between tabs.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.mk-tabs [role=tab]')];
  const all = document.getElementById('mk-all') as HTMLAnchorElement | null;
  const select = (tab: HTMLButtonElement, focus = false) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
    if (all && tab.dataset.more) all.href = tab.dataset.more;
    if (focus) tab.focus();
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const k = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (k) { e.preventDefault(); select(tabs[(i + k + tabs.length) % tabs.length], true); }
      if (e.key === 'Home') { e.preventDefault(); select(tabs[0], true); }
      if (e.key === 'End') { e.preventDefault(); select(tabs[tabs.length - 1], true); }
    });
  });
</script>

<style>
  .mk-top { padding-block: var(--space-xl) var(--space-lg); }
  .mk-top-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 32rem); gap: var(--space-lg) var(--space-2xl); align-items: end; }
  .mk-top h1 { font-size: clamp(2rem, 3.4vw, 3.25rem); max-width: 20ch; overflow-wrap: break-word; min-width: 0; text-wrap: balance; }
  .mk-search { display: flex; gap: var(--space-xs); width: 100%; }
  .mk-search input { flex: 1; min-width: 0; min-height: 52px; padding: 0 var(--space-md); border: var(--rule-bar) solid var(--color-ink); border-radius: var(--radius-pill); background: var(--color-paper); color: var(--color-ink); font-size: var(--text-md); }
  .mk-search input::placeholder { color: var(--color-muted); }
  .mk-search input:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 0; }
  @media (max-width: 60rem) { .mk-top-grid { grid-template-columns: minmax(0, 1fr); align-items: start; } }

  .mk-cats { padding-bottom: var(--space-xl); }
  .cat-row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(9, minmax(0, 1fr)); gap: var(--space-sm); }
  .cat { display: grid; gap: var(--space-2xs); text-decoration: none; }
  .cat-img { position: relative; display: block; aspect-ratio: 5 / 4; overflow: hidden; border: var(--rule-bar) solid var(--color-ink); background: var(--color-paper-3); transition: box-shadow var(--dur-micro) var(--ease-out); }
  .cat-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cat-name { font: var(--display-weight) var(--text-md)/1.1 var(--font-display); text-transform: uppercase; letter-spacing: var(--tracking-display); overflow-wrap: break-word; min-width: 0; }
  .cat-n { font-size: var(--text-xs); color: var(--color-muted); }
  .cat:hover .cat-img { box-shadow: 5px 5px 0 var(--color-accent-2); }
  .cat:hover .cat-name { color: var(--color-accent-2); }
  .cat:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  .cat:active .cat-img { box-shadow: none; }
  @media (max-width: 75rem) {
    .cat-row { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 8.5rem; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: var(--space-xs); }
    .cat-row > li { scroll-snap-align: start; }
  }

  .mk-packs { padding-block: var(--space-md) var(--space-2xl); border-top: var(--rule-bar) solid var(--color-ink); }
  .mk-bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-md); margin-bottom: var(--space-lg); }
  .mk-tabs { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .mk-tabs button { min-height: 44px; padding: 0 var(--space-md); border: var(--rule-bar) solid var(--color-ink); border-radius: var(--radius-pill); background: var(--color-paper); color: var(--color-ink); font: 500 var(--text-sm)/1 var(--font-body); white-space: nowrap; cursor: pointer; transition: background-color var(--dur-micro) var(--ease-out), color var(--dur-micro) var(--ease-out); }
  .mk-tabs button:hover { background: var(--color-paper-2); }
  .mk-tabs button[aria-selected='true'] { background: var(--color-ink); color: var(--color-paper); }
  .mk-tabs button:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  .mk-tabs button:active { background: var(--color-ink-2); color: var(--color-paper); }
  .mk-all { font-weight: 500; }
  .mk-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-xl) var(--space-md); }
  .mk-grid[hidden] { display: none; }
  @media (max-width: 80rem) { .mk-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 60rem) { .mk-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 40rem) { .mk-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-lg) var(--space-sm); } }

  .mk-sell-wrap { padding-bottom: var(--space-2xl); }
  .mk-sell { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-md); padding: var(--space-md) var(--space-lg); background: var(--color-accent); color: var(--color-accent-ink); border: var(--rule-bar) solid var(--color-ink); box-shadow: var(--shadow-card); }
  .mk-sell-text { font: var(--display-weight) var(--text-xl)/1.1 var(--font-display); text-transform: uppercase; letter-spacing: var(--tracking-display); max-width: 40ch; overflow-wrap: break-word; min-width: 0; }

  .mk-bundles { padding-bottom: var(--section-gap); }
  .mk-bundles h2 { overflow-wrap: break-word; min-width: 0; }
</style>
