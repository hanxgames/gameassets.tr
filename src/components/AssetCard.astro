---
import type { Asset } from '../data/site';
import { useT, packText, href } from '../i18n';
import BuyButton from './BuyButton.astro';
interface Props { asset: Asset; lang?: string; eager?: boolean; headingLevel?: 'h2' | 'h3' }
const { asset: a, lang = 'en', eager = false, headingLevel = 'h3' } = Astro.props;
const t = useT(lang);
const H = headingLevel;
const onSale = a.originalPrice && a.originalPriceValue > a.priceValue;
const engines = (a.engines as string[]).filter((e) => e !== 'threejs').slice(0, 3);
const { short } = packText(lang, a);
const search = [a.title, a.shortDescription, short, a.series, ...(a.tags as string[]), ...engines].join(' ').toLowerCase();
---
<article
  class="pack"
  data-series={a.series}
  data-engines={engines.join(' ')}
  data-price={a.priceValue}
  data-models={a.modelCount ?? 0}
  data-date={a.published}
  data-search={search}
>
  <div class="frame frame--cover">
    <img src={a.cover.sm} width="630" height="500" alt={t('card.coverAlt', { title: a.title })} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
    {onSale && <span class="stamp">-{a.sale?.rate ?? Math.round((1 - a.priceValue / a.originalPriceValue) * 100)}%</span>}
  </div>
  <H><a href={href(lang, `/assets/${a.slug}/`)}>{a.title}</a></H>
  <p>{short}</p>
  <div class="pack-foot">
    <span class="price"><span class="price-figure">{a.price}</span>{onSale && <span class="was small">{a.originalPrice}</span>}</span>
    <BuyButton asset={a} lang={lang} size="sm" label={t('buy.short')} />
  </div>
</article>
